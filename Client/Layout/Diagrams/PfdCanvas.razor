@using Shared.PipingRoutes
@implements IDisposable


<div class="@WM.WorkspaceCssClass"
     style="@WM.WorkspaceBackgroundStyle"
     @ref="workspaceRef"
     tabindex="0"
     @onmousedown="HandleMouseDown"
     @onclick="HandleWorkspaceClick"
     @onkeydown="HandleKeyDown"
     @onkeyup="HandleKeyUp"
     @onmousemove="HandleMouseMove"
     @onmouseup="HandleMouseUp"
     @onmouseleave="HandleMouseLeave"
     @onwheel="HandleWheel"
     @onwheel:preventDefault="true"
     @ondragover:preventDefault="true"
     @ondragover="() => { }"
     @ondrop="HandleDrop">

    @* 2. LA CÁMARA VIRTUAL *@
    <div class="camera-layer" style="transform: @WM.CameraTransform;">

        @* 3. LA HOJA DE PAPEL (El lienzo real finito y elástico) *@
        <div class="diagram-paper" style="@WM.PaperStyle">

            @* CAPA 1: TUBERÍAS *@
            <svg class="pipes-layer">
                @foreach (var pipe in WM.Pipes)
                {
                    <CanvasPipeWrapper @key="pipe.Id" Pipe="pipe" IsDraft="false" />
                }
                @if (WM.CurrentDraftPipe != null)
                {
                    <CanvasPipeWrapper Pipe="WM.CurrentDraftPipe" IsDraft="true" />
                }
            </svg>

            @* CAPA 2: EQUIPOS FÍSICOS *@
            @foreach (var el in WM.Elements)
            {
                <EquipmentRenderer @key="el.Id"
                                   Element="el"
                                   IsDragging="WM.IsMoving(el)"
                                   IsSelected="@(WM.SelectedElement?.Id == el.Id)"
                                   OnSelect="HandleSelect"
                                   OnDragStart="e => WM.StartMove(el, e)" />
            }
        </div>
    </div>

    @* EL NUEVO BOTÓN DE PÁNICO *@
    <button class="zoom-to-fit-btn" title="Center Diagram" @onclick="HandleZoomToFit">
        ⛶
    </button>
</div>

@code {
    private ElementReference workspaceRef;
    private double canvasX;
    private double canvasY;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await workspaceRef.FocusAsync();
            var offset = await JS.InvokeAsync<Offset>("canvasInterop.getCanvasOffset", workspaceRef);
            canvasX = offset.X;
            canvasY = offset.Y;
            await JS.InvokeVoidAsync("canvasInterop.preventScroll", workspaceRef);
        }
    }

    protected override void OnInitialized()
    {
        WM.OnNotifyUI += StateHasChanged;
    }

    public void Dispose()
    {
        if (WM != null) WM.OnNotifyUI -= StateHasChanged;
    }

    private void HandleDrop(DragEventArgs e) => WM.AddFromToolbox(DragState.CurrentDraggedType, e.OffsetX, e.OffsetY);
    
    private void HandleSelect(IVisualElement element) => WM.SelectElement(element);
    
    private void HandleWorkspaceClick() => WM.SelectElement(null!);

    private void HandleKeyDown(KeyboardEventArgs e) { if (e.CtrlKey) WM.SetConnectionMode(true); }
    
    private void HandleKeyUp(KeyboardEventArgs e) { if (e.Key == "Control") WM.SetConnectionMode(false); }

    private async Task HandleMouseDown(MouseEventArgs e)
    {
        await workspaceRef.FocusAsync();
        // 🚩 Ahora esto detecta tanto la rueda como el clic izquierdo
        WM.StartPan(e);
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        var pos = GetRelativeMousePosition(e);
        
        // 🚩 REGLA DE ORO: Si estás moviendo un equipo, NO mueves la cámara
        if (WM.IsMovingAny || WM.CurrentDraftPipe != null)
        {
            WM.Move(e);
            if (WM.CurrentDraftPipe != null) WM.UpdateConnectionDraft(pos.X, pos.Y);
        }
        else if (WM.IsPanning)
        {
            // Mueve la cámara libremente
            WM.Pan(e);
        }
    }

    private void HandleMouseUp(MouseEventArgs e)
    {
        WM.EndMove();
        WM.EndPan();
        if (WM.CurrentDraftPipe != null) WM.CancelConnectionDraft();
    }

    private void HandleMouseLeave(MouseEventArgs e)
    {
        WM.EndMove();
        WM.EndPan();
        if (WM.CurrentDraftPipe != null) WM.CancelConnectionDraft();
    }

    private void HandleWheel(WheelEventArgs e)
    {
        var pos = GetRelativeMousePosition(e);
        WM.ZoomAt(e.DeltaY, pos.X, pos.Y);
    }

    private CanvasPoint GetRelativeMousePosition(MouseEventArgs e)
    {
        return new CanvasPoint(e.ClientX - canvasX, e.ClientY - canvasY);
    }

    private async Task HandleZoomToFit()
    {
        var dims = await JS.InvokeAsync<Dimensions>("canvasInterop.getCanvasDimensions", workspaceRef);
        WM.ZoomToFit(dims.Width, dims.Height);
    }

    public record Dimensions(double Width, double Height);
}