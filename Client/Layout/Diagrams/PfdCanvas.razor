@using Shared.PipingRoutes
@*
@implements IDisposable


<div class="@WM.WorkspaceCssClass"
     style="@WM.WorkspaceBackgroundStyle"
     @ref="workspaceRef"
     tabindex="0"
     @onmousedown="HandleMouseDown"
     @onclick="HandleWorkspaceClick"
     @onkeydown="HandleKeyDown"
     @onkeyup="HandleKeyUp"
     @onmousemove="HandleMouseMove"
     @onmouseup="HandleMouseUp"
     @onmouseleave="HandleMouseLeave"
     @onwheel="HandleWheel"
     @onwheel:preventDefault="true"
     @ondragover:preventDefault="true"
     @ondragover="() => { }"
     @ondrop="HandleDrop">

    2. LA CÁMARA VIRTUAL
    @* 2. LA CÁMARA VIRTUAL 
    <div class="camera-layer" style="@($"transform: {WM.CameraTransform}; transform-origin: top left;")">

        @* 3. LA HOJA DE PAPEL (El lienzo real finito y elástico)
        <div class="diagram-paper" style="@WM.PaperStyle">

            @* CAPA 1: TUBERÍAS 
            <svg class="pipes-layer">
                @foreach (var pipe in WM.Pipes)
                {
                    <CanvasPipeWrapper @key="pipe.Id" Pipe="pipe" IsDraft="false" />
                }
                @if (WM.CurrentDraftPipe != null)
                {
                    <CanvasPipeWrapper Pipe="WM.CurrentDraftPipe" IsDraft="true" />
                }
            </svg>

            @* CAPA 2: EQUIPOS FÍSICOS 
            @foreach (var el in WM.Elements)
            {
                <EquipmentRenderer @key="el.Id"
                                   Element="el"
                                   IsDragging="WM.IsMoving(el)"
                                   IsSelected="@(WM.SelectedElement?.Id == el.Id)"
                                   OnSelect="HandleSelect"
                                   OnDragStart="e => WM.StartMove(el, e)" />
            }
        </div>
    </div>

  
    @* EL NUEVO BOTÓN DE PÁNICO 
    <div class="zoom-to-fit-container">
        <button class="zoom-to-fit-btn"
                @onclick="HandleZoomToFit"
                @onclick:stopPropagation="true"
                @onmousedown:stopPropagation="true">
            ⛶
        </button>
        <span class="pure-css-tooltip">Center Diagram & Fit to Screen</span>
    </div>


</div>
*@
