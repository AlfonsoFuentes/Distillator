@using Microsoft.AspNetCore.Components.Web
@using Shared.PipingRoutes
@using Shared.ProcessFlowDiagram.Pipes
@inject FlowsheetManager FSM

<g class="pipe-wrapper">
    @if (IsDraft)
    {
        <path d="@RenderData.MainPath"
              stroke="#0EA5E9"
              stroke-width="2.5"
              stroke-dasharray="6,4"
              fill="none" />
    }
    else
    {
        <path d="@RenderData.MainPath"
              stroke="#1F2937"
              stroke-width="2.5"
              fill="none"
              class="main-pipe" />

        <path d="@RenderData.MainPath"
              stroke="transparent"
              stroke-width="12"
              fill="none"
              class="pipe-hitbox"
              @ondblclick="HandleDoubleClick" />

        @if (Pipe.ShowTechnicalLabel)
        {
            <g transform="@GetLabelTransform()" class="pipe-label-group">
                <rect x="-45" y="-10" width="90" height="20" rx="2" fill="white" stroke="#CBD5E1" />
                <text x="0" y="4" text-anchor="middle" font-size="11" fill="#475569">@Pipe.Label</text>
            </g>
        }
    }
</g>

@code {
    [Parameter, EditorRequired] public PipeVisualElement Pipe { get; set; } = default!;
    [Parameter] public bool IsDraft { get; set; }

    private SvgRenderData RenderData = new("", 0, 0, false);
    private string? routeSignature;
    private long routeGeometryVersion = -1;
    private const string RouteCacheVersion = "orthogonal-portflow-v2";

    protected override void OnParametersSet()
    {
        CalculatePaths();
    }

    private void CalculatePaths()
    {
        if (!IsDraft &&
            routeSignature is not null &&
            !FSM.IsMovingAny &&
            routeGeometryVersion == FSM.RouteGeometryVersion)
        {
            return;
        }

        if (!IsDraft && routeSignature is not null && FSM.IsMovingAny && !IsConnectedToMovingElement())
        {
            return;
        }

        var signature = BuildRouteSignature();
        if (!IsDraft && signature == routeSignature)
        {
            return;
        }

        RenderData = PipeRoutingFactory.GetRoute(Pipe, IsDraft, FSM.DraftMouseLogicalX, FSM.DraftMouseLogicalY, FSM.Elements, FSM.Pipes);
        routeSignature = signature;
        routeGeometryVersion = FSM.RouteGeometryVersion;
    }

    private void HandleDoubleClick()
    {
    }

    private string GetLabelTransform()
    {
        string transform = $"translate({Pt(RenderData.LabelX)}, {Pt(RenderData.LabelY)})";
        if (RenderData.LabelIsVertical) transform += " rotate(-90)";
        return transform;
    }

    private string Pt(double val) => Math.Round(val).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private bool IsConnectedToMovingElement()
    {
        return FSM.IsMoving(Pipe.SourceElementId) ||
               FSM.IsMoving(Pipe.TargetElementId) ||
               (Pipe.SourceElement is not null && FSM.IsMoving(Pipe.SourceElement)) ||
               (Pipe.TargetElement is not null && FSM.IsMoving(Pipe.TargetElement));
    }

    private string BuildRouteSignature()
    {
        if (IsDraft)
        {
            return string.Join("|",
                "draft",
                Pipe.Id,
                Pipe.SourceElementId,
                Pipe.SourcePortName,
                Math.Round(FSM.DraftMouseLogicalX, 1),
                Math.Round(FSM.DraftMouseLogicalY, 1));
        }

        var parts = new List<string>
        {
            RouteCacheVersion,
            Pipe.Id.ToString(),
            Pipe.SourceElementId.ToString(),
            Pipe.SourcePortName,
            Pipe.TargetElementId.ToString(),
            Pipe.TargetPortName
        };

        foreach (var element in FSM.Elements.OrderBy(element => element.Id))
        {
            parts.Add(string.Join(",",
                element.Id,
                Math.Round(element.X, 1),
                Math.Round(element.Y, 1),
                Math.Round(element.Width, 1),
                Math.Round(element.Height, 1),
                element.RotationAngle,
                element.IsFlippedHorizontal,
                element.IsFlippedVertical));

            foreach (var port in element.Ports.OrderBy(port => port.Name))
            {
                parts.Add(string.Join(",",
                    "port",
                    element.Id,
                    port.Name,
                    port.Type,
                    port.Direction,
                    Math.Round(port.OffsetX, 1),
                    Math.Round(port.OffsetY, 1)));
            }
        }

        return string.Join("|", parts);
    }
}
