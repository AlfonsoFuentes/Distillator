
@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6">System App</MudText>
        
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Class="mr-4">Hello, @context.User.Identity?.Name</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="ExecuteLogout">
                    Sign Out
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Href="/login">
                    Sign In
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
@code {
    bool _drawerOpen = true;

  

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task ExecuteLogout()
    {
        var response = await HttpServices.PostAsync<LogoutRequest, Result>(new LogoutRequest());

        if (response != null && response.Succeeded)
        {
            // 1. Notificamos a Blazor silenciosamente que la sesión terminó
            ((CustomAuthenticationStateProvider)AuthStateProvider).NotifyAuthenticationStateChanged();
            
            // 2. Navegación suave, como una verdadera SPA
            NavigationManager.NavigateTo("/login");
        }
    }
}