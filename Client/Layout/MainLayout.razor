@using Client.Layout.Diagrams.Palettes
@using Client.Services.Security

@inherits LayoutComponentBase

<MudThemeProvider Theme="_industrialTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="industrial-layout">
    <MudAppBar Elevation="2" Class="top-header">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <span class="logo-icon mr-2">⬢</span>
        <MudText Typo="Typo.h6" Class="app-title">Distillator</MudText>
        <span class="version-tag ml-2">PRO</span>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <span class="mr-4 operator-text">Operator: @(AuthProvider.CurrentUser?.DisplayName ?? context.User.Identity?.Name)</span>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="ExecuteLogout">Sign Out</MudButton>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView Roles="Administrator, Developer">
        <Authorized>
            <MudDrawer @bind-Open="@_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always" Class="sidebar-panel">
                <div class="panel-header">
                    <h2>System Admin</h2>
                </div>
                <NavMenu />
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent Class="main-content-area">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = false;
    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private MudTheme _industrialTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#5D79AE",
            Secondary = "#00D26A",
            AppbarBackground = "#5D79AE",
            Background = "#F4F5F7",
            DrawerBackground = "#FFFFFF",
            AppbarText = "#FFFFFF"
        }
    };

    private async Task ExecuteLogout()
    {
        // ❌ VIEJO: var response = await HttpServices.PostAsync<LogoutRequest, Result>(new LogoutRequest());
        var response = await HttpServices.PostAsync<LogoutRequest>(new LogoutRequest());

        if (response != null && response.Succeeded)
        {
            AuthProvider.ClearUserInfo();
            AuthProvider.NotifyAuthenticationStateChanged();
            NavigationManager.NavigateTo("/login");
        }
    }
}