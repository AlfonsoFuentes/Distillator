@using Client.Layout.Shapes.SVGDrawings
@using Client.Pages.UnitOperations.Splitters
@inherits EquipmentUIBase<SplitterVisualElement>

<CanvasEquipmentWrapper Element="Element"
                        IsSelected="IsSelected"
                        IsDragging="IsDragging"
                        OnSelect="HandleSelectionAsync"
                        OnDragStart="OnDragStart"
                        OnOpenDetails="OpenPropertiesDialogAsync">

    @* 1. EL DIBUJO BASE (Encapsulado y Limpio) *@
    <SplitterSvg Width="@Element.Width"
                 Height="@Element.Height"
                 StatusColor="@(Element.Facade?.StatusColor ?? "#CBD5E0")"
                 CssClass="spl-svg" />

    @* 2. CAPA SUPERIOR: Puertos Dinámicos (N Salidas)
          Usamos pointer-events: none en el svg contenedor para que no bloquee los clics del equipo,
          y pointer-events: all en los rectángulos para que sigan siendo interactivos. *@
    <svg width="@Element.Width" height="@Element.Height" style="position: absolute; top: 0; left: 0; pointer-events: none;">
        @foreach (var port in Element.Ports)
        {
            <rect x="@(port.OffsetX - 5)"
                  y="@(port.OffsetY - 5)"
                  width="10" height="10"
                  class="spl-nozzle"
                  style="pointer-events: all;" />
        }
    </svg>

</CanvasEquipmentWrapper>

@code {
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // Disparamos la auto-generación de coordenadas visuales para las N salidas
        Element.RefreshDynamicPorts();
    }

    protected override async Task OpenPropertiesDialogAsync()
    {
        // 🚩 LLAMADA AL DIÁLOGO DEL SPLITTER
        var parameters = new DialogParameters { ["Equipment"] = Element };
        
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.False,
            FullWidth = false,
            NoHeader = true,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };

        var dialog = await DialogService.ShowAsync<SplitterDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            // Refrescamos el componente si el usuario hizo cambios en el diálogo (ej. agregó puertos)
            StateHasChanged();
        }
    }
}