
@inherits EquipmentUIBase<SplitterVisualElement>

<CanvasEquipmentWrapper Element="Element"
                        IsSelected="IsSelected"
                        IsDragging="IsDragging"
                        OnSelect="HandleSelectionAsync"
                        OnDragStart="OnDragStart"
                        OnOpenDetails="OpenPropertiesDialogAsync">

    <svg class="spl-svg" width="@Element.Width" height="@Element.Height" viewBox="0 0 @Element.Width @Element.Height">
        <g class="spl-part">
            @* 🚩 Triángulo que usa todo el ancho disponible *@
            <path d="M 10, @(Element.Height / 2)
            L @(Element.Width - 10), 10
            L @(Element.Width - 10), @(Element.Height - 10) Z"
                  class="spl-dynamic-fill"
                  fill="@(Element.Facade?.StatusColor ?? "#CBD5E0")"
                  stroke="#334155" stroke-width="1.5" stroke-linejoin="round" />
            
            @* Línea decorativa de la base *@
            <line x1="@(Element.Width - 14)" y1="15"
                  x2="@(Element.Width - 14)" y2="@(Element.Height - 15)"
                  stroke="#334155" stroke-width="1" opacity="0.3" />
        </g>

        @foreach (var port in Element.Ports)
        {
            @* 🚩 Rectángulos centrados en la coordenada exacta del puerto *@
            <rect x="@(port.OffsetX - 5)"
                  y="@(port.OffsetY - 5)"
                  width="10" height="10"
                  class="spl-nozzle" />
        }
    </svg>

</CanvasEquipmentWrapper>

@code {
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // Disparamos la auto-generación de puertos al igual que la columna
        Element.RefreshDynamicPorts();
    }

    protected override async Task OpenPropertiesDialogAsync()
    {
        Console.WriteLine($"[PFD-PRO] Interacting with Splitter: {Element.Facade?.Name}");
        await Task.CompletedTask;
    }

    private double GetNozzleX(Shared.ProcessFlowDiagram.EquipmentPort port)
    {
        // La entrada se dibuja en x=0, las salidas en x=30 (pegadas a la base plana del triángulo)
        return port.Direction == Shared.ProcessFlowDiagram.PortDirection.Left ? 0 : 30;
    }
}