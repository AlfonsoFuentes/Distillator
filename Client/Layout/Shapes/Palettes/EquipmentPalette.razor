


<div class="floating-palette-panel narrow">
    <div class="panel-header">
        <div class="drag-handle"></div>
        <span class="panel-title">TECHNICAL PALETTE</span>
    </div>

    <div class="panel-body">
        
        @* --- 1. FUNDAMENTALS --- *@
        <div class="fundamentals-section">
            <span class="group-header">FUNDAMENTALS</span>
            <div class="fundamentals-row">
                @{
                    var massStream = EquipmentType.MaterialStream;
                }
                <div class="palette-button stream-mass"
                     draggable="true"
                     @ondragstart="@(() => HandleDragStart(massStream))"
                     @onmouseenter="@(() => _hoveredName = massStream.GetDescription())"
                     @onmouseleave="@(() => _hoveredName = null)">
                    <svg width="24" height="24" viewBox="0 0 32 32">
                        <path d="M 4,16 L 24,16 M 18,10 L 24,16 L 18,22" fill="none" stroke="#2563EB" stroke-width="2.5" />
                    </svg>
                    @if (_hoveredName == massStream.GetDescription())
                    {
                        <div class="port-tooltip-fixed">@_hoveredName</div>
                    }
                </div>

                @{
                    var energyStream = EquipmentType.EnergyStream;
                }
                <div class="palette-button stream-energy disabled"
                     @onmouseenter="@(() => _hoveredName = energyStream.GetDescription())"
                     @onmouseleave="@(() => _hoveredName = null)">
                    <svg width="24" height="24" viewBox="0 0 32 32">
                        <path d="M 4,16 L 24,16 M 18,10 L 24,16 L 18,22" fill="none" stroke="#EF4444" stroke-width="2.5" />
                    </svg>
                    @if (_hoveredName == energyStream.GetDescription())
                    {
                        <div class="port-tooltip-fixed">@_hoveredName</div>
                    }
                </div>
            </div>
        </div>

        <div class="group-divider"></div>

        @* --- 2. EQUIPOS DINÁMICOS --- *@
        @foreach (var group in EquipmentRegistry.Groups)
        {
            <div class="equipment-group">
                <span class="group-header">@group.CategoryName</span>
                <div class="equipment-grid-3cols">
                    @foreach (var item in group.Items)
                    {
                        var description = item.Type.GetDescription();
                        
                        <div class="palette-button"
                             draggable="true"
                             @ondragstart="@(() => HandleDragStart(item.Type))"
                             @onmouseenter="@(() => _hoveredName = description)"
                             @onmouseleave="@(() => _hoveredName = null)">
                            <svg width="24" height="24" viewBox="0 0 32 32">
                                @item.IconContent
                            </svg>
                            
                            @if (_hoveredName == description)
                            {
                                <div class="port-tooltip-fixed">@_hoveredName</div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="group-divider"></div>
        }
    </div>
</div>

@code {
    private string? _hoveredName;

    private void HandleDragStart(EquipmentType type)
    {
        DragState.CurrentDraggedType = type;
        _hoveredName = null;
    }
}