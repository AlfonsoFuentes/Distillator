@using Shared.ProcessFlowDiagram
@inject DragStateService DragState

<div class="palette-item-card" draggable="true" @ondragstart="HandleDragStart" title="@Label">
    <div class="palette-item-icon">
        <svg width="24" height="24" viewBox="0 0 32 32">
            @IconContent
        </svg>
    </div>
    <span class="palette-item-label">@Label</span>
</div>

@code {
    [Parameter] public EquipmentType Type { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? IconContent { get; set; }

    private void HandleDragStart()
    {
        DragState.CurrentDraggedType = Type;
    }
}