@using Client.Layout.Shapes.SVGDrawings
@using Distillator.Domain.Models
@inherits EquipmentUIBase<OffPageConnectorElement>
@inject Client.Services.ProjectSessionService SessionService

<CanvasEquipmentWrapper Element="Element"
                        IsSelected="IsSelected"
                        IsDragging="IsDragging"
                        OnSelect="HandleSelectionAsync"
                        OnDragStart="OnDragStart"
                        OnOpenDetails="OpenPropertiesDialogAsync">

    <OffPageConnectorSvg Width="@Element.Width"
                         Height="@Element.Height"
                         IsOutlet="@Element.IsOutlet"
                         PortSide="@Element.PortSide"
                         TargetAreaName="@GetTargetAreaName()"
                         ConnectedEquipmentName="@Element.ConnectedEquipmentName"
                         CssClass="opc-svg" />

</CanvasEquipmentWrapper>

@code {
    private string GetTargetAreaName()
    {
        if (Element.TargetAreaId.HasValue)
        {
            var targetFlowsheet = FSM.CurrentProject?.GetFlowsheet(Element.TargetAreaId.Value);
            return targetFlowsheet?.Name ?? "?";
        }
        return "?";
    }

    /*
    // --- CÓDIGO VIEJO (WM) PARA REFERENCIA ---
    private string GetTargetAreaName_Old()
    {
        if (Element.TargetAreaId.HasValue)
        {
            var area = WM.Areas.FirstOrDefault(a => a.Id == Element.TargetAreaId.Value);
            return area?.Name ?? "?";
        }
        return "?";
    }
    */

    protected override async Task OpenPropertiesDialogAsync()
    {
        if (Element.TargetAreaId.HasValue && Element.TargetAreaId != Guid.Empty)
        {
            var targetFlowsheet = FSM.CurrentProject?.GetFlowsheet(Element.TargetAreaId.Value);
            if (targetFlowsheet != null)
            {
                await SessionService.SetActiveFlowsheetAsync(targetFlowsheet);
            }
        }
    }

    /*
    // --- CÓDIGO VIEJO (WM) PARA REFERENCIA ---
    protected override Task OpenPropertiesDialogAsync_Old()
    {
        WM.NavigateToOpcTarget(Element.TargetAreaId ?? Guid.Empty, Element.TargetConnectorId);
        return Task.CompletedTask;
    }
    */
}
