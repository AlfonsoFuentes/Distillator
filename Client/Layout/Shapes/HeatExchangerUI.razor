@using Client.Layout.Shapes.SVGDrawings
@using Client.Pages.UnitOperations.HeatExchangers
@using Shared.ProcessFlowDiagram.HeatExchangers
@inherits EquipmentUIBase<HeatExchangerVisualElement>

<CanvasEquipmentWrapper Element="Element"
                        IsSelected="IsSelected"
                        IsDragging="IsDragging"
                        OnSelect="HandleSelectionAsync"
                        OnDragStart="OnDragStart"
                        OnOpenDetails="OpenPropertiesDialogAsync">

    @* 1. DIBUJO BASE *@
    <HeatExchangerSvg Width="@Element.Width"
                      Height="@Element.Height"
                      StatusColor="@(Element.Facade?.StatusColor ?? "#CBD5E0")"
                      ElementId="@Element.Id.ToString()"
                      CssClass="hx-svg" />

    @* 2. BOQUILLAS INTERACTIVAS *@
    <svg width="@Element.Width" height="@Element.Height" style="position: absolute; top: 0; left: 0; pointer-events: none;">
        @foreach (var port in Element.Ports)
        {
            @* Como las coordenadas Offset ya están perfectas en la clase VisualElement, solo centramos (-5) *@
            <rect x="@(port.OffsetX - 5)" y="@(port.OffsetY - 5)"
                  width="10" height="10"
                  class="hx-nozzle"
                  style="pointer-events: all;" />
        }
    </svg>
</CanvasEquipmentWrapper>

@code {
    protected override async Task OpenPropertiesDialogAsync()
    {
        var parameters = new DialogParameters { ["Equipment"] = Element };
        var options = new DialogOptions { MaxWidth = MaxWidth.False, FullWidth = false, NoHeader = true, CloseOnEscapeKey = true, BackdropClick = true };

        var dialog = await DialogService.ShowAsync<HeatExchangerDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            StateHasChanged();
        }
    }
}