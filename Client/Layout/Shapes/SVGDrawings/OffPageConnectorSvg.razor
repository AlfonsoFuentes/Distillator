@using System.Globalization
@using Shared.ProcessFlowDiagram

<svg width="@Width.ToString(CultureInfo.InvariantCulture)" height="@Height.ToString(CultureInfo.InvariantCulture)" viewBox="0 0 @Width.ToString(CultureInfo.InvariantCulture) @Height.ToString(CultureInfo.InvariantCulture)" class="opc-container @CssClass">
    <defs>
        <filter id="opc-shadow-@_uid" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="2" dy="2" stdDeviation="2" flood-opacity="0.2" />
        </filter>
    </defs>

    @{
        double left = 5;
        double right = Width - 5;
        double leftBody = 10;
        double rightBody = Width - 10;
        double centerY = Height / 2;
        double textX = Width / 2;
        double portX = PortSide == OffPageConnectorPortSide.Left ? left : right;
        bool pointsRight = ShouldPointRight();
        string bodyPath = pointsRight
            ? $"M {left.ToString(CultureInfo.InvariantCulture)} 5 L {rightBody.ToString(CultureInfo.InvariantCulture)} 5 L {right.ToString(CultureInfo.InvariantCulture)} {centerY.ToString(CultureInfo.InvariantCulture)} L {rightBody.ToString(CultureInfo.InvariantCulture)} 35 L {left.ToString(CultureInfo.InvariantCulture)} 35 Z"
            : $"M {leftBody.ToString(CultureInfo.InvariantCulture)} 5 L {right.ToString(CultureInfo.InvariantCulture)} 5 L {right.ToString(CultureInfo.InvariantCulture)} 35 L {leftBody.ToString(CultureInfo.InvariantCulture)} 35 L {left.ToString(CultureInfo.InvariantCulture)} {centerY.ToString(CultureInfo.InvariantCulture)} Z";
    }

    @if (IsOutlet)
    {
        <path class="opc-body outlet-body"
              d="@bodyPath"
              fill="#FFFFFF"
              stroke="#64748B"
              stroke-width="1.5"
              filter="url(#opc-shadow-@_uid)" />

        <circle class="opc-port outlet-port" cx="@portX.ToString(CultureInfo.InvariantCulture)" cy="@centerY.ToString(CultureInfo.InvariantCulture)" r="3" fill="#3B82F6" />
    }
    else
    {
        <path class="opc-body inlet-body"
              d="@bodyPath"
              fill="#FFFFFF"
              stroke="#64748B"
              stroke-width="1.5"
              filter="url(#opc-shadow-@_uid)" />

        <circle class="opc-port inlet-port" cx="@portX.ToString(CultureInfo.InvariantCulture)" cy="@centerY.ToString(CultureInfo.InvariantCulture)" r="3" fill="#10B981" />
    }

    <text class="opc-label"
          x="@textX.ToString(CultureInfo.InvariantCulture)" y="24"
          text-anchor="middle"
          font-family="Segoe UI, sans-serif"
          font-size="11px"
          font-weight="bold"
          fill="#334155">
        @GetDisplayText()
    </text>
</svg>

@code {
    [Parameter] public double Width { get; set; } = 80;
    [Parameter] public double Height { get; set; } = 40;
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public bool IsOutlet { get; set; } = true;
    [Parameter] public OffPageConnectorPortSide PortSide { get; set; } = OffPageConnectorPortSide.Left;
    [Parameter] public string TargetAreaName { get; set; } = "";

    private string _uid = Guid.NewGuid().ToString("N").Substring(0, 8);

    private string GetDisplayText()
    {
        if (string.IsNullOrWhiteSpace(TargetAreaName)) return "?";
        int maxChars = Math.Max(3, (int)((Width - 20) / 7.0));
        return TargetAreaName.Length > maxChars ? TargetAreaName.Substring(0, maxChars) + "." : TargetAreaName;
    }

    private bool ShouldPointRight()
    {
        return IsOutlet
            ? PortSide == OffPageConnectorPortSide.Left
            : PortSide == OffPageConnectorPortSide.Right;
    }
}
