@* OffPageConnectorSvg.razor *@
<svg width="@Width" height="@Height" viewBox="0 0 @Width @Height" class="opc-container @CssClass">
    <defs>
        <filter id="opc-shadow-@_uid" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="2" dy="2" stdDeviation="2" flood-opacity="0.2" />
        </filter>
    </defs>

    @if (IsOutlet)
    {
        @* 🚩 Banderita de Salida (Apunta a la Derecha) *@
        <path class="opc-body outlet-body"
              d="M 5 5 L 65 5 L 75 20 L 65 35 L 5 35 Z"
              fill="#FFFFFF"
              stroke="#64748B"
              stroke-width="1.5"
              filter="url(#opc-shadow-@_uid)" />
              
        @* Puerto en la parte plana izquierda (Azul) *@
        <circle class="opc-port outlet-port" cx="5" cy="20" r="3" fill="#3B82F6" />
    }
    else
    {
        @* 🚩 Banderita de Entrada (TAMBIÉN apunta a la Derecha) *@
        <path class="opc-body inlet-body"
              d="M 5 5 L 65 5 L 75 20 L 65 35 L 5 35 Z"
              fill="#FFFFFF"
              stroke="#64748B"
              stroke-width="1.5"
              filter="url(#opc-shadow-@_uid)" />
              
        @* Puerto en la punta derecha (Verde) *@
        <circle class="opc-port inlet-port" cx="75" cy="20" r="3" fill="#10B981" />
    }

    @* Texto del destino/origen perfectamente centrado en la caja *@
    <text class="opc-label"
          x="35" y="24"
          text-anchor="middle"
          font-family="Segoe UI, sans-serif"
          font-size="11px"
          font-weight="bold"
          fill="#334155">
        @GetDisplayText()
    </text>
</svg>

@code {
    [Parameter] public double Width { get; set; } = 80;
    [Parameter] public double Height { get; set; } = 40;
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public bool IsOutlet { get; set; } = true;
    [Parameter] public string TargetAreaName { get; set; } = "";

    private string _uid = Guid.NewGuid().ToString("N").Substring(0, 8);

    private string GetDisplayText()
    {
        if (string.IsNullOrWhiteSpace(TargetAreaName)) return "?";
        return TargetAreaName.Length > 8 ? TargetAreaName.Substring(0, 8) + "." : TargetAreaName;
    }
}