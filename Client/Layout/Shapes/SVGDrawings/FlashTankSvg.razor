@code {
    [Parameter] public double Width { get; set; } = 90;
    [Parameter] public double Height { get; set; } = 45;
    [Parameter] public string StatusColor { get; set; } = "#CBD5E0";
    [Parameter] public string ElementId { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public string CssClass { get; set; } = "";

    private string GetCapsulePath()
    {
        double w = Width; double h = Height; double r = h / 2;

        // 🚩 AJUSTE: Forzamos el uso del punto decimal (.) para evitar que el SVG se rompa
        return System.FormattableString.Invariant($"M {r},2 L {w - r},2 A {r - 2},{r - 2} 0 0 1 {w - r},{h - 2} L {r},{h - 2} A {r - 2},{r - 2} 0 0 1 {r},2 Z");
    }
}

<svg class="@CssClass" width="@Width" height="@Height" viewBox="0 0 @Width @Height" style="display: block; overflow: visible;">
    <defs>
        <linearGradient id="flashMetal-@ElementId" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#94A3B8" />
            <stop offset="30%" style="stop-color:@StatusColor" />
            <stop offset="100%" style="stop-color:#64748B" />
        </linearGradient>

        <linearGradient id="liquidGrad-@ElementId" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#60A5FA; stop-opacity:0.6" />
            <stop offset="100%" style="stop-color:#2563EB; stop-opacity:0.8" />
        </linearGradient>

        <clipPath id="clip-@ElementId">
            <path d="@GetCapsulePath()" />
        </clipPath>
    </defs>

    @* A. Cuerpo Base Metálico *@
    <path d="@GetCapsulePath()"
          fill="url(#flashMetal-@ElementId)"
          stroke="#334155"
          stroke-width="2" />

    @* B. Líquido *@
    @{
        double levelH = Height * 0.45;
        double topY = Height - levelH;
    }
    <rect x="0" y="@topY" width="@Width" height="@levelH"
          fill="url(#liquidGrad-@ElementId)"
          clip-path="url(#clip-@ElementId)" />

    @* C. Capa de Brillo Superior *@
    <path d="@GetCapsulePath()"
          fill="none"
          stroke="#334155"
          stroke-width="1.5"
          style="pointer-events:none; opacity: 0.3;" />
</svg>