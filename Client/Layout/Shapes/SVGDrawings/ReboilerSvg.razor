@code {
    [Parameter] public double Width { get; set; } = 60;
    [Parameter] public double Height { get; set; } = 140;
    [Parameter] public string StatusColor { get; set; } = "#CBD5E0";
    [Parameter] public string ElementId { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public string CssClass { get; set; } = "";
}

<svg class="@CssClass" width="@Width" height="@Height" viewBox="0 0 60 140" style="display: block; overflow: visible; filter: drop-shadow(0px 4px 5px rgba(0, 0, 0, 0.2));">
    <defs>
        <linearGradient id="rebReflex-@ElementId" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.6" />
            <stop offset="30%" style="stop-color:#ffffff;stop-opacity:0.1" />
            <stop offset="100%" style="stop-color:#000000;stop-opacity:0.2" />
        </linearGradient>
    </defs>

    @* 1. CUERPO PRINCIPAL *@
    <g style="pointer-events: none;">
        <rect x="10" y="10" width="40" height="120" rx="10"
              fill="@StatusColor"
              style="transition: fill 0.5s cubic-bezier(0.4, 0, 0.2, 1);" />

        <rect x="10" y="10" width="40" height="120" rx="10"
              fill="url(#rebReflex-@ElementId)"
              stroke="#334155" stroke-width="1.5" />
    </g>

    @* 2. DETALLES INTERNOS (Línea central) *@
    <g style="pointer-events: none; stroke: #334155; stroke-width: 1.5px; opacity: 0.35;">
        <line x1="30" y1="120" x2="30" y2="20" stroke-dasharray="4,3" />
    </g>
</svg>