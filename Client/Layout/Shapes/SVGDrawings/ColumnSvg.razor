

<svg class="@CssClass" width="@Width" height="@Height" viewBox="0 0 80 @Height" 
    style="display: block; overflow: visible; filter: drop-shadow(0px 4px 5px rgba(0, 0, 0, 0.2));">
    <defs>
        <linearGradient id="colReflex" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.6" />
            <stop offset="30%" style="stop-color:#ffffff;stop-opacity:0.1" />
            <stop offset="100%" style="stop-color:#000000;stop-opacity:0.2" />
        </linearGradient>
    </defs>

    @* Cuerpo de la Torre (Capa no interactiva) *@
    <g class="column-part" style="pointer-events: none;">
        @* La cápsula se estira dinámicamente *@
        <rect x="20" y="20" width="40" height="@(Height - 60)" rx="20"
              fill="@StatusColor"
              style="transition: fill 0.5s cubic-bezier(0.4, 0, 0.2, 1);" />

        <rect x="20" y="20" width="40" height="@(Height - 60)" rx="20"
              fill="url(#colReflex)"
              stroke="#334155" stroke-width="1.5" />
    </g>

    @* Platos internos *@
    <g class="column-plates column-part" style="pointer-events: none;">
        <line x1="20" y1="80" x2="60" y2="80" stroke="#334155" stroke-width="1" opacity="0.4" />
        <line x1="20" y1="120" x2="60" y2="120" stroke="#334155" stroke-width="1" opacity="0.4" />
        <line x1="20" y1="160" x2="60" y2="160" stroke="#334155" stroke-width="1" opacity="0.4" />
        <line x1="20" y1="200" x2="60" y2="200" stroke="#334155" stroke-width="1" opacity="0.4" />
        <line x1="20" y1="240" x2="60" y2="240" stroke="#334155" stroke-width="1" opacity="0.4" />
    </g>
</svg>

@code {
    [Parameter] public double Width { get; set; } = 80;
    [Parameter] public double Height { get; set; } = 320;
    [Parameter] public string StatusColor { get; set; } = "#CBD5E0";
    [Parameter] public string CssClass { get; set; } = "";
}