@using Client.Layout.Shapes.SVGDrawings
@using Client.Pages.UnitOperations.Mixers
@inherits EquipmentUIBase<StreamMixerVisualElement>

<CanvasEquipmentWrapper Element="Element"
                        IsSelected="IsSelected"
                        IsDragging="IsDragging"
                        OnSelect="HandleSelectionAsync"
                        OnDragStart="OnDragStart"
                        OnOpenDetails="OpenPropertiesDialogAsync">

    @* 1. EL DIBUJO BASE (Encapsulado y Limpio) *@
    @* Nota: Si quieres que el hover funcione igual que en el splitter,
       asegúrate de que MixerSvg.razor acepte el parámetro CssClass *@
    <StreamMixerSvg Width="@Element.Width"
              Height="@Element.Height"
              StatusColor="@(Element.StatusColor ?? "#CBD5E0")"
              CssClass="mix-svg" />


</CanvasEquipmentWrapper>

@code {
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // Disparamos la auto-generación de coordenadas visuales para las entradas y la salida
        Element.RefreshDynamicPorts();
    }

    protected override async Task OpenPropertiesDialogAsync()
    {
        // 🚩 LLAMADA AL DIÁLOGO DEL MIXER
        var parameters = new DialogParameters { ["Equipment"] = Element };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.False,
            FullWidth = false,
            NoHeader = true,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };

        var dialog = await DialogService.ShowAsync<MixerDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            // Refrescamos el componente si el usuario conectó/desconectó tuberías desde el UI
            StateHasChanged();
        }
    }

    // 🚩 ELIMINADO: GetNozzleX se fue.
    // La responsabilidad de saber dónde se dibuja (x=0 o x=Width) ahora es del
    // Element.RefreshDynamicPorts() en la clase MixerVisualElement, tal como hace el Splitter.
}