@inherits EquipmentUIBase<FlashTankVisualElement>

<CanvasEquipmentWrapper Element="Element"
                        IsSelected="IsSelected"
                        IsDragging="IsDragging"
                        OnSelect="HandleSelectionAsync"
                        OnDragStart="OnDragStart"
                        OnOpenDetails="OpenPropertiesDialogAsync">

    <svg width="@Element.Width" height="@Element.Height" viewBox="0 0 @Element.Width @Element.Height" class="flash-svg">
        <defs>
            @* 1. Degradado Metálico Industrial (Rotado para equipo horizontal) *@
            <linearGradient id="flashMetal-@Element.Id" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" style="stop-color:#94A3B8" /> @* Sombra superior *@
                <stop offset="30%" style="stop-color:#F1F5F9" /> @* Brillo central *@
                <stop offset="100%" style="stop-color:#64748B" /> @* Sombra inferior *@
            </linearGradient>

            @* 2. Degradado Líquido (El azul exacto del Vessel) *@
            <linearGradient id="liquidGrad-@Element.Id" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" style="stop-color:#60A5FA; stop-opacity:0.6" />
                <stop offset="100%" style="stop-color:#2563EB; stop-opacity:0.8" />
            </linearGradient>

            @* 3. Máscara para que el líquido respete la forma de cápsula *@
            <clipPath id="clip-@Element.Id">
                <path d="@GetCapsulePath()" />
            </clipPath>
        </defs>

        @* A. Cuerpo Base Metálico *@
        <path d="@GetCapsulePath()"
              fill="url(#flashMetal-@Element.Id)"
              stroke="#334155"
              stroke-width="2" />

        @* B. Líquido (Solo en la parte inferior, con el azul correcto) *@
        @{
            double levelH = Element.Height * 0.45;
            double topY = Element.Height - levelH;
        }
        <rect x="0" y="@topY" width="@Element.Width" height="@levelH"
              fill="url(#liquidGrad-@Element.Id)"
              clip-path="url(#clip-@Element.Id)" />

        @* C. Capa de Brillo Superior (Sutil, para dar volumen extra) *@
        <path d="@GetCapsulePath()"
              fill="none"
              stroke="#334155"
              stroke-width="1.5"
              style="pointer-events:none; opacity: 0.3;" />

        @* D. Boquillas (Unificadas con ControlValve y Vessel) *@
        @foreach (var port in Element.Ports)
        {
            <rect x="@(GetNozzleX(port))" y="@(GetNozzleY(port))"
                  width="10" height="10"
                  class="flash-nozzle" />
        }
    </svg>
</CanvasEquipmentWrapper>

@code {
    private string GetCapsulePath()
    {
        double w = Element.Width; double h = Element.Height; double r = h / 2;
        // Path corregido para que la cápsula horizontal sea perfecta
        return $"M {r},2 L {w - r},2 A {r - 2},{r - 2} 0 0 1 {w - r},{h - 2} L {r},{h - 2} A {r - 2},{r - 2} 0 0 1 {r},2 Z";
    }

    private double GetNozzleX(EquipmentPort p) =>
        p.Direction == PortDirection.Left ? 0 :
        (p.Direction == PortDirection.Right ? Element.Width - 10 : p.OffsetX - 5);

    private double GetNozzleY(EquipmentPort p) =>
        p.Direction == PortDirection.Top ? 0 :
        (p.Direction == PortDirection.Bottom ? Element.Height - 10 : p.OffsetY - 5);

    protected override async Task OpenPropertiesDialogAsync() => await Task.CompletedTask;
}