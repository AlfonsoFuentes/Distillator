@using Shared.ProcessFlowDiagram.Columns
@inherits EquipmentUIBase<ColumnVisualElement>

<CanvasEquipmentWrapper Element="Element"
                        IsSelected="IsSelected"
                        IsDragging="IsDragging"
                        OnSelect="HandleSelectionAsync"
                        OnDragStart="OnDragStart"
                        OnOpenDetails="OpenPropertiesDialogAsync">

    @* 1. 🚩 SVG Dinámico: viewBox y height leen de Element.Height *@
    <svg class="column-svg" width="@Element.Width" height="@Element.Height" viewBox="0 0 80 @Element.Height">
        <defs>
            <linearGradient id="colReflex" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.6" />
                <stop offset="30%" style="stop-color:#ffffff;stop-opacity:0.1" />
                <stop offset="100%" style="stop-color:#000000;stop-opacity:0.2" />
            </linearGradient>
        </defs>

        @* Cuerpo de la Torre *@
        <g class="column-part">
            @* 2. 🚩 La cápsula se estira: Height total menos los 60px de los márgenes superior e inferior *@
            <rect x="20" y="20" width="40" height="@(Element.Height - 60)" rx="20" class="column-dynamic-fill" fill="@(Element.Facade?.StatusColor ?? "#CBD5E0")" />
            <rect x="20" y="20" width="40" height="@(Element.Height - 60)" rx="20" fill="url(#colReflex)" stroke="#334155" stroke-width="1.5" />
        </g>

        @* ... (el resto del código sigue exactamente igual, con los platos y el @foreach de las boquillas) ... *@

        @* Platos internos *@
        <g class="column-plates column-part">
            <line x1="20" y1="80" x2="60" y2="80" />
            <line x1="20" y1="120" x2="60" y2="120" />
            <line x1="20" y1="160" x2="60" y2="160" />
            <line x1="20" y1="200" x2="60" y2="200" />
            <line x1="20" y1="240" x2="60" y2="240" />
        </g>

        @* 🚩 MAGIA VISUAL: Ahora dibujamos las boquillas automáticamente *@
        @foreach (var port in Element.Ports)
        {
            <rect x="@GetNozzleX(port)"
                  y="@GetNozzleY(port)"
                  width="10" height="10"
                  class="column-nozzle" />
        }
    </svg>

</CanvasEquipmentWrapper>

@code {
    // 🚩 EL GATILLO: Blazor ejecuta esto cada vez que la UI se refresca (ej. al conectar un cable)
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // Le ordenamos a la columna que actualice sus puertos
        Element.RefreshDynamicPorts();
    }

    protected override async Task OpenPropertiesDialogAsync()
    {
        Console.WriteLine($"[PFD-PRO] Interacting with Column: {Element.Facade?.Name}");
        await Task.CompletedTask;
    }

    // =========================================================
    // HELPERS VISUALES (Centran el rectángulo metálico en el puerto lógico)
    // =========================================================
    private double GetNozzleX(Shared.ProcessFlowDiagram.EquipmentPort port)
    {
        if (port.Direction == Shared.ProcessFlowDiagram.PortDirection.Top ||
            port.Direction == Shared.ProcessFlowDiagram.PortDirection.Bottom) return port.OffsetX - 5;
            
        if (port.Direction == Shared.ProcessFlowDiagram.PortDirection.Left) return port.OffsetX;
        if (port.Direction == Shared.ProcessFlowDiagram.PortDirection.Right) return port.OffsetX - 10;
        
        return port.OffsetX;
    }

    private double GetNozzleY(Shared.ProcessFlowDiagram.EquipmentPort port)
    {
        if (port.Direction == Shared.ProcessFlowDiagram.PortDirection.Top ||
            port.Direction == Shared.ProcessFlowDiagram.PortDirection.Bottom) return port.OffsetY;
            
        return port.OffsetY - 5;
    }
}