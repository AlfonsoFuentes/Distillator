@using Client.Layout.Shapes.SVGDrawings
@using Client.Pages.UnitOperations.Columns @* Ajusta según donde guardes tus diálogos *@
@using Shared.ProcessFlowDiagram.Columns
@inherits EquipmentUIBase<ColumnVisualElement>

<CanvasEquipmentWrapper Element="Element"
                        IsSelected="IsSelected"
                        IsDragging="IsDragging"
                        OnSelect="HandleSelectionAsync"
                        OnDragStart="OnDragStart"
                        OnOpenDetails="OpenPropertiesDialogAsync">

    @* 1. EL DIBUJO BASE (Encapsulado y Limpio con tu gradiente metálico) *@
    <ColumnSvg Width="@Element.Width"
               Height="@Element.Height"
               StatusColor="@(Element.Facade?.StatusColor ?? "#CBD5E0")"
               CssClass="col-svg" />

    @* 2. CAPA SUPERIOR: Boquillas Interactivas (Capa transparente)
          pointer-events: none en el contenedor, pointer-events: all en las boquillas. *@
    <svg width="@Element.Width" height="@Element.Height" style="position: absolute; top: 0; left: 0; pointer-events: none;">
        @foreach (var port in Element.Ports)
        {
            <rect x="@GetNozzleX(port)"
                  y="@GetNozzleY(port)"
                  width="10" height="10"
                  class="col-nozzle"
                  style="pointer-events: all;" />
        }
    </svg>
</CanvasEquipmentWrapper>

@code {
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // Le ordenamos a la columna que actualice sus puertos y altura dinámica
        Element.RefreshDynamicPorts();
    }

    protected override async Task OpenPropertiesDialogAsync()
    {
        // 🚩 LLAMADA AL DIÁLOGO DE LA COLUMNA (ColumnDialog)
        var parameters = new DialogParameters { ["Equipment"] = Element };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.False,
            FullWidth = false,
            NoHeader = true,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };

        var dialog = await DialogService.ShowAsync<ColumnDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            // Refrescamos el componente si se alteró la topología en el diálogo
            StateHasChanged();
        }
    }

    // =========================================================
    // HELPERS VISUALES (Se mantienen para respetar el ajuste geométrico del cilindro)
    // =========================================================
    private double GetNozzleX(Shared.ProcessFlowDiagram.EquipmentPort port)
    {
        if (port.Direction == Shared.ProcessFlowDiagram.PortDirection.Top ||
            port.Direction == Shared.ProcessFlowDiagram.PortDirection.Bottom) return port.OffsetX - 5;

        if (port.Direction == Shared.ProcessFlowDiagram.PortDirection.Left) return port.OffsetX;
        if (port.Direction == Shared.ProcessFlowDiagram.PortDirection.Right) return port.OffsetX - 10;

        return port.OffsetX;
    }

    private double GetNozzleY(Shared.ProcessFlowDiagram.EquipmentPort port)
    {
        if (port.Direction == Shared.ProcessFlowDiagram.PortDirection.Top ||
            port.Direction == Shared.ProcessFlowDiagram.PortDirection.Bottom) return port.OffsetY;

        return port.OffsetY - 5;
    }
}