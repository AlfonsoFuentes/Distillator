
@inherits EquipmentUIBase<MixerVisualElement>

<CanvasEquipmentWrapper Element="Element"
                        IsSelected="IsSelected"
                        IsDragging="IsDragging"
                        OnSelect="HandleSelectionAsync"
                        OnDragStart="OnDragStart"
                        OnOpenDetails="OpenPropertiesDialogAsync">
    <svg class="mix-svg" width="@Element.Width" height="@Element.Height" viewBox="0 0 @Element.Width @Element.Height">
        <g class="mix-part">
            @* Triángulo invertido proporcional *@
            <path d="M 10, 10
            L @(Element.Width - 10), @(Element.Height / 2)
            L 10, @(Element.Height - 10) Z"
                  class="mix-dynamic-fill"
                  fill="@(Element.Facade?.StatusColor ?? "#CBD5E0")"
                  stroke="#334155" stroke-width="1.5" stroke-linejoin="round" />
        
            <line x1="14" y1="15" x2="14" y2="@(Element.Height - 15)" stroke="#334155" stroke-width="1" opacity="0.3" />
        </g>

        @foreach (var port in Element.Ports)
        {
            <rect x="@(port.OffsetX - 5)"
                  y="@(port.OffsetY - 5)"
                  width="10" height="10"
                  class="mix-nozzle" />
        }
    </svg>

</CanvasEquipmentWrapper>

@code {
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        Element.RefreshDynamicPorts();
    }

    protected override async Task OpenPropertiesDialogAsync()
    {
        Console.WriteLine($"[PFD-PRO] Interacting with Mixer: {Element.Facade?.Name}");
        await Task.CompletedTask;
    }

    private double GetNozzleX(Shared.ProcessFlowDiagram.EquipmentPort port)
    {
        // Las entradas se dibujan en x=0 (base plana izquierda), la salida en x=30 (punta derecha)
        return port.Direction == Shared.ProcessFlowDiagram.PortDirection.Left ? 0 : 30;
    }
}