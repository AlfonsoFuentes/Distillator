@using Client.Layout.Diagrams.Project
@using Client.Services.ProjectWorkspace
@using Distillator.Domain.Models
@using Shared.Projects
@implements IDisposable
@inject ProjectSessionService SessionService
@inject FlowsheetManager FSM

<div class="project-diagram">
    <div class="project-header">
        <div class="project-title">
            <h1>@SessionService.CurrentProject?.Name</h1>
            <span class="flowsheet-name">@SessionService.ActiveFlowsheet?.Name</span>
        </div>
        @if (VisiblePresence.Count > 0)
        {
            <div class="project-presence" aria-label="Project collaborators online">
                @foreach (var presence in VisiblePresence)
                {
                    <div class="presence-user" title="@PresenceTitle(presence)">
                        <span class="presence-dot"></span>
                        <span class="presence-name">@presence.DisplayName</span>
                        @if (!string.IsNullOrWhiteSpace(presence.ActiveDiagramName))
                        {
                            <span class="presence-diagram">@presence.ActiveDiagramName</span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="project-body">
        <div class="project-explorer">
            <FlowsheetExplorer />
        </div>

        <div class="project-canvas">
            @if (SessionService.IsProjectHydrating)
            {
                <div class="project-loading-banner" role="status" aria-live="polite">
                    <span class="loading-dot"></span>
                    <span>@SessionService.ProjectLoadingMessage</span>
                </div>
            }
            <ProcessFlowsheetCanvas />
            <ProcessEquipmentPalette />
        </div>
    </div>
</div>

@code {
    [Parameter] public Project Project { get; set; } = default!;
    private Project? _lastProject;
    private IReadOnlyList<ProjectPresenceDto> VisiblePresence =>
        SessionService.ProjectPresence
            .Where(presence => !presence.UserId.Equals(SessionService.CurrentUser?.Id.ToString(), StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override void OnInitialized()
    {
        SessionService.ProjectChanged += OnProjectChanged;
        SessionService.ProjectPresenceChanged += OnProjectPresenceChanged;
        SessionService.ProjectHydrationChanged += OnProjectHydrationChanged;
        FSM.OnVisualStatesChangedAsync += PersistVisualStatesAsync;
        SessionService.IsSimulationRunning = () => FSM.IsSimulationRunning;
        SessionService.HasActiveVisualOperation = () => FSM.HasActiveVisualOperation;
        FSM.CanEditCurrentProject = () => SessionService.CurrentProject != null &&
                                          SessionService.CanCurrentUserEditProject(SessionService.CurrentProject);
    }

    public void Dispose()
    {
        SessionService.ProjectChanged -= OnProjectChanged;
        SessionService.ProjectPresenceChanged -= OnProjectPresenceChanged;
        SessionService.ProjectHydrationChanged -= OnProjectHydrationChanged;
        FSM.OnVisualStatesChangedAsync -= PersistVisualStatesAsync;
        SessionService.IsSimulationRunning = null;
        SessionService.HasActiveVisualOperation = null;
        FSM.CanEditCurrentProject = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Project != null && Project != _lastProject)
        {
            _lastProject = Project;
            await SessionService.SetCurrentProjectAsync(Project);
        }
    }

    private void OnProjectChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (SessionService.CurrentProject == null)
            {
                FSM.Clear();
            }
            else if (SessionService.ActiveFlowsheet != null)
            {
                FSM.LoadProjectAndFlowsheet(SessionService.CurrentProject, SessionService.ActiveFlowsheet);
            }
            else
            {
                FSM.Clear();
            }

            StateHasChanged();
        });
    }

    private void OnProjectPresenceChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnProjectHydrationChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private static string PresenceTitle(ProjectPresenceDto presence)
    {
        return string.IsNullOrWhiteSpace(presence.ActiveDiagramName)
            ? $"{presence.DisplayName} is online"
            : $"{presence.DisplayName} is viewing {presence.ActiveDiagramName}";
    }

    private Task PersistVisualStatesAsync(IReadOnlyCollection<IFlowsheet> flowsheets)
    {
        return SessionService.PersistDiagramVisualStatesAsync(flowsheets);
    }
}
