@using Client.Services.Security
@using Distillator.Domain.Models
@using Distillator.Domain.Repositories
@using Distillator.Domain.Repositories.InMemory
@using Client.Services.Helpers
@using Client.Pages.Dialogs
@using Shared.Helpers
@using Shared.Projects
@implements IDisposable

@inject IProjectRepository ProjectRepository
@inject ProjectSessionService SessionService

<div class="project-explorer @(IsCollapsed ? "collapsed" : "expanded")">
    <div class="explorer-header">
        @if (!IsCollapsed)
        {
            <span class="explorer-title">PROJECTS</span>
        }
        <button class="toggle-btn" @onclick="ToggleExplorer" title="@(IsCollapsed ? "Expand" : "Collapse")">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                @if (IsCollapsed)
                {
                    <path d="M13 5l7 7-7 7M5 5l7 7-7 7" />
                }
                else
                {
                    <path d="M11 19l-7-7 7-7M19 19l-7-7 7-7" />
                }
            </svg>
        </button>
    </div>

    @if (!IsCollapsed)
    {
        <div class="explorer-toolbar">
            <button class="new-project-btn" @onclick="CreateProject" title="New Project">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>New Project</span>
            </button>
        </div>

        <div class="explorer-content">
            @if (_isLoading)
            {
                <div class="explorer-loading">
                    <div class="spinner"></div>
                    <span>Loading projects...</span>
                </div>
            }
            else if (_projects.Count == 0)
            {
                <div class="explorer-empty">
                    <span>No projects available</span>
                </div>
            }
            else
            {
                <div class="project-list">
                    @if (OwnedProjects.Any())
                    {
                        <div class="project-section-title">My Projects</div>
                        @foreach (var project in OwnedProjects)
                        {
                            @ProjectRow(project)
                        }
                    }

                    @if (SharedProjects.Any())
                    {
                        <div class="project-section-title">Shared With Me</div>
                        @foreach (var project in SharedProjects)
                        {
                            @ProjectRow(project)
                        }
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private RenderFragment<Project> ProjectRow => project => @<div class="project-item @(IsSelected(project) ? "selected" : "")"
                                                                 @onclick="() => SelectProject(project)">
        <div class="project-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
        </div>

        <span class="project-name">@project.Name</span>

        <div class="project-actions" @onclick:stopPropagation="true">
            @if (SessionService.CanCurrentUserEditProject(project))
            {
                <button class="action-btn"
                        @onclick="() => EditProject(project)"
                        @onmouseenter="@(() => _hoveredTooltip = $"edit-{project.Id}")"
                        @onmouseleave="@(() => _hoveredTooltip = null)">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                    @if (_hoveredTooltip == $"edit-{project.Id}")
                    {
                        <span class="pe-tooltip">Edit</span>
                    }
                </button>
            }

            @if (SessionService.IsCurrentUserProjectOwner(project))
            {
                <button class="action-btn"
                        @onclick="() => ShareProject(project)"
                        @onmouseenter="@(() => _hoveredTooltip = $"share-{project.Id}")"
                        @onmouseleave="@(() => _hoveredTooltip = null)">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    @if (_hoveredTooltip == $"share-{project.Id}")
                    {
                        <span class="pe-tooltip">Share</span>
                    }
                </button>

                <button class="action-btn delete"
                        @onclick="() => DeleteProject(project)"
                        @onmouseenter="@(() => _hoveredTooltip = $"delete-{project.Id}")"
                        @onmouseleave="@(() => _hoveredTooltip = null)">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    @if (_hoveredTooltip == $"delete-{project.Id}")
                    {
                        <span class="pe-tooltip">Delete</span>
                    }
                </button>
            }
        </div>
    </div>;
}

@code {
    [Parameter] public EventCallback<Project> OnProjectSelected { get; set; }

    private bool IsCollapsed { get; set; } = false;
    private bool _isLoading = true;
    private List<Project> _projects = new();
    private Guid? _selectedProjectId;
    private string? _hoveredTooltip;
    private bool _isReloadingProjects;
    private bool _reloadProjectsAgain;
    private IEnumerable<Project> OwnedProjects => _projects.Where(SessionService.IsCurrentUserProjectOwner);
    private IEnumerable<Project> SharedProjects => _projects.Where(project => !SessionService.IsCurrentUserProjectOwner(project));

    protected override async Task OnInitializedAsync()
    {
        SessionService.ProjectReloaded += OnProjectReloaded;
        SessionService.ProjectListRefreshRequested += OnProjectListRefreshRequested;
        await LoadProjectsAsync();
    }

    public void Dispose()
    {
        SessionService.ProjectReloaded -= OnProjectReloaded;
        SessionService.ProjectListRefreshRequested -= OnProjectListRefreshRequested;
    }

    private async void OnProjectListRefreshRequested()
    {
        await InvokeAsync(() => LoadProjectsAsync(force: true));
    }

    private void OnProjectReloaded(Project project)
    {
        var index = _projects.FindIndex(item => item.Id == project.Id);
        if (index >= 0)
        {
            _projects[index] = project;
        }
        else
        {
            _projects.Insert(0, project);
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task LoadProjectsAsync(bool force = false)
    {
        if (_isReloadingProjects)
        {
            _reloadProjectsAgain = true;
            return;
        }

        _isReloadingProjects = true;
        _isLoading = true;
        StateHasChanged();

        try
        {
            var user = AuthProvider.CurrentUser;
            if (user == null)
            {
                await AuthProvider.GetAuthenticationStateAsync();
                user = AuthProvider.CurrentUser;
            }

            if (user == null)
            {
                SnackbarService?.ShowError("Unable to load user.");
                return;
            }

            var projects = await SessionService.LoadUserProjectsAsync();
            if (projects == null)
            {
                return;
            }

            _projects = projects;
            await SessionService.InitializeFromProjectsAsync(_projects);

            IsCollapsed = SessionService.IsProjectExplorerCollapsed;

            if (SessionService.CurrentProject != null)
            {
                _selectedProjectId = SessionService.CurrentProject.Id;
                await OnProjectSelected.InvokeAsync(SessionService.CurrentProject);
            }
            else
            {
                _selectedProjectId = null;
                await OnProjectSelected.InvokeAsync(null);
            }
        }
        catch (Exception ex)
        {
            SnackbarService?.ShowError($"Error loading projects: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            _isReloadingProjects = false;
            StateHasChanged();
        }

        if (_reloadProjectsAgain)
        {
            _reloadProjectsAgain = false;
            await LoadProjectsAsync(force: true);
        }
    }

    private async Task ToggleExplorer()
    {
        IsCollapsed = !IsCollapsed;
        await SessionService.SetProjectExplorerCollapsedAsync(IsCollapsed);
    }

    private bool IsSelected(Project project) => _selectedProjectId == project.Id;

    private async Task SelectProject(Project project)
    {
        var latestProject = await SessionService.LoadProjectAsync(project.Id);
        if (latestProject == null)
        {
            await LoadProjectsAsync(force: true);
            return;
        }

        var index = _projects.FindIndex(item => item.Id == latestProject.Id);
        if (index >= 0)
        {
            _projects[index] = latestProject;
        }

        _selectedProjectId = latestProject.Id;
        await SessionService.SetCurrentProjectAsync(latestProject);
        await OnProjectSelected.InvokeAsync(latestProject);
    }

    private async Task CreateProject()
    {
        var parameters = new DialogParameters
        {
            { "ExistingProjects", _projects }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.False,
            FullWidth = false,
            NoHeader = true,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        var dialog = await DialogService.ShowAsync<ProjectFormDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled == false && result.Data is Project newProject)
        {
            await ProjectRepository.SaveAsync(newProject);
            await SessionService.PersistProjectCreatedAsync(newProject);
            _projects.Insert(0, newProject);
            await SelectProject(newProject);
            SnackbarService?.ShowSuccess($"Project '{newProject.Name}' created.");
        }
    }

    private async Task EditProject(Project project)
    {
        var projectToEdit = await SessionService.LoadProjectAsync(project.Id, recalculate: false);
        if (projectToEdit == null)
        {
            await LoadProjectsAsync(force: true);
            return;
        }

        var index = _projects.FindIndex(item => item.Id == projectToEdit.Id);
        if (index >= 0)
        {
            _projects[index] = projectToEdit;
        }

        var parameters = new DialogParameters
        {
            { "Project", projectToEdit },
            { "ExistingProjects", _projects }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.False,
            FullWidth = false,
            NoHeader = true,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        var dialog = await DialogService.ShowAsync<ProjectFormDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled == false && result.Data is Project updatedProject)
        {
            await ProjectRepository.SaveAsync(updatedProject);
            var updatedIndex = _projects.FindIndex(item => item.Id == updatedProject.Id);
            if (updatedIndex >= 0)
            {
                _projects[updatedIndex] = updatedProject;
            }

            if (SessionService.CurrentProject?.Id == updatedProject.Id)
            {
                await OnProjectSelected.InvokeAsync(updatedProject);
            }
            SnackbarService?.ShowSuccess($"Project '{updatedProject.Name}' updated.");
        }
    }

    private async Task ShareProject(Project project)
    {
        var sharing = await SessionService.GetProjectSharingAsync(project.Id);
        if (sharing == null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            { "AvailableUsers", sharing.AvailableUsers },
            { "Collaborators", sharing.Collaborators }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.False,
            FullWidth = false,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };

        var dialog = await DialogService.ShowAsync<ShareProjectDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled == false && result.Data is List<ProjectCollaboratorDto> collaborators)
        {
            await SessionService.UpdateProjectSharingAsync(project.Id, collaborators);
        }
    }

    private async Task DeleteProject(Project project)
    {
        var parameters = new DialogParameters
        {
            { "ProjectName", project.Name }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<DeleteProjectDialog>("Delete Project", parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled == false)
        {
            var deleted = await SessionService.DeleteProjectAsync(project);
            if (!deleted)
            {
                return;
            }

            await ProjectRepository.DeleteAsync(project.Id);
            _projects.Remove(project);

            if (_selectedProjectId == project.Id && _projects.Count > 0)
            {
                var next = _projects.First();
                await SelectProject(next);
            }
            else if (_projects.Count == 0)
            {
                _selectedProjectId = null;
                await OnProjectSelected.InvokeAsync(null);
            }

            SnackbarService?.ShowSuccess($"Project '{project.Name}' deleted.");
        }
    }
}
