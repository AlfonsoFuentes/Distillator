
@typeparam TItem
@typeparam TValue

<div class="variable-container @(Mode == VariableMode.Standard ? "mode-standard" : "mode-compact")">

    @if (Mode == VariableMode.Standard)
    {
        @* --- MODO DIÁLOGO (3 Columnas) --- *@
        <div class="variable-standard-grid @GetSourceClass() @(IsEffectivelyReadOnly ? "is-readonly" : "")">
            <div class="grid-cell label">@Label</div>

            <div class="grid-cell value-cell" style="position: relative;">
                <div class="readonly-wrapper dropdown-trigger" @onclick="ToggleSelector">
                    <span class="value-text">@GetDisplayValue()</span>
                    @if (!IsEffectivelyReadOnly)
                    {
                        <span class="chevron-icon">▾</span>
                    }
                </div>

                @if (_showSelector && !IsEffectivelyReadOnly)
                {
                    <div class="list-popup" @onmouseleave="() => _showSelector = false">
                        <div class="list-item @(!IsValueDefined() ? "selected" : "")"
                             @onclick="ClearSelection">
                            @NullDisplayText
                        </div>
                        @foreach (var item in Items)
                        {
                            var itemVal = ValueSelector(item);
                            var isSelected = IsValueDefined() && EqualityComparer<TValue>.Default.Equals(Variable!.Value, itemVal);
                            <div class="list-item @(isSelected ? "selected" : "")"
                                 @onclick="() => SelectItem(item)">
                                @TextSelector(item)
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="grid-cell unit-cell"></div>
        </div>
    }
    else
    {
        @* --- MODO COMPACTO (1 o 2 Columnas) --- *@
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <div class="grid-cell label">@Label</div>
        }

        <div class="grid-cell integrated-cell @GetSourceClass() @(IsEffectivelyReadOnly ? "is-readonly" : "")" style="position: relative;">

            <div class="value-container-compact dropdown-trigger" @onclick="ToggleSelector">
                <div class="compact-display-text">
                    <span class="value-text">@GetDisplayValue()</span>
                    @if (!IsEffectivelyReadOnly)
                    {
                        <span class="chevron-icon">▾</span>
                    }
                </div>
            </div>

            @if (_showSelector && !IsEffectivelyReadOnly)
            {
                <div class="list-popup" @onmouseleave="() => _showSelector = false">
                    <div class="list-item @(!IsValueDefined() ? "selected" : "")"
                         @onclick="ClearSelection">
                        @NullDisplayText
                    </div>
                    @foreach (var item in Items)
                    {
                        var itemVal = ValueSelector(item);
                        var isSelected = IsValueDefined() && EqualityComparer<TValue>.Default.Equals(Variable!.Value, itemVal);
                        <div class="list-item @(isSelected ? "selected" : "")"
                             @onclick="() => SelectItem(item)">
                            @TextSelector(item)
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>
@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public ControlledVariable<TValue> Variable { get; set; } = default!;
    [Parameter] public EventCallback<ControlledVariable<TValue>> VariableChanged { get; set; }
    
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter, EditorRequired] public Func<TItem, string> TextSelector { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, TValue> ValueSelector { get; set; } = default!;
    
    // Comparador personalizado opcional para objetos complejos
    [Parameter] public Func<TValue, TValue, bool>? CustomComparer { get; set; }
    
    [Parameter] public EventCallback<TItem> OnItemSelected { get; set; }
    [Parameter] public EventCallback OnCleared { get; set; }
    
    [Parameter] public string NullDisplayText { get; set; } = "<Not defined>";
    [Parameter] public VariableMode Mode { get; set; } = VariableMode.Standard;
    [Parameter] public bool IsReadOnly { get; set; } = false;

    private bool _showSelector;

    protected bool IsEffectivelyReadOnly => IsReadOnly || (Variable?.Source == MethodSource.Other);

    private bool IsValueDefined() => Variable != null && Variable.IsDefined && Variable.Value != null;

    private string GetSourceClass() => $"source-{Variable?.Source.ToString().ToLower() ?? "none"}";
    
    private string GetDisplayValue()
    {
        if (!IsValueDefined()) return NullDisplayText;

        // 🌟 EL TRUCO DE MAGIA: Si el valor guardado es del mismo tipo que los ítems, 
        // usamos el TextSelector directamente sin buscar en la lista. ¡Súper rápido y seguro!
        if (Variable!.Value is TItem itemValue && TextSelector != null)
        {
            return TextSelector(itemValue);
        }

        // Si son tipos distintos (ej. TValue es Guid y TItem es Objeto), buscamos en la lista
        if (Items != null && Items.Any() && ValueSelector != null && TextSelector != null)
        {
            var matchedItem = Items.FirstOrDefault(i => AreValuesEqual(ValueSelector(i), Variable!.Value!));
            if (matchedItem != null) return TextSelector(matchedItem);
        }
        
        // Fallback final
        return Variable!.Value!.ToString() ?? NullDisplayText;
    }

    private bool AreValuesEqual(TValue val1, TValue val2)
    {
        if (CustomComparer != null) return CustomComparer(val1, val2);
        return EqualityComparer<TValue>.Default.Equals(val1, val2);
    }

    private void ToggleSelector()
    {
        if (!IsEffectivelyReadOnly) _showSelector = !_showSelector;
    }

    private async Task SelectItem(TItem item)
    {
        _showSelector = false;
        if (OnItemSelected.HasDelegate)
        {
            await OnItemSelected.InvokeAsync(item);
        }
        else if (Variable != null)
        {
            Variable.SetValue(ValueSelector(item), MethodSource.UserInterface);
            if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
        }
    }

    private async Task ClearSelection()
    {
        _showSelector = false;
        if (OnCleared.HasDelegate)
        {
            await OnCleared.InvokeAsync();
        }
        else if (Variable != null)
        {
            Variable.ClearValue();
            if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
        }
    }
}