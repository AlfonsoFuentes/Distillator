@typeparam T where T : Amount
@using System.Globalization

<div class="edit-amount-wrapper">
    <input type="number"
           class="edit-amount-input"
           value="@FormattedValue"
           @onchange="OnInputChanged"
           step="any"
           readonly="@IsReadOnly" />

    <select class="edit-amount-select" @onchange="HandleUnitChange" disabled="@IsUnitSelectDisabled">
        @foreach (var _unit in Amount.UnitsList)
        {
            <option value="@_unit.Name" selected="@(_unit.Name == Amount.Unit.Name)">
                @_unit.Symbol
            </option>
        }
    </select>
</div>
