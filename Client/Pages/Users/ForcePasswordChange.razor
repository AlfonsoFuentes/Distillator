@page "/force-password-change"
@layout AuthLayout

@using Shared.Results
@using Microsoft.AspNetCore.Components.Authorization




<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudCard Elevation="3" Class="pa-8">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">
            <b>Action Required</b>
        </MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6 mud-text-secondary">
            You must change your temporary password before accessing the system.
        </MudText>
        
        <EditForm Model="@_request" OnValidSubmit="ExecutePasswordChange">
            <DataAnnotationsValidator />
            
            <MudTextField @bind-Value="_request.Email"
                          Label="Email Address"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4"
                          Disabled="true" />
                          
            <MudTextField @bind-Value="_request.CurrentPassword"
                          Label="Temporary Password"
                          InputType="@_passwordInput"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordInputIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4"
                          Required="true" />
              
            <MudTextField @bind-Value="_request.NewPassword"
                          Label="New Password"
                          InputType="@_passwordInput"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordInputIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4"
                          Required="true" />

            <MudTextField @bind-Value="_request.ConfirmNewPassword"
                          Label="Confirm New Password"
                          InputType="@_passwordInput"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordInputIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-6"
                          Required="true" />
            
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@_isLoading">
                @if (_isLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <span>Change Password & Login</span>
                }
            </MudButton>
        </EditForm>
    </MudCard>
</MudContainer>

@code {
    // Capturamos el email que viene en la URL: /force-password-change?email=usuario@correo.com
    [SupplyParameterFromQuery(Name = "email")]
    public string? EmailQuery { get; set; }

    private ChangeInitialPasswordRequest _request = new();
    private bool _isLoading = false;
    private bool _isShowPassword;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
    private void TogglePasswordVisibility()
    {
        _isShowPassword = !_isShowPassword;
        _passwordInputIcon = _isShowPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        _passwordInput = _isShowPassword ? InputType.Text : InputType.Password;
    }
    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(EmailQuery))
        {
            _request.Email = EmailQuery;
        }
        else
        {
            // Si alguien intenta entrar aquí directamente sin un email, lo devolvemos al login
            NavigationManager.NavigateTo("/login");
        }
    }

    private async Task ExecutePasswordChange()
    {
        _isLoading = true;
        
        // Llamamos a tu servicio HTTP centralizado
        // ❌ VIEJO: var response = await HttpServices.PostAsync<ChangeInitialPasswordRequest, Result>(_request);
        var response = await HttpServices.PostAsync<ChangeInitialPasswordRequest>(_request);
        
        if (response != null && response.Succeeded)
        {
            // 1. Notificamos silenciosamente a la app que el usuario ya está logueado
            if (AuthStateProvider is CustomAuthenticationStateProvider customProvider)
            {
                customProvider.NotifyAuthenticationStateChanged();
            }
            
            // 2. Navegación fluida al Dashboard principal
            NavigationManager.NavigateTo("/");
        }
        
        _isLoading = false;
    }
}