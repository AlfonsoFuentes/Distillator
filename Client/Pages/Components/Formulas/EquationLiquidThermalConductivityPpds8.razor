@* EquationLiquidThermalConductivityPpds8.razor *@
<div class="equation-container">
    <svg class="equation-svg"
         viewBox="0 0 620 150"
         role="img"
         aria-label="PPDS8 liquid thermal conductivity equation">
        <text x="310" y="62" text-anchor="middle" class="equation-main">
            k<tspan baseline-shift="sub" font-size="22">liq</tspan>
            = C<tspan baseline-shift="sub" font-size="22">1</tspan>
            (1 + C<tspan baseline-shift="sub" font-size="22">2</tspan>τ<tspan baseline-shift="super" font-size="20">1/3</tspan>
            + C<tspan baseline-shift="sub" font-size="22">3</tspan>τ<tspan baseline-shift="super" font-size="20">2/3</tspan>
            + C<tspan baseline-shift="sub" font-size="22">4</tspan>τ)
        </text>
        <text x="310" y="108" text-anchor="middle" class="equation-sub">
            τ = 1 - T / T<tspan baseline-shift="sub" font-size="16">c</tspan>
        </text>
    </svg>
</div>

<style>
    .equation-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0.75rem 1rem;
        background-color: var(--mud-palette-background-grey);
        border: 1px dashed var(--mud-palette-action-default);
        border-radius: 8px;
        margin-bottom: 2rem;
        min-height: 160px;
    }

    .equation-svg {
        width: min(760px, 100%);
        height: auto;
        display: block;
    }

    .equation-svg text {
        fill: var(--mud-palette-text-primary);
        font-family: "Times New Roman", serif;
        font-style: italic;
    }

    .equation-main {
        font-size: 46px;
    }

    .equation-sub {
        font-size: 30px;
    }
</style>
