@* EquationLiquidHeatCapacity.razor *@
<div class="equation-container">
    <div class="equation-wrapper">
        <span class="var">C</span><sub>p,liq</sub> =
        <span class="var">C</span><sub>1</sub> +
        <span class="var">C</span><sub>2</sub><span class="var">T</span> +
        <span class="var">C</span><sub>3</sub><span class="var">T</span><sup>2</sup> +
        <span class="var">C</span><sub>4</sub><span class="var">T</span><sup>3</sup> +
        <span class="var">C</span><sub>5</sub><span class="var">T</span><sup>4</sup>
    </div>
</div>

<style>
    .equation-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        background-color: var(--mud-palette-background-grey);
        border: 1px dashed var(--mud-palette-action-default);
        border-radius: 8px;
        margin-bottom: 2rem;
        min-height: 120px;
    }

    .equation-wrapper {
        font-family: "Times New Roman", serif;
        font-size: 1.6rem;
        color: var(--mud-palette-text-primary);
        user-select: none;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .var {
        font-style: italic;
    }
    
    /* Pequeño realce para los exponentes para que se vean técnicos */
    sup {
        font-size: 0.9rem;
        color: var(--mud-palette-primary);
        font-weight: bold;
    }
</style>