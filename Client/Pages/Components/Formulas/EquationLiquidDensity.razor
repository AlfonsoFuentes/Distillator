@* EquationLiquidDensity.razor *@
<div class="equation-container">
    <div class="equation-wrapper">
        <span class="var">ρ</span><sub class="sub">liq</sub> = 
        <div class="fraction-main">
            <div class="num"><span class="var">C</span><sub>1</sub></div>
            <div class="den">
                <span class="var">C</span><sub>2</sub><sup class="exp-complex">
                    1 + (1 - <span class="var">T</span>/<span class="var">C</span><sub>3</sub>)<sup><span class="var">C</span><sub>4</sub></sup>
                </sup>
            </div>
        </div>
    </div>
</div>

<style>
    .equation-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        background-color: var(--mud-palette-background-grey);
        border: 1px dashed var(--mud-palette-action-default);
        border-radius: 8px;
        margin-bottom: 2rem;
        min-height: 140px;
    }

    .equation-wrapper {
        font-family: "Times New Roman", serif;
        font-size: 1.6rem;
        color: var(--mud-palette-text-primary);
        user-select: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .var { font-style: italic; }
    .sub { font-size: 0.8rem; vertical-align: sub; }

    .fraction-main {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        vertical-align: middle;
    }

    .fraction-main > .num { 
        border-bottom: 2px solid var(--mud-palette-text-primary); 
        padding: 0 1rem 0.2rem 1rem; 
    }
    
    .fraction-main > .den { 
        padding: 0.5rem 1rem 0 1rem; 
    }

    .exp-complex {
        font-size: 0.9rem;
        color: var(--mud-palette-primary);
        font-weight: bold;
        position: relative;
        top: -0.5rem;
        margin-left: 0.1rem;
    }

    sup {
        font-size: 0.7rem;
    }
</style>