@page "/"

@using Client.Templates.Panels
@using Distillator.Domain.Models

@attribute [Authorize]

<PageTitle>Distillator - Projects</PageTitle>

<div class="home-layout">
    <ProjectExplorer OnProjectSelected="HandleProjectSelected" />

    <div class="home-content">
        @if (_selectedProject != null)
        {
            <ProjectDiagram Project="_selectedProject" />
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📁</div>
                <h2>No project selected</h2>
                <p>Select a project from the explorer to view its details.</p>
            </div>
        }
    </div>
</div>

@code {
    private Project? _selectedProject;

    private void HandleProjectSelected(Project? project)
    {
        _selectedProject = project;
    }
}
