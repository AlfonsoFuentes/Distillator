@page "/"

@implements IDisposable
@inject INamingService Naming
@inject IEquipmentFactory Factory
@inject IJSRuntime JS
<PageTitle>Distillator System - PFD Workspace</PageTitle>

@* 1. Agregamos tabindex y los eventos globales de teclado/mouse *@
<div class="pfd-workspace"
     @ref="workspaceRef"
     tabindex="0"
     @onmousedown="EnsureFocus"
     @onclick="HandleWorkspaceClick"
     @onkeydown="HandleKeyDown"
     @onkeyup="HandleKeyUp"
     @onmousemove="HandleMouseMove"
     @onmouseup="HandleMouseUp"
     @onmouseleave="HandleMouseLeave"
     @ondragover:preventDefault="true"
     @ondragover="() => { }"
     @ondrop="HandleDrop">

    @* CAPA 1: TUBERÍAS (SVG de fondo puro, no bloquea clics) *@
    <svg class="pipes-layer">
        @* Tuberías confirmadas *@
        @foreach (var pipe in WM.Pipes)
        {
            <CanvasPipeWrapper @key="pipe.Id" Pipe="pipe"  IsDraft="false" />
        }
        
        @* La línea de tensión (Borrador) que sigue al ratón *@
        @if (WM.CurrentDraftPipe != null)
        {
            <CanvasPipeWrapper Pipe="WM.CurrentDraftPipe" IsDraft="true" />
        }
    </svg>

    @* CAPA 2: EQUIPOS FÍSICOS (HTML flotante) *@
    @foreach (var el in WM.Elements)
    {
        <EquipmentRenderer @key="el.Id"
                           Element="el"
                        
                           IsDragging="WM.IsMoving(el)"
                           IsSelected="@(WM.SelectedElement?.Id == el.Id)"
                           OnSelect="HandleSelect"
                           OnDragStart="e => WM.StartMove(el, e)" />
    }

    <div class="canvas-title">Process Flow Diagram - Workspace</div>
</div>

@code {
    private ElementReference workspaceRef;

    // 🚩 Cada vez que alguien toque el canvas, reclamamos el foco para el teclado
    private async Task EnsureFocus()
    {
        await workspaceRef.FocusAsync();
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await workspaceRef.FocusAsync();
        
            // Medimos dónde quedó el lienzo en la pantalla
            var offset = await JS.InvokeAsync<Offset>("getCanvasOffset", workspaceRef);
            canvasX = offset.X;
            canvasY = offset.Y;
        }
    }

    protected override void OnInitialized()
    {
    
        WM.OnNotifyUI += StateHasChanged;
    }

    private void HandleDrop(DragEventArgs e) => WM.AddFromToolbox(DragState.CurrentDraggedItem, e.OffsetX, e.OffsetY);

    private void HandleSelect(IVisualElement element) => WM.SelectElement(element);

    private void HandleWorkspaceClick()
    {
        // Limpiamos la selección si hacemos clic en el vacío
        WM.SelectElement(null!);
    }

    // =========================================================
    // EVENTOS DE TECLADO Y RATÓN (SISTEMA NERVIOSO)
    // =========================================================
    
    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey) WM.SetConnectionMode(true);
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Control") WM.SetConnectionMode(false);
    }

    private async Task HandleMouseMove(MouseEventArgs e)
    {
        // Opcional: Si notas que al redimensionar la ventana se descuadra,
        // puedes llamar a una función que refresque canvasX/Y cada cierto tiempo
        // o en eventos específicos, pero por ahora vamos bien.
    
        var pos = GetRelativeMousePosition(e);
    
        WM.Move(e);

        if (WM.CurrentDraftPipe != null)
        {
            WM.UpdateConnectionDraft(pos.X, pos.Y);
        }
    }
    private double canvasX;
    private double canvasY;

    // 2. Este método calcula la posición REAL del mouse respecto al inicio del Workspace
    private CanvasPoint GetRelativeMousePosition(MouseEventArgs e)
    {
        // ClientX/Y es la posición absoluta en la ventana.
        // Al restar la posición del lienzo (canvasX/Y), obtenemos la coordenada local perfecta.
        return new CanvasPoint(e.ClientX - canvasX, e.ClientY - canvasY);
    }



    private void HandleMouseUp(MouseEventArgs e)
    {
        // 1. Lógica normal de soltar equipos
        WM.EndMove();
        
        // 2. Si soltamos el clic en la nada (fuera de un puerto válido), cancelamos el cable
        if (WM.CurrentDraftPipe != null)
        {
            WM.CancelConnectionDraft();
        }
    }

    private void HandleMouseLeave(MouseEventArgs e)
    {
        // Por seguridad, si el mouse sale del canvas, cancelamos todo movimiento o trazado
        WM.EndMove();
        if (WM.CurrentDraftPipe != null) WM.CancelConnectionDraft();
    }

    public void Dispose()
    {
        if (WM != null) WM.OnNotifyUI -= StateHasChanged;
    }
   
   
}