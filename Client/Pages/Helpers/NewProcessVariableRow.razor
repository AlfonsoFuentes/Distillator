@typeparam T where T : Amount

@* 👇 Solo renderiza Value + Unit (sin Label) *@
<div class="grid-cell value @(GetCssClass())"
     @onmouseenter="ShowCalculatedTooltip"
     @onmouseleave="HideCalculatedTooltip">
    
    @if (IsReadOnly())
    {
        @* 👇 MODO READONLY: Click para cambiar unidad, hover para ver origen *@
        <div class="readonly-container" @onclick="ToggleUnitListReadonly">
            <span class="readonly-value">@GetAmountDisplayValue()</span>
            
            @* 👇 Tooltip custom: solo visible en hover para valores calculados *@
            @if (_showCalculatedTooltip && Variable.Source == MethodSource.Other && !string.IsNullOrWhiteSpace(Variable.SourceId))
            {
                <div class="calculated-tooltip">
                    <span>Calculated by: @Variable.SourceId</span>
                </div>
            }
        </div>
    }
    else
    {
        @if (_isEditing)
        {
            @* 👇 MODO EDICIÓN: Input limpio *@
            <input type="text"
                   inputmode="decimal"
                   value="@GetInputValue()"
                   placeholder="@GetPlaceholder()"
                   @onfocus="HandleFocus"
                   @oninput="HandleInput"
                   @onkeyup="HandleKeyUp"
                   @onblur="HandleInputBlur"
                   @ref="InputRef" />
        }
        else
        {
            @* 👇 MODO LECTURA: Click para entrar en edición *@
            <span class="display-value" @onclick="EnterEditMode">
                @GetAmountDisplayValue()
            </span>
        }
    }
    
    @* 👇 LISTA DE UNIDADES: Visible para readonly Y editable *@
    @if (_showUnitSelector && Variable.Value?.UnitsList?.Count > 1)
    {
        <div class="unit-list-popup"
             @onmousedown="PreventListClose"
             @onmouseup="AllowListClose"
             @onmouseleave="CloseUnitListOnMouseLeave">
            @foreach (var unit in Variable.Value.UnitsList)
            {
                <div class="unit-list-item @(unit.Name == Variable.GetDisplayUnit()?.Name ? "selected" : "")"
                     @onclick="() => SelectUnit(unit)">
                    @unit.Symbol
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public ControlledAmountVariable<T> Variable { get; set; } = default!;
    [Parameter] public EventCallback<ControlledAmountVariable<T>> VariableChanged { get; set; } = default!;
    
    private MethodSource CurrentSource => Variable.Source;
    private string? _tempInputValue;
    private bool _isEditing;
    private bool _showUnitSelector = false;
    private bool _preventCloseOnBlur = false;
    private bool _showCalculatedTooltip = false;
    private ElementReference InputRef;

    private string GetCssClass() => Variable.Source switch
    {
        MethodSource.None => "source-none",
        MethodSource.UserInterface => "source-ui",
        MethodSource.Other => "source-other",
        _ => "source-none"
    };

    private string GetAmountDisplayValue()
    {
        if (!Variable.IsDefined || Variable.Value == null) return "<Not defined>";
        return Variable.Value.ToString("GG", CultureInfo.InvariantCulture);
    }

    private string GetDisplayValue()
    {
        if (!Variable.IsDefined || Variable.Value == null) return "";
        var displayValue = Variable.GetDisplayValueAsDouble();
        if (displayValue == null) return "";
        var val = displayValue.Value;
        return Math.Abs(val) >= 0.01
            ? val.ToString("F2", CultureInfo.InvariantCulture)
            : val == 0 ? "0.00"
            : val.ToString("F6", CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.');
    }

    private string GetInputValue()
    {
        if (_isEditing && _tempInputValue != null) return _tempInputValue;
        if (!Variable.IsDefined) return "";
        var displayValue = Variable.GetDisplayValueAsDouble();
        if (displayValue == null) return "";
        var val = displayValue.Value;
        return Math.Abs(val) >= 0.01
            ? val.ToString("F2", CultureInfo.InvariantCulture)
            : val == 0 ? "0.00"
            : val.ToString("F6", CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.');
    }

    private string GetPlaceholder() => (!Variable.IsDefined && !_isEditing) ? "<Not defined>" : "";
    private bool IsReadOnly() => Variable.Source == MethodSource.Other;

    private void ToggleUnitListReadonly()
    {
        if (!IsReadOnly() || Variable.Value?.UnitsList?.Count <= 1) return;
        _showUnitSelector = !_showUnitSelector;
        StateHasChanged();
    }

    private async Task EnterEditMode()
    {
        if (IsReadOnly()) return;
        _isEditing = true;
        _showUnitSelector = Variable.Value?.UnitsList?.Count > 1;
        StateHasChanged();
        await Task.Delay(10);
        await InputRef.FocusAsync();
    }

    private void PreventListClose() => _preventCloseOnBlur = true;
    private void AllowListClose() => _ = Task.Delay(50).ContinueWith(_ => _preventCloseOnBlur = false);
    private void CloseUnitListOnMouseLeave() { if (IsReadOnly()) { _showUnitSelector = false; StateHasChanged(); } }

    private async Task HandleInputBlur(FocusEventArgs e)
    {
        if (_preventCloseOnBlur) return;
        await CloseOnBlur(e);
    }

    private async Task SelectUnit(UnitMeasure unit)
    {
        if (Variable.Value == null) return;
        if (unit != Variable.GetPreferredUnit())
        {
            Variable.SetPreferredUnit(unit);
            if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
        }
        StateHasChanged();
    }

    private async Task CloseOnBlur(FocusEventArgs e)
    {
        await Task.Delay(100);
        if (_isEditing) { await CommitValue(); }
        else if (IsReadOnly()) { _showUnitSelector = false; StateHasChanged(); }
    }
    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (IsReadOnly()) return;

        // 1. Confirmar con Enter
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            await CommitValue();
        }
        // 2. Cancelar edición con Escape
        else if (e.Key == "Escape")
        {
            _isEditing = false;
            _showUnitSelector = false;
            _tempInputValue = null;
            StateHasChanged();
        }
        // 3. 👇 LA MAGIA PARA "SUPR" Y "BACKSPACE"
        // Si el usuario borra todo el texto, auto-confirmamos el vaciado inmediatamente.
        else if ((e.Key == "Delete" || e.Key == "Backspace") && string.IsNullOrWhiteSpace(_tempInputValue))
        {
            await CommitValue();
        }
    }
    private async Task CommitValue()
    {
        if (IsReadOnly()) return;
        if (!_isEditing) return;

        // 👇 1. EL SALVAVIDAS:
        // Si es estrictamente 'null', el usuario hizo clic y se fue sin tocar el teclado.
        // No borramos nada, solo apagamos el modo edición y huimos.
        if (_tempInputValue == null)
        {
            _isEditing = false;
            _showUnitSelector = false;
            StateHasChanged();
            return;
        }

        // 👇 2. EL BORRADO REAL:
        // Si no es null, pero está vacío (ej. ""), significa que el usuario
        // seleccionó el texto, lo borró a propósito y dio clic afuera o Enter.
        if (string.IsNullOrWhiteSpace(_tempInputValue))
        {
            Variable.ClearValue();
            
            _tempInputValue = null;
            _isEditing = false;
            _showUnitSelector = false;
            
            if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
            StateHasChanged();
            return;
        }

        // 👇 3. EL GUARDADO NORMAL:
        // Si hay texto, intentar parsearlo y guardarlo.
        var normalizedInput = _tempInputValue.Replace(',', '.');
        if (double.TryParse(normalizedInput, NumberStyles.Any, CultureInfo.InvariantCulture, out var newVal))
        {
            if (Variable.Value != null)
            {
                var currentUnit = Variable.GetDisplayUnit();
                if (currentUnit != null)
                {
                    var newValue = (T)Activator.CreateInstance(typeof(T), newVal, currentUnit)!;
                    Variable.SetValue(newValue, MethodSource.UserInterface);
                }
            }
        }
        
        _tempInputValue = null;
        _isEditing = false;
        _showUnitSelector = false;
        
        if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
        StateHasChanged();
    }
    private async Task CommitValue2()
    {
        if (IsReadOnly()) return;
        if (!_isEditing) return;

        // 👇 Si el input está vacío: des-definir y disparar el Solver
        if (string.IsNullOrWhiteSpace(_tempInputValue))
        {
            // 👇 CORRECCIÓN CLAVE: Usamos tu método que limpia y notifica a la UI/Solver
            Variable.ClearValue();
            
            _tempInputValue = null;
            _isEditing = false;
            _showUnitSelector = false;
            
            if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
            StateHasChanged();
            return;
        }

        // Si hay texto, intentar parsear
        var normalizedInput = _tempInputValue.Replace(',', '.');
        if (double.TryParse(normalizedInput, NumberStyles.Any, CultureInfo.InvariantCulture, out var newVal))
        {
            if (Variable.Value != null)
            {
                var currentUnit = Variable.GetDisplayUnit();
                if (currentUnit != null)
                {
                    var newValue = (T)Activator.CreateInstance(typeof(T), newVal, currentUnit)!;
                    Variable.SetValue(newValue, MethodSource.UserInterface);
                }
            }
        }
        
        _tempInputValue = null;
        _isEditing = false;
        _showUnitSelector = false;
        
        if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
        StateHasChanged();
    }
    private async Task HandleUnitChange(ChangeEventArgs e)
    {
        if (Variable.Value == null) return;
        var unitName = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(unitName)) return;
        var newUnit = Variable.Value.UnitsList.FirstOrDefault(u => u.Name == unitName);
        if (newUnit != null && newUnit != Variable.GetPreferredUnit())
        {
            Variable.SetPreferredUnit(newUnit);
            if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
            StateHasChanged();
        }
    }

    private void HandleFocus(FocusEventArgs e)
    {
        if (IsReadOnly()) return;
        _isEditing = true;
        StateHasChanged();
    }
    
    private async Task HandleInput(ChangeEventArgs e)
    {
        if (IsReadOnly()) return;
        _tempInputValue = e.Value?.ToString();
        _isEditing = true;
        if (string.IsNullOrWhiteSpace(_tempInputValue)) { StateHasChanged(); }
        else { StateHasChanged(); }
    }


    // 👇 CORREGIDO: Lógica de guardado y cambio de Source a None
   

    private async Task ClearValue()
    {
        // Este método se usa solo cuando realmente queremos borrar el valor (ej: reset explícito)
        Variable.ClearValue();
        _tempInputValue = null;
        _isEditing = false;
        _showUnitSelector = false;
        if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
        StateHasChanged();
    }

    private void ShowCalculatedTooltip()
    {
        if (IsReadOnly() && Variable.Source == MethodSource.Other && !string.IsNullOrWhiteSpace(Variable.SourceId))
        {
            _showCalculatedTooltip = true;
            StateHasChanged();
        }
    }

    private void HideCalculatedTooltip()
    {
        _showCalculatedTooltip = false;
        StateHasChanged();
    }
}