@* 👇 Renderiza SOLO Columna 2: Value (dropdown de métodos con validación visual) *@
<div class="grid-cell value @(GetCssClass())"
     @onmouseenter="ShowCalculatedTooltip"
     @onmouseleave="HideCalculatedTooltip">
    
    @* 👇 Dropdown de métodos con bordes visibles *@
    <select class="form-select-minimal"
            disabled="@IsReadOnly()"
            value="@(Variable.Value?.Id.ToString() ?? "")"
            @onchange="HandleSelection"
            @onfocus="HandleFocus"
            @onblur="HandleBlur">
        
        <option value="" disabled="@(Variable.IsDefined)" class="placeholder-option">
            @(Variable.IsDefined ? "" : "<Not defined>")
        </option>
        
        @if (AvailableMethods != null)
        {
            @foreach (var method in AvailableMethods)
            {
                <option value="@method.Id">@method.Name</option>
            }
        }
    </select>
    
    @* 👇 Tooltip custom elegante: solo visible en hover para valores calculados *@
    @if (_showCalculatedTooltip && Variable.Source == MethodSource.Other && !string.IsNullOrWhiteSpace(Variable.SourceId))
    {
        <div class="calculated-tooltip">
            <span>Calculated by: @Variable.SourceId</span>
        </div>
    }
</div>

@code {
    [Parameter] public ControlledVariable<ThermodynamicMethodFullDto?> Variable { get; set; } = default!;
    [Parameter] public List<ThermodynamicMethodFullDto> AvailableMethods { get; set; } = new();
    [Parameter] public EventCallback<ControlledVariable<ThermodynamicMethodFullDto?>> VariableChanged { get; set; } = default!;

    private MethodSource CurrentSource => Variable.Source;
    private bool _showCalculatedTooltip = false;

    private string GetCssClass() => Variable.Source switch
    {
        MethodSource.None => "source-none",
        MethodSource.UserInterface => "source-ui",
        MethodSource.Other => "source-other",
        _ => "source-none"
    };

    private bool IsReadOnly() => Variable.Source == MethodSource.Other;

    // 👇 Handlers para tooltip de valor calculado
    private void ShowCalculatedTooltip()
    {
        if (Variable.Source == MethodSource.Other && !string.IsNullOrWhiteSpace(Variable.SourceId))
        {
            _showCalculatedTooltip = true;
            StateHasChanged();
        }
    }

    private void HideCalculatedTooltip()
    {
        _showCalculatedTooltip = false;
        StateHasChanged();
    }

    private void HandleFocus(FocusEventArgs e)
    {
        // Solo para estilos visuales (borde azul al enfocar)
    }

    private void HandleBlur(FocusEventArgs e)
    {
        // Solo para estilos visuales (quitar borde azul)
    }

    private async Task HandleSelection(ChangeEventArgs e)
    {
        if (IsReadOnly()) return;

        var selectedIdString = e.Value?.ToString();
        
        // 👇 CORREGIDO: Si se selecciona opción vacía, cambiar Source a None (NO borrar valor)
        if (string.IsNullOrWhiteSpace(selectedIdString))
        {
            Variable.Source = MethodSource.None;
            if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
            StateHasChanged();
            return;
        }
        
        if (Guid.TryParse(selectedIdString, out var selectedId))
        {
            var result = await HttpServices.PostAsync<GetMethodFullRequest, Result<ThermodynamicMethodFullDto>>(new GetMethodFullRequest(selectedId));
            if (result.Succeeded && result.Data != null)
            {
                Variable.SetValue(result.Data, MethodSource.UserInterface);
                if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
            }
        }
        
        StateHasChanged();
    }
}