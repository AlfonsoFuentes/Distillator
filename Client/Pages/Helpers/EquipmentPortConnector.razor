@using System.Globalization
@using Shared.ProcessFlowDiagram.Pipes

<div class="port-connector-container material-theme">

    <div class="connector-header">
        <label class="port-label">@Port.Name</label>
        @if (Port.ConnectedElementId.HasValue)
        {
            <span class="status-badge connected">Connected</span>
        }
    </div>

    <div class="input-group">
        <input type="text"
               class="port-input"
               list="@($"list-{Port.Id}")"
               placeholder="Select or type name..."
               value="@_inputValue"
               disabled="@IsProjectReadOnly"
               @oninput="@(e => _inputValue = e.Value?.ToString() ?? string.Empty)"
               @onchange="HandleListSelection" />

        <datalist id="@($"list-{Port.Id}")">
            @foreach (var stream in GetAvailableStreams())
            {
                <option value="@stream.Label">@stream.Label</option>
            }
        </datalist>

        @* MÁQUINA DE ESTADOS DEL BOTÓN LATERAL *@
        <div class="btn-tooltip-container">

            @if (Port.ConnectedElementId.HasValue)
            {
                // ESTADO 3: CONECTADO -> Mostrar botón de desconectar
                <button type="button"
                        class="action-btn disconnect-btn"
                        @onclick="DisconnectCurrent">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
                <span class="port-tooltip-fixed">Disconnect stream</span>
            }
            else if (!string.IsNullOrWhiteSpace(_inputValue))
            {
                // ESTADO 2: ESCRIBIENDO -> Mostrar botón de confirmar
                <button type="button"
                        class="action-btn confirm-btn"
                        @onclick="HandleConfirmClick">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </button>
                <span class="port-tooltip-fixed">Confirm & Connect</span>
            }
            else
            {
                // ESTADO 1: VACÍO -> Mostrar botón de autogenerar
                <button type="button"
                        class="action-btn generate-btn"
                        @onclick="HandleAutoGenerate">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>
                <span class="port-tooltip-fixed">Generate unique stream</span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EquipmentPort Port { get; set; } = default!;
    [Parameter, EditorRequired] public IVisualElement ParentEquipment { get; set; } = default!;
    [Parameter] public EventCallback OnConnChanged { get; set; }
    [CascadingParameter(Name = "IsProjectReadOnly")] public bool IsProjectReadOnly { get; set; }
    private string _inputValue = string.Empty;

    protected override void OnParametersSet()
    {
        var connectedStream = GetConnectedStream();
        _inputValue = connectedStream?.Label ?? string.Empty;
    }

    private IVisualElement? GetConnectedStream()
    {
        if (!Port.ConnectedElementId.HasValue) return null;
        return FSM.GetConnectedElementForPort(ParentEquipment, Port.Name);
    }

