    private async Task CreateSpatiallyAndConnect(string newStreamName)
    {
        var newStream = FSM.CreateAndConnectStreamFromPort(ParentEquipment, Port.Name, newStreamName);
        if (newStream == null) return;

        if (OnConnChanged.HasDelegate)
        {
            await OnConnChanged.InvokeAsync();
        }
    }

    private async Task CreatePipeAndConnect(IVisualElement stream)
    {
        FSM.ConnectEquipmentToProjectStream(ParentEquipment, Port.Name, stream);

        if (OnConnChanged.HasDelegate)
        {
            await OnConnChanged.InvokeAsync();
        }
    }

