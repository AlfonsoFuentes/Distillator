    private async Task ProcessConnectionRequest(string streamName)
    {
        if (IsProjectReadOnly) return;
        if (string.IsNullOrWhiteSpace(streamName))
        {
            await DisconnectCurrent();
            return;
        }

        var currentConnected = GetConnectedStream();
        if (currentConnected != null && string.Equals(currentConnected.Label, streamName, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // Buscar stream existente en todo el proyecto.
        var existingStream = GetAvailableStreams()
            .FirstOrDefault(x => string.Equals(x.Label, streamName, StringComparison.OrdinalIgnoreCase));

        if (existingStream != null)
        {
            await CreatePipeAndConnect(existingStream);
        }
        else
        {
            await CreateSpatiallyAndConnect(streamName);
        }
    }

