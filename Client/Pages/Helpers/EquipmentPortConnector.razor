    private async Task DisconnectCurrent()
    {
        if (IsProjectReadOnly) return;
        if (!Port.ConnectedElementId.HasValue) return;

        FSM.DisconnectEquipmentPort(ParentEquipment, Port.Name);

        _inputValue = string.Empty;

        if (OnConnChanged.HasDelegate)
        {
            await OnConnChanged.InvokeAsync();
        }
    }

