@typeparam T where T : Amount

@* 👇 Solo renderiza Columna 2: Value (readonly, con popup de unidades a la derecha) *@
<div class="grid-cell value @(GetCssClass())"
     @onmouseenter="ShowCalculatedTooltip"
     @onmouseleave="HideCalculatedTooltip">
    
    @* 👇 Contenedor principal: Click para cambiar unidad (incluso si es calculado) *@
    <div class="readonly-container" @onclick="ToggleUnitList">
        
        @* 👇 Valor formateado con Amount.ToString() (valor + unidad) *@
        <span class="readonly-value">@GetAmountDisplayValue()</span>
        
        @* 👇 Tooltip custom elegante: solo visible en hover para valores calculados *@
        @if (_showCalculatedTooltip && Variable.Source == MethodSource.Other && !string.IsNullOrWhiteSpace(Variable.SourceId))
        {
            <div class="calculated-tooltip">
                <span>Calculated by: @Variable.SourceId</span>
            </div>
        }
    </div>
    
    @* 👇 Lista de unidades: popup a la derecha, visible cuando _showUnitSelector = true *@
    @if (_showUnitSelector && Variable.Value?.UnitsList?.Count > 1)
    {
        <div class="unit-list-popup"
             @onmousedown="PreventListClose"
             @onmouseup="AllowListClose"
             @onmouseleave="CloseUnitListOnMouseLeave">
            @foreach (var unit in Variable.Value.UnitsList)
            {
                <div class="unit-list-item @(unit.Name == Variable.GetDisplayUnit()?.Name ? "selected" : "")"
                     @onclick="() => SelectUnit(unit)">
                    @unit.Symbol
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public ControlledAmountVariable<T> Variable { get; set; } = default!;
    [Parameter] public EventCallback<ControlledAmountVariable<T>> VariableChanged { get; set; } = default!;
    
    private MethodSource CurrentSource => Variable.Source;
    private bool _showUnitSelector = false;
    private bool _preventCloseOnBlur = false;
    private bool _showCalculatedTooltip = false;

    private string GetCssClass() => Variable.Source switch
    {
        MethodSource.None => "source-none",
        MethodSource.UserInterface => "source-ui",
        MethodSource.Other => "source-other",
        _ => "source-none"
    };

    // 👇 Usa Amount.ToString() para mostrar valor + unidad SIEMPRE
    private string GetAmountDisplayValue()
    {
        if (!Variable.IsDefined || Variable.Value == null) return "<Not defined>";
        return Variable.Value.ToString("GG", CultureInfo.InvariantCulture);
    }

    // 👇 CORREGIDO: Toggle para mostrar/ocultar lista de unidades (permite incluso si es calculado)
    private void ToggleUnitList()
    {
        // 👇 Solo verificar que haya múltiples unidades, NO bloquear por Source
        if (Variable.Value?.UnitsList?.Count <= 1) return;
        _showUnitSelector = !_showUnitSelector;
        StateHasChanged();
    }

    // 👇 Prevenir cierre al interactuar con la lista
    private void PreventListClose() => _preventCloseOnBlur = true;
    private void AllowListClose() => _ = Task.Delay(50).ContinueWith(_ => _preventCloseOnBlur = false);
    
    // 👇 Cerrar lista cuando el mouse sale del popup
    private void CloseUnitListOnMouseLeave()
    {
        _showUnitSelector = false;
        StateHasChanged();
    }

    // 👇 Seleccionar unidad y actualizar
    private async Task SelectUnit(UnitMeasure unit)
    {
        if (Variable.Value == null) return;
        if (unit != Variable.GetPreferredUnit())
        {
            Variable.SetPreferredUnit(unit);
            if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
        }
        // Lista permanece abierta hasta mouseleave
        StateHasChanged();
    }

    // 👇 Handlers para tooltip de valor calculado
    private void ShowCalculatedTooltip()
    {
        if (Variable.Source == MethodSource.Other && !string.IsNullOrWhiteSpace(Variable.SourceId))
        {
            _showCalculatedTooltip = true;
            StateHasChanged();
        }
    }

    private void HideCalculatedTooltip()
    {
        _showCalculatedTooltip = false;
        StateHasChanged();
    }
}