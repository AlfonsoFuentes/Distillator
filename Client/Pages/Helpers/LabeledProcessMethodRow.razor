@* 👇 Estructura completa: Label (Col 1) + Core (Col 2) *@
<div class="grid-cell label @(GetCssClass())"
     @onmouseenter="ShowLabelTooltip"
     @onmouseleave="HideLabelTooltip">
    
    @Label
    
    @* 👇 Tooltip elegante para label de valores calculados *@
    @if (_showLabelTooltip && Variable.Source == MethodSource.Other && !string.IsNullOrWhiteSpace(Variable.SourceId))
    {
        <div class="label-calculated-tooltip">
            <span>Calculated by: @Variable.SourceId</span>
        </div>
    }
</div>

<NewProcessMethodRow Variable="Variable"
                     AvailableMethods="AvailableMethods"
                     VariableChanged="VariableChanged" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "Thermodynamic Method";
    [Parameter, EditorRequired] public ControlledVariable<ThermodynamicMethodFullDto?> Variable { get; set; } = default!;
    [Parameter] public List<ThermodynamicMethodFullDto> AvailableMethods { get; set; } = new();
    [Parameter] public EventCallback<ControlledVariable<ThermodynamicMethodFullDto?>> VariableChanged { get; set; } = default!;

    private bool _showLabelTooltip = false;

    private string GetCssClass() => Variable.Source switch
    {
        MethodSource.None => "source-none",
        MethodSource.UserInterface => "source-ui",
        MethodSource.Other => "source-other",
        _ => "source-none"
    };

    private void ShowLabelTooltip()
    {
        if (Variable.Source == MethodSource.Other && !string.IsNullOrWhiteSpace(Variable.SourceId))
        {
            _showLabelTooltip = true;
            StateHasChanged();
        }
    }

    private void HideLabelTooltip()
    {
        _showLabelTooltip = false;
        StateHasChanged();
    }
}