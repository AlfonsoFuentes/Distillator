@using Distillator.Domain.Models
@inject ProjectSessionService SessionService

<MudDialog Gutters="false" ContentClass="pa-0">
    <DialogContent>
        <div class="flowsheet-dialog">
            <div class="dialog-header">
                <span class="dialog-title">@DialogTitle</span>
                <button class="close-button" @onclick="Cancel">✕</button>
            </div>

            <div class="tabs-header">
                <div class="tab @(_activeTab == "General" ? "active" : "")" @onclick='() => SetTab("General")'>General</div>
                <div class="tab @(_activeTab == "Diagram Settings" ? "active" : "")" @onclick='() => SetTab("Diagram Settings")'>Diagram Settings</div>
                <div class="tab @(_activeTab == "Default Camera" ? "active" : "")" @onclick='() => SetTab("Default Camera")'>Default Camera</div>
            </div>

            <div class="flowsheet-form-frame">
                <div class="dialog-body">
                    <div class="tab-panel @(_activeTab == "General" ? "active" : "")">
                        <div class="form-group">
                            <label class="form-label">Diagram Name</label>
                            <input type="text"
                                   class="form-input @(NameError != null ? "invalid" : "")"
                                   @bind="_model.Name"
                                   @bind:event="oninput" />
                            @if (NameError != null)
                            {
                                <span class="field-error">@NameError</span>
                            }
                        </div>

                        @if (RequiresDiagramNumber)
                        {
                            <div class="form-group">
                                <label class="form-label">Diagram Number</label>
                                <input type="text"
                                       class="form-input @(DiagramNumberError != null ? "invalid" : "")"
                                       @bind="_model.DiagramNumber"
                                       @bind:event="oninput" />
                                <span class="field-help">Used by diagram-based naming rules. Example: 1 becomes prefix 100.</span>
                                @if (DiagramNumberError != null)
                                {
                                    <span class="field-error">@DiagramNumberError</span>
                                }
                            </div>
                        }

                        @if (IsTypeFixed)
                        {
                            <div class="form-group">
                                <label class="form-label">Diagram Type</label>
                                <div class="calculated-value">@EffectiveTypeName</div>
                            </div>
                        }
                        else if (IsNew)
                        {
                            <div class="form-group">
                                <label class="form-label">Diagram Type</label>
                                <select class="form-select" @bind="_model.TypeCode">
                                    @foreach (var type in AvailableTypes)
                                    {
                                        <option value="@type.Code">@type.DisplayName</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="form-group">
                                <label class="form-label">Diagram Type</label>
                                <div class="calculated-value">@CurrentTypeName</div>
                            </div>
                        }
                    </div>

                    <div class="tab-panel settings-grid @(_activeTab == "Diagram Settings" ? "active" : "")">
                        <div class="form-group">
                            <label class="form-label">Paper Width</label>
                            <input type="number" min="500" max="20000" step="100" class="form-input" @bind="_model.DiagramWidth" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Paper Height</label>
                            <input type="number" min="500" max="20000" step="100" class="form-input" @bind="_model.DiagramHeight" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Grid Size</label>
                            <input type="number" min="5" max="200" step="5" class="form-input" @bind="_model.GridSize" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Global Scale</label>
                            <input type="number" min="0.1" max="2" step="0.1" class="form-input" @bind="_model.GlobalScale" />
                        </div>
                    </div>

                    <div class="tab-panel settings-grid @(_activeTab == "Default Camera" ? "active" : "")">
                        <div class="form-group">
                            <label class="form-label">Zoom</label>
                            <input type="number" min="0.1" max="5" step="0.1" class="form-input" @bind="_model.Zoom" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Pan X</label>
                            <input type="number" step="1" class="form-input" @bind="_model.PanX" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Pan Y</label>
                            <input type="number" step="1" class="form-input" @bind="_model.PanY" />
                        </div>
                    </div>
                </div>

                <div class="dialog-actions">
                    <button class="dialog-btn secondary" type="button" @onclick="Cancel">Cancel</button>
                    <button class="dialog-btn primary" type="button" @onclick="Submit" disabled="@(!IsValid)">Save</button>
                </div>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Project? Project { get; set; }
    [Parameter] public IFlowsheet? Flowsheet { get; set; }
    [Parameter] public string? FixedTypeCode { get; set; }

    private string _activeTab = "General";
    private FlowsheetModel _model = new();

    private bool IsNew => Flowsheet == null;
    private string DialogTitle => IsNew ? "New Diagram" : "Edit Diagram";
    private bool IsTypeFixed => !string.IsNullOrWhiteSpace(FixedTypeCode);
    private bool RequiresDiagramNumber => Project != null && ProjectSessionService.RequiresDiagramNumberForNaming(Project.Configuration.NamingConfig);
    private string EffectiveTypeCode => IsTypeFixed ? FixedTypeCode! : _model.TypeCode;
    private string EffectiveTypeName => Project?.FlowsheetTypes.GetByCode(EffectiveTypeCode)?.DisplayName ?? EffectiveTypeCode;
    private string? NameError => ValidateName(_model.Name);
    private string? DiagramNumberError => ValidateDiagramNumber(_model.DiagramNumber);
    private bool IsValid => NameError == null && DiagramNumberError == null && !string.IsNullOrWhiteSpace(EffectiveTypeCode);

    private IEnumerable<IFlowsheetType> AvailableTypes
    {
        get
        {
            if (Project == null) return Enumerable.Empty<IFlowsheetType>();
            return Project.FlowsheetTypes.AllTypes;
        }
    }

    private string CurrentTypeName
    {
        get
        {
            if (Project == null || Flowsheet == null) return string.Empty;
            return Project.FlowsheetTypes.GetByCode(Flowsheet.TypeCode)?.DisplayName ?? Flowsheet.TypeCode;
        }
    }

    protected override void OnParametersSet()
    {
        if (Flowsheet != null)
        {
            _model.Name = Flowsheet.Name;
            _model.DiagramNumber = Flowsheet.DiagramNumber;
            _model.TypeCode = Flowsheet.TypeCode;
            _model.DiagramWidth = Flowsheet.DiagramWidth;
            _model.DiagramHeight = Flowsheet.DiagramHeight;
            _model.GridSize = Flowsheet.GridSize;
            _model.GlobalScale = Flowsheet.GlobalScale;
            _model.Zoom = Flowsheet.Zoom;
            _model.PanX = Flowsheet.PanX;
            _model.PanY = Flowsheet.PanY;
        }
        else
        {
            _model.Name = string.Empty;
            _model.DiagramNumber = string.Empty;
            _model.TypeCode = FixedTypeCode ?? AvailableTypes.FirstOrDefault()?.Code ?? "PFD";
            _model.DiagramWidth = 5000;
            _model.DiagramHeight = 5000;
            _model.GridSize = 20;
            _model.GlobalScale = 0.7;
            _model.Zoom = 1.0;
            _model.PanX = 0;
            _model.PanY = 0;
        }
    }

    private string? ValidateName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "Name is required";

        if (Project == null)
            return null;

        var typeCode = EffectiveTypeCode;
        var existing = Project.Flowsheets
            .Where(f => f.TypeCode.Equals(typeCode, StringComparison.OrdinalIgnoreCase)
                        && (IsNew || f.Id != Flowsheet!.Id))
            .Any(f => f.Name.Equals(name, StringComparison.OrdinalIgnoreCase));

        if (existing)
            return "A diagram with this name already exists for the selected type";

        return null;
    }

    private string? ValidateDiagramNumber(string? diagramNumber)
    {
        if (!RequiresDiagramNumber)
            return null;

        if (string.IsNullOrWhiteSpace(diagramNumber))
            return "Diagram number is required";

        if (Project == null)
            return null;

        var normalized = diagramNumber.Trim();
        var existing = Project.Flowsheets
            .Where(f => IsNew || f.Id != Flowsheet!.Id)
            .Any(f => string.Equals(f.DiagramNumber?.Trim(), normalized, StringComparison.OrdinalIgnoreCase));

        if (existing)
            return "A diagram with this number already exists";

        return null;
    }

    private void Cancel() => MudDialog.Cancel();
    private void SetTab(string tabName) => _activeTab = tabName;

    private async Task Submit()
    {
        if (!IsValid) return;

        try
        {
            if (IsNew)
            {
                var flowsheet = await SessionService.CreateFlowsheetAsync(EffectiveTypeCode, _model.Name, _model.DiagramNumber);
                await SessionService.UpdateFlowsheetConfigurationAsync(
                    flowsheet,
                    null,
                    _model.DiagramNumber,
                    _model.DiagramWidth,
                    _model.DiagramHeight,
                    _model.GlobalScale,
                    _model.GridSize,
                    _model.Zoom,
                    _model.PanX,
                    _model.PanY);
            }
            else if (Flowsheet != null)
            {
                await SessionService.UpdateFlowsheetConfigurationAsync(
                    Flowsheet,
                    _model.Name,
                    _model.DiagramNumber,
                    _model.DiagramWidth,
                    _model.DiagramHeight,
                    _model.GlobalScale,
                    _model.GridSize,
                    _model.Zoom,
                    _model.PanX,
                    _model.PanY);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch
        {
            // En caso de error, dejarlo en la UI. Podríamos usar Snackbar en el futuro.
        }
    }

    private class FlowsheetModel
    {
        public string Name { get; set; } = string.Empty;
        public string DiagramNumber { get; set; } = string.Empty;
        public string TypeCode { get; set; } = "PFD";
        public double DiagramWidth { get; set; } = 5000;
        public double DiagramHeight { get; set; } = 5000;
        public double GridSize { get; set; } = 20;
        public double GlobalScale { get; set; } = 0.7;
        public double Zoom { get; set; } = 1.0;
        public double PanX { get; set; }
        public double PanY { get; set; }
    }
}
