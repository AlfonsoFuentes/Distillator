<div class="tab-content">
    <div class="form-group">
        <label class="form-label">Default Format</label>
        <select class="form-select"
                @bind:get="DefaultFormat"
                @bind:set="DefaultFormatChanged.InvokeAsync">
            <option value="PDF">PDF</option>
            <option value="Excel">Excel</option>
        </select>
    </div>

    <label class="checkbox-row">
        <input type="checkbox"
               @bind:get="AutoExportOnSimulation"
               @bind:set="AutoExportOnSimulationChanged.InvokeAsync" />
        <span>Auto export after simulation</span>
    </label>
</div>