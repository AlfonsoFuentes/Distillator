@using Distillator.Domain.Models
@using Distillator.Domain.Configuration
@using Shared.Helpers
@using Shared.PropertiesDtos.Methods
@using UnitSystem
@inject ProjectSessionService SessionService

<MudDialog>
    <TitleContent>
        <div class="dialog-title">@DialogTitle</div>
    </TitleContent>

    <DialogContent>
        <div class="project-form">
            <MudTabs Rounded="true" Elevation="0" Class="configuration-tabs">
                <MudTabPanel Text="General">
                    <div class="tab-content">
                        <div class="form-group">
                            <label class="form-label">Project Name</label>
                            <input type="text"
                                   class="form-input @(_nameError != null ? "invalid" : "")"
                                   value="@_projectName"
                                   @oninput="OnNameInput"
                                   @onblur="ValidateName"
                                   placeholder="Enter project name" />
                            @if (_nameError != null)
                            {
                                <span class="field-error">@_nameError</span>
                            }
                        </div>

                        <div class="form-group">
                            <label class="form-label">Thermodynamic Method</label>
                            <select class="form-select @(_methodError != null ? "invalid" : "")" @bind="_selectedMethodId" @onblur="ValidateMethod">
                                <option value="">Select a method...</option>
                                @foreach (var method in _methods)
                                {
                                    <option value="@method.Id">@method.Name</option>
                                }
                            </select>
                            @if (_methodError != null)
                            {
                                <span class="field-error">@_methodError</span>
                            }
                        </div>

                        <div class="form-group">
                            <label class="form-label">Plant Elevation</label>
                            <EditAmount T="Length" Amount="_plantElevation" AmountChanged="OnElevationChanged" Label="" />
                        </div>

                        <div class="form-group read-only">
                            <label class="form-label">Atmospheric Pressure</label>
                            <div class="calculated-value">
                                @(_atmosphericPressure?.ToString() ?? "—")
                            </div>
                        </div>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Units">
                    <div class="tab-content">
                        <div class="unit-system-header">
                            <div class="form-group">
                                <label class="form-label">Unit System</label>
                                <select class="form-select" value="@_activeUnitSystemName" @onchange="OnUnitSystemChanged">
                                    @foreach (var system in _unitSystems)
                                    {
                                        <option value="@system.Name">@system.Name</option>
                                    }
                                </select>
                            </div>
                            <button type="button" class="dialog-btn secondary compact" @onclick="StartCreateUnitSystem">
                                Create Unit System
                            </button>
                        </div>

                        @if (_isCreatingUnitSystem)
                        {
                            <div class="new-unit-system-row">
                                <input type="text"
                                       class="form-input"
                                       @bind="_newUnitSystemName"
                                       placeholder="New unit system name" />
                                <button type="button" class="dialog-btn primary compact" @onclick="CreateUnitSystem">Create</button>
                                <button type="button" class="dialog-btn secondary compact" @onclick="CancelCreateUnitSystem">Cancel</button>
                            </div>
                        }

                        @if (ActiveUnitSystem != null)
                        {
                            <div class="unit-system-note">
                                @(ActiveUnitSystem.IsBuiltIn
                                    ? "Built-in unit systems are read-only. Create a new unit system to customize units."
                                    : "Custom unit system. Changes apply to this project configuration.")
                            </div>

                            <div class="unit-editor">
                                @foreach (var row in GetUnitRows())
                                {
                                    <div class="unit-row">
                                        <label class="form-label">@row.Label</label>
                                        @if (ActiveUnitSystem.IsBuiltIn)
                                        {
                                            <div class="calculated-value">@UnitText(row.Unit)</div>
                                        }
                                        else
                                        {
                                            <select class="form-select"
                                                    value="@row.Unit.Name"
                                                    @onchange="e => SetUnit(row.Slot, e.Value?.ToString())">
                                                @foreach (var option in GetUnitOptions(row.Slot))
                                                {
                                                    <option value="@option.Unit.Name">@option.Label</option>
                                                }
                                            </select>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="placeholder-box">
                                No unit system is available.
                            </div>
                        }
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Camera">
                    <div class="tab-content two-columns">
                        <div class="form-group">
                            <label class="form-label">Default Zoom</label>
                            <input type="number" step="0.05" class="form-input" @bind="_defaultZoom" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Global Scale</label>
                            <input type="number" step="0.05" class="form-input" @bind="_globalScale" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Default Pan X</label>
                            <input type="number" step="1" class="form-input" @bind="_defaultPanX" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Default Pan Y</label>
                            <input type="number" step="1" class="form-input" @bind="_defaultPanY" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Grid Size</label>
                            <input type="number" step="1" class="form-input" @bind="_gridSize" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Min Zoom</label>
                            <input type="number" step="0.05" class="form-input" @bind="_minZoom" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Max Zoom</label>
                            <input type="number" step="0.05" class="form-input" @bind="_maxZoom" />
                        </div>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Reports">
                    <div class="tab-content">
                        <div class="form-group">
                            <label class="form-label">Default Format</label>
                            <select class="form-select" @bind="_reportDefaultFormat">
                                <option value="PDF">PDF</option>
                                <option value="Excel">Excel</option>
                            </select>
                        </div>
                        <label class="checkbox-row">
                            <input type="checkbox" @bind="_autoExportOnSimulation" />
                            <span>Auto export after simulation</span>
                        </label>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Equipment Design">
                    <div class="tab-content two-columns">
                        <div class="form-group">
                            <label class="form-label">Standard</label>
                            <select class="form-select" @bind="_equipmentDesignStandard">
                                <option value="API">API</option>
                                <option value="ASME">ASME</option>
                                <option value="TEMA">TEMA</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Rating Basis</label>
                            <select class="form-select" @bind="_equipmentDesignRatingBasis">
                                <option value="normal">Normal</option>
                                <option value="maximum">Maximum</option>
                            </select>
                        </div>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Naming">
                    <div class="tab-content">
                        <div class="naming-layout">
                            <div class="naming-section">
                                <label class="form-label">Live Name Builder</label>
                                <div class="naming-live-builder">
                                    <div class="naming-preview-line">
                                        <button type="button" class="@GetNamingSlotCss(NamingSlot.DiagramPrefix)" @onclick="() => SelectNamingSlot(NamingSlot.DiagramPrefix)">
                                            <span>@GetNamingSlotValue(NamingSlot.DiagramPrefix)</span>
                                            <small>Diagram Prefix</small>
                                        </button>
                                        <button type="button" class="@GetNamingSlotCss(NamingSlot.SeparatorAfterDiagram)" @onclick="() => SelectNamingSlot(NamingSlot.SeparatorAfterDiagram)">
                                            <span>@GetNamingSlotValue(NamingSlot.SeparatorAfterDiagram)</span>
                                            <small>Separator</small>
                                        </button>
                                        <button type="button" class="@GetNamingSlotCss(NamingSlot.EquipmentPrefix)" @onclick="() => SelectNamingSlot(NamingSlot.EquipmentPrefix)">
                                            <span>@GetNamingSlotValue(NamingSlot.EquipmentPrefix)</span>
                                            <small>Equipment Prefix</small>
                                        </button>
                                        <button type="button" class="@GetNamingSlotCss(NamingSlot.SeparatorAfterPrefix)" @onclick="() => SelectNamingSlot(NamingSlot.SeparatorAfterPrefix)">
                                            <span>@GetNamingSlotValue(NamingSlot.SeparatorAfterPrefix)</span>
                                            <small>Separator</small>
                                        </button>
                                        <button type="button" class="@GetNamingSlotCss(NamingSlot.Sequence)" @onclick="() => SelectNamingSlot(NamingSlot.Sequence)">
                                            <span>@GetNamingSlotValue(NamingSlot.Sequence)</span>
                                            <small>Sequence</small>
                                        </button>
                                    </div>
                                    <div class="naming-current-preview">
                                        <strong>@BuildNamingPreview("Pump", Math.Max(_namingStartingNumber, 1))</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="naming-section">
                                <label class="form-label">Examples by Diagram</label>
                                <div class="diagram-preview-grid">
                                    @foreach (var diagram in GetDiagramNamingPreview())
                                    {
                                        <div class="diagram-preview-card">
                                            <strong>@diagram.Name</strong>
                                            @foreach (var item in diagram.Items)
                                            {
                                                <div class="diagram-preview-item">
                                                    <span>@item.Type</span>
                                                    <span>@item.Name</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="naming-section">
                                <div class="naming-effect-note">
                                    <strong>How this rule behaves</strong>
                                    <span>@GetNamingEffectText()</span>
                                </div>
                            </div>

                            <div class="naming-section">
                                <div class="naming-slot-editor">
                                    <div class="naming-slot-summary">
                                        <strong>@NamingSlotTitle(_selectedNamingSlot)</strong>
                                        <span>@NamingSlotDescription(_selectedNamingSlot)</span>
                                    </div>

                                    @if (_selectedNamingSlot == NamingSlot.DiagramPrefix)
                                    {
                                        <div class="option-list two-options">
                                            <button type="button" class="@GetOptionCardCss(!_useDiagramPrefix)" @onclick="() => SetUseDiagramPrefix(false)">
                                                <strong>Not used</strong>
                                                <span>Equipment names do not include the diagram prefix.</span>
                                            </button>
                                            <button type="button" class="@GetOptionCardCss(_useDiagramPrefix)" @onclick="() => SetUseDiagramPrefix(true)">
                                                <strong>Use diagram prefix</strong>
                                                <span>Each diagram provides the prefix used in reports and equipment lists.</span>
                                            </button>
                                        </div>
                                        <div class="calculated-value">@(_useDiagramPrefix ? "The value will be defined by each diagram." : "Diagram prefix is currently not part of the generated name.")</div>
                                    }
                                    else if (IsSeparatorSlot(_selectedNamingSlot))
                                    {
                                        <div class="option-list separator-options">
                                            @foreach (var separator in GetSeparatorOptions())
                                            {
                                                <button type="button" class="@GetOptionCardCss(GetSeparatorValue(_selectedNamingSlot) == separator.Value)" @onclick="() => SetSeparatorValue(_selectedNamingSlot, separator.Value)">
                                                    <strong>@separator.Label</strong>
                                                </button>
                                            }
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Custom Separator</label>
                                            <input type="text" class="form-input" value="@GetSeparatorValue(_selectedNamingSlot)" @onchange="e => SetSeparatorValue(_selectedNamingSlot, e.Value?.ToString())" maxlength="3" />
                                        </div>
                                    }
                                    else if (_selectedNamingSlot == NamingSlot.EquipmentPrefix)
                                    {
                                        <div class="prefix-grid">
                                            @foreach (var item in GetNamingPrefixRows())
                                            {
                                                <div class="prefix-row">
                                                    <span>@item.Type</span>
                                                    <input type="text"
                                                           class="form-input"
                                                           value="@item.Prefix"
                                                           @onchange="e => SetNamingPrefix(item.Type, e.Value?.ToString())" />
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (_selectedNamingSlot == NamingSlot.Sequence)
                                    {
                                        <div class="form-group">
                                            <label class="form-label">Starting Number</label>
                                            <input type="number" min="1" class="form-input" @bind="_namingStartingNumber" />
                                        </div>
                                        <div class="option-list sequence-options">
                                            @foreach (var scope in GetAvailableNamingCounterScopes())
                                            {
                                                <button type="button" class="@GetOptionCardCss(_namingCounterScope == scope)" @onclick="() => SetNamingCounterScope(scope)">
                                                    <strong>@NamingCounterScopeLabel(scope)</strong>
                                                    <span>@NamingCounterScopeOptionText(scope)</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </MudTabPanel>
            </MudTabs>
        </div>
    </DialogContent>

    <DialogActions>
        <button class="dialog-btn secondary" @onclick="Cancel">Cancel</button>
        <button class="dialog-btn primary" @onclick="Save" disabled="@(!IsValid)">@SaveButtonText</button>
    </DialogActions>
</MudDialog>

<style>
    .dialog-title {
        font-size: 16px;
        font-weight: 600;
        color: #334155;
    }

    .project-form {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 4px 0;
        width: min(92vw, 980px);
        max-width: 100%;
        min-width: 0;
        overflow-x: hidden;
    }

    .configuration-tabs {
        min-height: 360px;
        max-width: 100%;
    }

    .tab-content {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 14px 2px 2px;
    }

    .two-columns {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .form-label {
        font-size: 11px;
        font-weight: 600;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-input,
    .form-select {
        height: 32px;
        padding: 0 10px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        font-size: 12px;
        color: #334155;
        background: #ffffff;
        outline: none;
        transition: border-color 0.15s ease;
    }

    .form-input:focus,
    .form-select:focus {
        border-color: #5D79AE;
    }

    .form-input.invalid,
    .form-select.invalid {
        border-color: #ef4444;
        background-color: #fef2f2;
    }

    .field-error {
        font-size: 10px;
        color: #ef4444;
    }

    .calculated-value {
        height: 32px;
        padding: 0 10px;
        display: flex;
        align-items: center;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        font-size: 12px;
        color: #334155;
    }

    .placeholder-box {
        padding: 10px;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 4px;
        font-size: 11px;
        color: #64748b;
        line-height: 1.4;
    }

    .unit-system-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px;
        align-items: end;
    }

    .new-unit-system-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        gap: 8px;
        align-items: center;
    }

    .unit-system-note {
        padding: 8px 10px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        font-size: 11px;
        color: #64748b;
    }

    .unit-editor {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .unit-row {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: #334155;
    }

    .naming-layout {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .naming-section {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
    }

    .naming-mode-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .naming-mode-card {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 10px;
        text-align: left;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #ffffff;
        color: #334155;
        cursor: pointer;
    }

    .naming-mode-card.selected {
        border-color: #5D79AE;
        background: #eef4ff;
    }

    .naming-mode-card strong {
        font-size: 12px;
    }

    .naming-mode-card span {
        font-size: 11px;
        color: #64748b;
    }

    .naming-mode-grid.compact {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .naming-live-builder {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 12px;
        border: 1px solid #dbeafe;
        border-radius: 8px;
        background: #f8fbff;
    }

    .naming-preview-line {
        display: grid;
        grid-template-columns: minmax(150px, 1.1fr) 64px minmax(150px, 1.1fr) 64px minmax(150px, 1.1fr);
        gap: 8px;
        align-items: stretch;
    }

    .naming-slot {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 3px;
        min-width: 0;
        min-height: 64px;
        padding: 8px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #ffffff;
        color: #334155;
        cursor: pointer;
        text-align: center;
        transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }

    .naming-slot:hover {
        border-color: #5D79AE;
    }

    .naming-slot.selected {
        border-color: #5D79AE;
        box-shadow: 0 0 0 2px rgba(93, 121, 174, 0.16);
    }

    .naming-slot.disabled {
        background: #f8fafc;
        color: #94a3b8;
        border-style: dashed;
    }

    .naming-slot.separator {
        min-height: 52px;
        padding-inline: 6px;
    }

    .naming-slot span {
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.15;
        white-space: nowrap;
    }

    .naming-slot small {
        font-size: 10px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
    }

    .naming-current-preview {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border-radius: 6px;
        background: #ffffff;
        color: #475569;
        font-size: 12px;
    }

    .naming-current-preview strong {
        font-size: 28px;
        color: #0f172a;
        letter-spacing: 0.4px;
    }

    .naming-slot-editor {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #ffffff;
    }

    .naming-slot-summary {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .naming-slot-summary strong {
        color: #0f172a;
        font-size: 13px;
    }

    .naming-slot-summary span,
    .naming-effect-note {
        color: #64748b;
        font-size: 12px;
        line-height: 1.35;
    }

    .naming-effect-note {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 8px 10px;
        border-radius: 6px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .naming-effect-note strong {
        color: #334155;
        font-size: 12px;
    }

    .option-list {
        display: grid;
        gap: 8px;
    }

    .option-list.two-options {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .separator-options {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .sequence-options {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .option-card {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-height: 58px;
        padding: 10px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        background: #ffffff;
        color: #334155;
        text-align: left;
        cursor: pointer;
    }

    .option-card.selected {
        border-color: #5D79AE;
        background: #eef4ff;
        box-shadow: 0 0 0 2px rgba(93, 121, 174, 0.12);
    }

    .option-card strong {
        font-size: 12px;
        color: #0f172a;
    }

    .option-card span {
        font-size: 11px;
        color: #64748b;
        line-height: 1.35;
    }

    .diagram-preview-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .diagram-preview-card {
        display: flex;
        flex-direction: column;
        gap: 7px;
        padding: 12px;
        border: 1px solid #dbeafe;
        border-radius: 8px;
        background: #f8fbff;
        color: #334155;
    }

    .diagram-preview-card > strong {
        font-size: 13px;
        color: #0f172a;
    }

    .diagram-preview-item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px;
        padding: 6px 8px;
        border-radius: 5px;
        background: #ffffff;
        font-size: 12px;
    }

    .diagram-preview-item span:last-child {
        color: #0f172a;
        font-weight: 700;
    }

    .pattern-builder {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 8px;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        background: #f8fafc;
    }

    .pattern-part {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        min-height: 30px;
        padding: 3px 4px 3px 8px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        font-size: 11px;
        color: #334155;
    }

    .pattern-part button {
        width: 22px;
        height: 22px;
        border: 0;
        border-radius: 50%;
        background: #f1f5f9;
        color: #475569;
        cursor: pointer;
    }

    .pattern-literal {
        width: 44px;
        height: 22px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        text-align: center;
        font-size: 11px;
    }

    .add-pattern-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
        gap: 8px;
        align-items: center;
    }

    .prefix-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .prefix-row,
    .preview-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 92px;
        gap: 8px;
        align-items: center;
        font-size: 12px;
        color: #334155;
    }

    .preview-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
