@using Client.Pages.Dialogs.ProjectForm
@inject ProjectSessionService SessionService
@inject IDialogService DialogService

<MudDialog Gutters="false" ContentClass="pa-0">
    <DialogContent>
        <div class="stream-dialog" style="min-width: 650px;">

            <div class="dialog-header">
                <span class="dialog-title">@DialogTitle</span>
                <button class="close-button" @onclick="Cancel">✕</button>
            </div>

            <div class="tabs-header">
                <div class="tab @(_activeTab == "General" ? "active" : "")" @onclick='() => SetTab("General")'>General</div>
                <div class="tab @(_activeTab == "Units" ? "active" : "")" @onclick='() => SetTab("Units")'>Units</div>
                <div class="tab @(_activeTab == "Camera" ? "active" : "")" @onclick='() => SetTab("Camera")'>Camera</div>
                <div class="tab @(_activeTab == "Reports" ? "active" : "")" @onclick='() => SetTab("Reports")'>Reports</div>
                <div class="tab @(_activeTab == "Equipment Design" ? "active" : "")" @onclick='() => SetTab("Equipment Design")'>Design</div>
                <div class="tab @(_activeTab == "Naming" ? "active" : "")" @onclick='() => SetTab("Naming")'>Naming</div>
            </div>

            <div class="tab-content" style="background-color: #ffffff;">
                @if (_activeTab == "General")
                {
                    <div class="tab-content active" style="padding: 0;">
                        <ProjectGeneralTab @bind-ProjectName="_projectName"
                                           ValidateName="ValidateName"
                                           NameError="@_nameError"
                                           @bind-SelectedMethodId="_selectedMethodId"
                                           Methods="_methods"
                                           ValidateMethod="ValidateMethod"
                                           MethodError="@_methodError"
                                           @bind-PlantElevation="_plantElevation"
                                           @bind-PlantElevation:after="CalculateAtmosphericPressure"
                                           AtmosphericPressure="_atmosphericPressure" />
                    </div>
                }
                @if (_activeTab == "Units")
                {
                    <div class="tab-content active" style="padding: 0;">
                        <ProjectUnitsTab UnitSystems="_unitSystems"
                                         @bind-ActiveUnitSystemName="_activeUnitSystemName"
                                         IsCreatingUnitSystem="_isCreatingUnitSystem"
                                         @bind-NewUnitSystemName="_newUnitSystemName"
                                         StartCreateUnitSystem="StartCreateUnitSystem"
                                         CancelCreateUnitSystem="CancelCreateUnitSystem"
                                         CreateUnitSystem="CreateUnitSystem"
                                         ActiveUnitSystem="ActiveUnitSystem"
                                         UnitRows="GetUnitRows()"
                                         GetUnitOptions="GetUnitOptions"
                                         SetUnit="SetUnit"
                                         UnitText="UnitText" />
                    </div>
                }
                @if (_activeTab == "Camera")
                {
                    <div class="tab-content active" style="padding: 0;">
                        <ProjectCameraTab @bind-DefaultZoom="_defaultZoom"
                                          @bind-GlobalScale="_globalScale"
                                          @bind-DefaultPanX="_defaultPanX"
                                          @bind-DefaultPanY="_defaultPanY"
                                          @bind-GridSize="_gridSize"
                                          @bind-MinZoom="_minZoom"
                                          @bind-MaxZoom="_maxZoom" />
                    </div>
                }
                @if (_activeTab == "Reports")
                {
                    <div class="tab-content active" style="padding: 0;">
                        <ProjectReportsTab @bind-DefaultFormat="_reportDefaultFormat"
                                           @bind-AutoExportOnSimulation="_autoExportOnSimulation" />
                    </div>
                }
                @if (_activeTab == "Equipment Design")
                {
                    <div class="tab-content active" style="padding: 0;">
                        <ProjectEquipmentDesignTab @bind-Standard="_equipmentDesignStandard"
                                                   @bind-RatingBasis="_equipmentDesignRatingBasis" />
                    </div>
                }
                @if (_activeTab == "Naming")
                {
                    <div class="tab-content active" style="padding: 0;">
                        <ProjectNamingTab SelectedNamingSlot="_selectedNamingSlot"
                                          SelectNamingSlot="SelectNamingSlot"
                                          GetNamingSlotCss="GetNamingSlotCss"
                                          GetNamingSlotValue="GetNamingSlotValue"
                                          BuildNamingPreview="BuildNamingPreview"
                                          @bind-NamingStartingNumber="_namingStartingNumber"
                                          GetDiagramNamingPreview="GetDiagramNamingPreview"
                                          GetNamingEffectText="GetNamingEffectText"
                                          NamingSlotTitle="NamingSlotTitle"
                                          NamingSlotDescription="NamingSlotDescription"
                                          UseDiagramPrefix="_useDiagramPrefix"
                                          SetUseDiagramPrefix="SetUseDiagramPrefix"
                                          IsSeparatorSlot="IsSeparatorSlot"
                                          GetSeparatorOptions="GetSeparatorOptions"
                                          GetSeparatorValue="GetSeparatorValue"
                                          SetSeparatorValue="SetSeparatorValue"
                                          GetOptionCardCss="GetOptionCardCss"
                                          GetNamingPrefixRows="GetNamingPrefixRows"
                                          SetNamingPrefix="SetNamingPrefix"
                                          NamingCounterScope="_namingCounterScope"
                                          SetNamingCounterScope="SetNamingCounterScope"
                                          GetAvailableNamingCounterScopes="GetAvailableNamingCounterScopes"
                                          NamingCounterScopeLabel="NamingCounterScopeLabel"
                                          NamingCounterScopeOptionText="NamingCounterScopeOptionText" />
                    </div>
                }
            </div>

            @if (_configurationError != null)
            {
                <div class="status-bar status-error" style="margin: 0; border-radius: 0; border-top: 1px solid #ef4444;">
                    <span class="status-text">@_configurationError</span>
                </div>
            }

            <div class="status-bar status-idle" style="justify-content: flex-end; margin-top: 0; border-radius: 0; border-top: 1px solid var(--border-color); padding: 8px 12px; background-color: #f0f0f0 !important; border-left: none;">
                <button class="dialog-btn secondary" @onclick="Cancel" style="margin-right: 8px;">Cancel</button>
                <button class="dialog-btn primary" @onclick="Save" disabled="@(!IsValid)">@SaveButtonText</button>
            </div>
        </div>
    </DialogContent>
</MudDialog>
@code
{
    private string _activeTab = "General";
    private void SetTab(string tabName) => _activeTab = tabName;
}