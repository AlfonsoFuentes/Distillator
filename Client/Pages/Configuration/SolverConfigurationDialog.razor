@using Distillator.Domain.Configuration
@using Shared.Helpers
@inject ProjectSessionService SessionService
@inject FlowsheetManager FSM

<MudDialog>
    <TitleContent>
        Solver Configuration
    </TitleContent>

    <DialogContent>
        <div class="d-flex flex-column gap-4 pa-4">
            <div>
                @if (_isLoadingMethods)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_methodsError != null)
                {
                    <MudAlert Severity="Severity.Error">@_methodsError</MudAlert>
                }
                else
                {
                    <MudSelect T="ThermodynamicMethodFullDto" Value="_localMethod" ValueChanged="SetMethod"
                               Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Label="Thermodynamic Method">
                        @foreach (var method in _methods)
                        {
                            <MudSelectItem Value="method">@method.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
            </div>

            <div>
                <AmountEdit Label="Altitude above sea level" T="Length"
                            @bind-Amount="_localAltitude"
                            @bind-Amount:after="StateHasChanged" />
                <MudText Typo="Typo.caption" Class="text-muted mt-1">
                    Atmospheric pressure is calculated automatically.
                </MudText>
            </div>

            <MudAlert Severity="Severity.Info">
                <div class="d-flex flex-column gap-1">
                    <MudText><strong>Atmospheric Pressure:</strong></MudText>
                    <div class="d-flex gap-3 flex-wrap">
                        <MudText>@AtmosphericPressureCalculator.CalculateFromElevation(_localAltitude).ToString()</MudText>
                    </div>
                </div>
            </MudAlert>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isApplying">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="_isApplying || _isLoadingMethods || _localMethod == null">
            @if (_isApplying)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Apply
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private ThermodynamicMethodFullDto? _localMethod;
    private Length _localAltitude = new(0, LengthUnits.Meter);
    private List<ThermodynamicMethodFullDto> _methods = new();
    private bool _isLoadingMethods;
    private string? _methodsError;
    private bool _isApplying;

    protected override async Task OnInitializedAsync()
    {
        var configuration = SessionService.CurrentProject?.Configuration;
        if (configuration != null)
        {
            _localAltitude = configuration.PlantElevation;
        }

        await LoadThermodynamicMethods();
    }

    private async Task SetMethod(ThermodynamicMethodFullDto? method)
    {
        if (method == null)
        {
            _localMethod = null;
            return;
        }

        var result = await HttpServices.PostAsync<GetMethodFullRequest, ThermodynamicMethodFullDto>(new GetMethodFullRequest(method.Id));
        if (result.Succeeded)
        {
            _localMethod = result.Data ?? method;
        }
    }

    private async Task LoadThermodynamicMethods()
    {
        _isLoadingMethods = true;
        StateHasChanged();

        try
        {
            var result = await HttpServices.PostAsync<GetAllCompleteMethods, List<ThermodynamicMethodFullDto>>(new GetAllCompleteMethods());

            if (result.Succeeded && result.Data != null)
            {
                _methods = result.Data;
                var currentMethodId = SessionService.CurrentProject?.Configuration.ThermodynamicMethodId ?? Guid.Empty;
                _localMethod = _methods.FirstOrDefault(method => method.Id == currentMethodId);

                if (currentMethodId != Guid.Empty && _localMethod == null)
                {
                    _methodsError = "Current thermodynamic method is not available.";
                }
            }
            else
            {
                _methodsError = result.Message ?? "Failed to load thermodynamic methods";
            }
        }
        catch (Exception ex)
        {
            _methodsError = $"Error: {ex.Message}";
        }
        finally
        {
            _isLoadingMethods = false;
            StateHasChanged();
        }
    }

    private async Task Submit()
    {
        if (_isLoadingMethods || _isApplying || _localMethod == null) return;

        var project = SessionService.CurrentProject;
        if (project == null) return;

        _isApplying = true;
        StateHasChanged();

        var current = project.Configuration;
        var configuration = new ProjectConfiguration(
            unitDefaults: UnitConfiguration.Clone(current.UnitDefaults),
            unitSystems: current.UnitSystems.Select(CloneUnitSystem).ToList(),
            activeUnitSystemName: current.ActiveUnitSystemName,
            cameraDefaults: current.CameraDefaults,
            namingConfig: NamingConfiguration.Clone(current.NamingConfig),
            thermodynamicMethodId: _localMethod.Id,
            thermodynamicMethod: _localMethod,
            reportConfig: current.ReportConfig,
            equipmentDesignConfig: current.EquipmentDesignConfig,
            plantElevation: _localAltitude);

        var saved = await SessionService.UpdateProjectConfigurationAsync(project.Name, configuration);
        if (saved)
        {
            FSM.NotifyStateChanged();
            MudDialog.Close(true);
            return;
        }

        _methodsError = "Solver configuration was not saved. Please refresh and try again.";
        _isApplying = false;
        StateHasChanged();
    }

    private void Cancel() => MudDialog.Cancel();

    private static IProjectUnitSystem CloneUnitSystem(IProjectUnitSystem system)
    {
        return new ProjectUnitSystem(system.Name, system.Units, system.IsBuiltIn);
    }
}
