@inject IMainSolver Solver

<MudDialog>
    <TitleContent>
        Solver Configuration
    </TitleContent>

    <DialogContent>
        <div class="d-flex flex-column gap-4 pa-4">

            @* 🔹 Método Termodinámico *@
            <div>

               
                @if (_isLoadingMethods)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_methodsError != null)
                {
                    <MudAlert Severity="Severity.Error">@_methodsError</MudAlert>
                }
                else
                {
                    <MudSelect T=ThermodynamicMethodFullDto Value="_localMethod" ValueChanged="SetMetod"
                               Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Label="Thermodynamic Method">
                        @foreach (var method in _methods!)
                        {
                            <MudSelectItem Value="method">@method.Name</MudSelectItem>
                        }
                    </MudSelect>

                    
                   
                }
            </div>

            @* 🔹 Altitud (con tu componente) *@
            <div>

                <EditAmount Label="Altitude above sea level" T="Length"
                            @bind-Amount="Solver.Altitude" />
                <MudText Typo="Typo.caption" Class="text-muted mt-1">
                    Atmospheric pressure is calculated automatically.
                </MudText>
            </div>

            @* 🔹 Presión Atmosférica Calculada (Read-Only) *@
            <MudAlert Severity="Severity.Info">
                <div class="d-flex flex-column gap-1">
                    <MudText><strong>Atmospheric Pressure:</strong></MudText>
                    <div class="d-flex gap-3 flex-wrap">
                        <MudText>@Solver.AtmosphericPressure.ToString()</MudText>

                    </div>
                </div>
            </MudAlert>

        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isApplying">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="_isApplying || _isLoadingMethods">
            @if (_isApplying)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Apply
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    ThermodynamicMethodFullDto _localMethod = null!;
    private List<ThermodynamicMethodFullDto> _methods=new();
    private bool _isLoadingMethods;
    private string? _methodsError;
    private bool _isApplying;

    protected override async Task OnInitializedAsync()
    {
        // Clonar configuración actual


        // Cargar métodos desde base de datos
        await LoadThermodynamicMethods();
    }
    async Task SetMetod(ThermodynamicMethodFullDto _metod)
    {

        if (_metod != null)
        {
            var result = await HttpServices.PostAsync<GetMethodFullRequest, Result<ThermodynamicMethodFullDto>>(new GetMethodFullRequest(_metod.Id));
            if (result.Succeeded)
            {
                var selectedMethod = result.Data;

                if (selectedMethod != null)
                {
                    Solver.ThermoMethod = selectedMethod;
                    _localMethod = _metod;



                }
            }
        }
        else
        {
            Solver.ThermoMethod = null!;

        }
    }

    private async Task LoadThermodynamicMethods()
    {
        _isLoadingMethods = true;
        StateHasChanged();

        try
        {
            // 🔥 Tu patrón HTTP: GetAllCompleteMethods
            var request = new GetAllCompleteMethods();
            var result = await HttpServices.PostAsync<GetAllCompleteMethods, Result<List<ThermodynamicMethodFullDto>>>(request);

            if (result.Succeeded && result.Data != null)
            {
                _methods = result.Data;

                // Si ya hay un método seleccionado, asegurarse que esté en la lista
                if (Solver.ThermoMethod != null &&!_methods.Any(m => m.Id == Solver.ThermoMethod.Id))
                {
                    // Si no está, buscar por nombre como fallback
                    _localMethod = _methods.First(m => m.Id == Solver.ThermoMethod.Id);
                   
                }
            }
            else
            {
                _methodsError = result.Message ?? "Failed to load thermodynamic methods";
            }
        }
        catch (Exception ex)
        {
            _methodsError = $"Error: {ex.Message}";
        }
        finally
        {
            _isLoadingMethods = false;
            StateHasChanged();
        }
    }

    private async Task Submit()
    {
        if (_isLoadingMethods || _isApplying) return;

        _isApplying = true;
        StateHasChanged();
        //Aqui ponemos guardar a base de datos
        _isApplying = false;
        MudDialog.Close(true);

    }

    private void Cancel() => MudDialog.Cancel();
}