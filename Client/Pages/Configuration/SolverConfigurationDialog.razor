
@* 
<MudDialog>
    <TitleContent>
        Solver Configuration
    </TitleContent>

    <DialogContent>
        <div class="d-flex flex-column gap-4 pa-4">

            @* 🔹 Método Termodinámico 
            <div>
                <MudText Typo="Typo.subtitle1" Class="mb-2">Thermodynamic Method</MudText>

                @if (_isLoadingMethods)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_methodsError != null)
                {
                    <MudAlert Severity="Severity.Error">@_methodsError</MudAlert>
                }
                else
                {
                    <ThermoMethodSelector @bind-Value="_config.ThermodynamicMethod"
                                          Label="Thermodynamic Method" AvailableMethods="_methods" />
                   
                }
            </div>

            @* 🔹 Altitud (con tu componente) 
            <div>
                <MudText Typo="Typo.subtitle1" Class="mb-2">Altitude above sea level</MudText>
                <NewUnifiedVariableRow Label="Altitude"
                                       @bind-Variable="_config.Altitude"
                                       Mode="VariableMode.Standard" />
                <MudText Typo="Typo.caption" Class="text-muted mt-1">
                    Atmospheric pressure is calculated automatically.
                </MudText>
            </div>

            @* 🔹 Presión Atmosférica Calculada (Read-Only) 
            <MudAlert Severity="Severity.Info">
                <div class="d-flex flex-column gap-1">
                    <MudText><strong>Atmospheric Pressure:</strong></MudText>
                    <div class="d-flex gap-3 flex-wrap">
                        <MudText>@_config.AtmosphericPressure.GetValue(PressureUnits.Pascala).ToString("F0") Pa</MudText>
                        <MudText>@_config.AtmosphericPressure.GetValue(PressureUnits.Bara).ToString("F3") bar</MudText>
                        <MudText>@_config.AtmosphericPressure.GetValue(PressureUnits.Atmospherea).ToString("F3") atm</MudText>
                    </div>
                </div>
            </MudAlert>

        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isApplying">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="_isApplying || _isLoadingMethods">
            @if (_isApplying)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Apply
        </MudButton>
    </DialogActions>
</MudDialog> *@

