



<EquipmentBaseDialog Equipment="Equipment" CanEdit="CanEdit">

    @* TOPOLOGÍA, DIBUJO Y PARÁMETROS FLOTANTES (ESTILO HYSYS) *@
    <MainSlot>
        <div class="pump-canvas-layout">

            @* 1. PUERTOS DE CONEXIÓN *@
            <div class="port-selector suction-pos">
                <EquipmentPortConnector Port='Equipment.SuctionPort' ParentEquipment="Equipment" />
            </div>

            <div class="port-selector discharge-pos">
                <EquipmentPortConnector Port='Equipment.DischargePort' ParentEquipment="Equipment" />
            </div>

            @* 2. DIBUJO CENTRAL *@
            <div class="equipment-drawing-zone">
                <PumpSvg Width="180" Height="180" StatusColor="@(Equipment.StatusColor ?? "#CBD5E0")" CssClass="pump-svg-dialog" />
            </div>

            @* 3. PROPIEDADES FLOTANTES *@

        </div>
    </MainSlot>
    <PropertiesSlot>
        @if (Equipment.Facade is SolverPump pumpFacade)
        {

            <VariableAmountRow Label="Delta P"
                                @bind-Variable="pumpFacade.DeltaP"
                                Mode="VariableMode.Standard" />

            <VariablePercentageRow Label="Adiabatic Eff (%)"
                              @bind-Variable="pumpFacade.Efficiency"
                              Mode="VariableMode.Standard"  />
          
            <VariableAmountRow Label="Duty (Power)" IsReadOnly="true"
                                @bind-Variable="pumpFacade.Power"
                                
                                Mode="VariableMode.Standard" />
      
           
        }
    </PropertiesSlot>

</EquipmentBaseDialog>

@code {
    [Parameter] public PumpVisualElement Equipment { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; } = true;
}
