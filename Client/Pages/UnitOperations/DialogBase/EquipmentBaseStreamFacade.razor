@* 👇 display: contents hace que este div sea "invisible" para el Grid.
      Sus hijos se convierten en celdas directas de la columna actual. *@
<div style="display: contents;">

  
    <UnifiedNameRow @bind-Value="Facade.Name"
                    IsDuplicate="CheckDuplicateName"
                    OnGenerate="GenerateUniqueStreamName"
                    Mode="VariableMode.Compact" />
    @* <UnifiedListRow TItem="ThermodynamicMethodFullDto"
                    TValue="ThermodynamicMethodFullDto"
                    Variable="Facade.ThermodynamicMethod"
                    Items="AvailableMethods"
                    TextSelector="m => m.Name"
                    ValueSelector="m => m"
                    CustomComparer="(v1, v2) => v1.Id == v2.Id"
                    Mode="VariableMode.Compact"
                    OnItemSelected="HandleMethodSelection"
                    OnCleared="HandleMethodClear" /> *@

    <NewUnifiedDoubleRow @bind-Variable="Facade.VaporFraction" @bind-Variable:after="NotifyUpdate" Mode="VariableMode.Compact" MinValue="0" MaxValue="1" />
    @* ==========================================
       VARIABLES CON UNIFIED COMPONENT (Sin Label)
       ========================================== *@
    <NewUnifiedVariableRow @bind-Variable="Facade.Temperature" @bind-Variable:after="NotifyUpdate" Mode="VariableMode.Compact" />
    <NewUnifiedVariableRow @bind-Variable="Facade.Pressure" @bind-Variable:after="NotifyUpdate" Mode="VariableMode.Compact" />
    <NewUnifiedVariableRow @bind-Variable="Facade.MassFlow" @bind-Variable:after="NotifyUpdate" Mode="VariableMode.Compact" />
    <NewUnifiedVariableRow @bind-Variable="Facade.MolarFlow" @bind-Variable:after="NotifyUpdate" Mode="VariableMode.Compact" />
    <NewUnifiedVariableRow @bind-Variable="Facade.VolumetricFlow" @bind-Variable:after="NotifyUpdate" Mode="VariableMode.Compact" />


    
    <NewUnifiedVariableRow @bind-Variable="Facade.EnthalpyFlow" Mode="VariableMode.Compact" IsReadOnly="true" />

    @* 👇 Placeholders para mantener alineación con los títulos de grupo del padre *@
    <div class="grid-cell value group-spacer"></div>
    <NewUnifiedVariableRow @bind-Variable="Facade.MassDensity" Mode="VariableMode.Compact" IsReadOnly="true" />
    <NewUnifiedVariableRow @bind-Variable="Facade.MolarDensity" Mode="VariableMode.Compact" IsReadOnly="true" />

    <div class="grid-cell value group-spacer"></div>
    <NewUnifiedVariableRow @bind-Variable="Facade.MassEnthalpy" Mode="VariableMode.Compact" IsReadOnly="true" />
    <NewUnifiedVariableRow @bind-Variable="Facade.MolarEnthalpy" Mode="VariableMode.Compact" IsReadOnly="true" />
    <NewUnifiedVariableRow @bind-Variable="Facade.MassCp" Mode="VariableMode.Compact" IsReadOnly="true" />
    <NewUnifiedVariableRow @bind-Variable="Facade.MolarCp" Mode="VariableMode.Compact" IsReadOnly="true" />

    <div class="grid-cell value group-spacer"></div>
    <NewUnifiedVariableRow @bind-Variable="Facade.Viscosity" Mode="VariableMode.Compact" IsReadOnly="true" />
    <NewUnifiedVariableRow @bind-Variable="Facade.ThermalConductivity" Mode="VariableMode.Compact" IsReadOnly="true" />
    <NewUnifiedVariableRow @bind-Variable="Facade.SuperficialTension" Mode="VariableMode.Compact" IsReadOnly="true" />

</div>

@code {
    [Parameter] public StreamFacade Facade { get; set; } = default!;
    // [Parameter] public List<ThermodynamicMethodFullDto> AvailableMethods { get; set; } = new();
    // 👇 NUEVO: Evento para avisar hacia arriba
    [Parameter] public EventCallback OnStreamUpdated { get; set; }

    // 👇 NUEVO: Dispara el evento
    private async Task NotifyUpdate()
    {
        if (OnStreamUpdated.HasDelegate)
        {
            await OnStreamUpdated.InvokeAsync();
        }
    }
