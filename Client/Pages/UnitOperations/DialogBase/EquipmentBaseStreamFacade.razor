
@* 👇 display: contents hace que este div sea "invisible" para el Grid.
      Sus hijos se convierten en celdas directas de la columna actual. *@
<div style="display: contents;">

  
    <UnifiedNameRow @bind-Value="Facade.Name"
                    IsDuplicate="CheckDuplicateName"
                    OnGenerate="GenerateUniqueStreamName"
                    Mode="VariableMode.Compact" />


    <VariablePercentageRow @bind-Variable="Facade.VaporFraction" @bind-Variable:after="NotifyUpdate" Mode="VariableMode.Compact" />
    @* ==========================================
       VARIABLES CON UNIFIED COMPONENT (Sin Label)
       ========================================== *@
    <VariableAmountRow @bind-Variable="Facade.Temperature" @bind-Variable:after="NotifyUpdate" Mode="VariableMode.Compact" />
    <VariableAmountRow @bind-Variable="Facade.Pressure" @bind-Variable:after="NotifyUpdate" Mode="VariableMode.Compact" />
    <VariableAmountRow @bind-Variable="Facade.MassFlow" @bind-Variable:after="NotifyUpdate" Mode="VariableMode.Compact" />
    <VariableAmountRow @bind-Variable="Facade.MolarFlow" @bind-Variable:after="NotifyUpdate" Mode="VariableMode.Compact" />
    <VariableAmountRow @bind-Variable="Facade.VolumetricFlow" @bind-Variable:after="NotifyUpdate" Mode="VariableMode.Compact" />


    
    <VariableAmountRow @bind-Variable="Facade.EnthalpyFlow" Mode="VariableMode.Compact" IsReadOnly="true" />

    @* 👇 Placeholders para mantener alineación con los títulos de grupo del padre *@
    <div class="grid-cell value group-spacer"></div>
    <VariableUnitLessRow @bind-Variable="Facade.MolecularWeight" Mode="VariableMode.Compact" IsReadOnly="true" />
    <VariableAmountRow @bind-Variable="Facade.MassDensity" Mode="VariableMode.Compact" IsReadOnly="true" />
    <VariableAmountRow @bind-Variable="Facade.MolarDensity" Mode="VariableMode.Compact" IsReadOnly="true" />

    <div class="grid-cell value group-spacer"></div>
    <VariableAmountRow @bind-Variable="Facade.MassEnthalpy" Mode="VariableMode.Compact" IsReadOnly="true" />
    <VariableAmountRow @bind-Variable="Facade.MolarEnthalpy" Mode="VariableMode.Compact" IsReadOnly="true" />
    <VariableAmountRow @bind-Variable="Facade.MassCp" Mode="VariableMode.Compact" IsReadOnly="true" />
    <VariableAmountRow @bind-Variable="Facade.MolarCp" Mode="VariableMode.Compact" IsReadOnly="true" />

    <div class="grid-cell value group-spacer"></div>
    <VariableAmountRow @bind-Variable="Facade.Viscosity" Mode="VariableMode.Compact" IsReadOnly="true" />
    <VariableAmountRow @bind-Variable="Facade.ThermalConductivity" Mode="VariableMode.Compact" IsReadOnly="true" />
    <VariableAmountRow @bind-Variable="Facade.SuperficialTension" Mode="VariableMode.Compact" IsReadOnly="true" />

</div>

@code {
    [Parameter] public IFacadeStream Facade { get; set; } = default!;
    // [Parameter] public List<ThermodynamicMethodFullDto> AvailableMethods { get; set; } = new();
    // 👇 NUEVO: Evento para avisar hacia arriba
    [Parameter] public EventCallback OnStreamUpdated { get; set; }

    // 👇 NUEVO: Dispara el evento
    private async Task NotifyUpdate()
    {
        if (OnStreamUpdated.HasDelegate)
        {
            await OnStreamUpdated.InvokeAsync();
        }
    }

    private bool CheckDuplicateName(string newName)
    {
        return FSM?.Elements?.Any(e => e.Name.Equals(newName, StringComparison.OrdinalIgnoreCase) && e.Id != Facade?.Id) == true;
    }

    /*
    // --- CÓDIGO VIEJO (WM) PARA REFERENCIA ---
    // WM.Elements → FSM.Elements
    */

    private async Task GenerateUniqueStreamName()
    {
        if (FSM == null || Facade == null) return;

        Facade.Name = FSM.GenerateNextName("Stream");
        await NotifyUpdate();
        StateHasChanged();
    }

    /*
    // --- CÓDIGO VIEJO (NamingService) PARA REFERENCIA ---
    // NamingService.GenerateNextName("S") → FSM.GenerateNextName("Stream")
    */
}