<MudDialog Gutters="false" ContentClass="pa-0">
    <DialogContent>
        <CascadingValue Name="IsProjectReadOnly" Value="@(!CanEdit)">
        <div class="equipment-dialog">

            @* ENCABEZADO: Solo usa Equipment.Label *@
            <div class="dialog-header">
                <span class="dialog-title">@Equipment.Label</span>
                <button class="close-button" @onclick="Cancel">✕</button>
            </div>

            @* PESTAÑAS *@
            <div class="tabs-header">
                <div class="tab @(activeTab == "Main" ? "active" : "")" @onclick='() => SetTabAsync("Main")'>Main</div>
                <div class="tab @(activeTab == "Specs" ? "active" : "")" @onclick='() => SetTabAsync("Specs")'>Specs</div>
                @if (ProfilesSlot!=null)
                {
                    <div class="tab @(activeTab == "Profiles" ? "active" : "")" @onclick='() => SetTabAsync("Profiles")'>Profiles</div>
                }
              
                <div class="tab @(activeTab == "Design" ? "active" : "")" @onclick='() => SetTabAsync("Design")'>Design</div>
                <div class="tab @(activeTab == "Streams" ? "active" : "")" @onclick='() => SetTabAsync("Streams")'>Streams</div>
                <div class="tab @(activeTab == "Composition" ? "active" : "")" @onclick='() => SetTabAsync("Composition")'>Composition</div>
            </div>

            @* CONTENIDO DINÁMICO *@
            <div class="tab-content">
                @if (activeTab == "Main")
                {
                    <div class="main-tab-container">

                        @* 1. Topología (Conexiones y Dibujo) *@
                        <div class="main-slot-container">
                            @MainSlot
                        </div>

                        @* 2. Propiedades Operativas Básicas *@
                        @if (PropertiesSlot != null)
                        {
                            <div class="properties-section">
                                <h4 class="properties-title">Operating Parameters</h4>
                                <div class="properties-grid">
                                    @PropertiesSlot
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (activeTab == "Specs")
                {
                    <EquipmentBaseFormulaSpecifications Equipment="Equipment"
                                                        OnSpecificationsChanged="HandleEquipmentUpdate" />
                }
                else if (activeTab == "Design")
                {
                    if(DesignSlot!=null)
                    {
                        @DesignSlot
                    }
                    else
                    {
                        @(DesignSlot ?? (RenderFragment)(b => b.AddContent(0, "Design parameters will be defined after mass balance calculation.")))
                    }
                   
                }
                else if (activeTab == "Streams")
                {
                    <div class="streams-tab-container">
                        <EquipmentBaseStreams Ports="_Ports"
                                              OnEquipmentStreamsUpdated="HandleEquipmentUpdate" />
                    </div>
                }
                else if (activeTab == "Composition")
                {
                    <EquipmentBaseCompositionGrid Ports="_Ports"></EquipmentBaseCompositionGrid>
                }
                else if (activeTab == "Profiles")
                {
                    @if (ProfilesSlot != null)
                    {
                        @ProfilesSlot
                    }
                    else
                    {
                        <div class="empty-state-message">
                            <p>No profiles available for this equipment.</p>
                        </div>
                    }
                }
            </div>

            @* BARRA DE ESTADO: Solo usa Equipment.StatusColor/Text *@
            <div class="status-bar" style="background-color: @Equipment.StatusColor; color: #fff;">
                <span class="status-text">@Equipment.StatusText</span>
            </div>

        </div>
        </CascadingValue>
    </DialogContent>
</MudDialog>

@implements IDisposable
@using Distillator.Domain.Services

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public IVisualElement Equipment { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; } = true;

    [Parameter] public RenderFragment? MainSlot { get; set; }
    [Parameter] public RenderFragment? PropertiesSlot { get; set; }
    [Parameter] public RenderFragment? DesignSlot { get; set; }
    [Parameter] public RenderFragment? ProfilesSlot { get; set; }
    [Parameter] public Func<Task>? OnProfilesTabActivated { get; set; }
    
    private string activeTab = "Main";
    List<EquipmentPort> _Ports => Equipment.Ports;

    protected override void OnInitialized()
    {
        FSM.OnNotifyUI += OnNotifyUIHandler;
    }

    public void Dispose()
    {
        FSM.OnNotifyUI -= OnNotifyUIHandler;
    }

    private void OnNotifyUIHandler()
    {
        RefreshEquipmentFacadeFromWorkspace();
        _ = InvokeAsync(StateHasChanged);
    }

    private void RefreshEquipmentFacadeFromWorkspace()
    {
        var current = FSM.Elements.FirstOrDefault(element => element.Id == Equipment.Id);
        if (current?.Facade == null || Equipment.Facade == null || ReferenceEquals(current.Facade, Equipment.Facade))
        {
            return;
        }

        FacadeStateSerializer.Apply(
            Equipment.Facade,
            FacadeStateSerializer.Serialize(current.Facade, includeTransientState: true),
            restoreProjectDefaultDisplayUnits: true);
    }

    private async Task SetTabAsync(string tabName)
    {
        activeTab = tabName;

        if (tabName == "Profiles" && OnProfilesTabActivated != null)
        {
            await OnProfilesTabActivated();
        }

        StateHasChanged();
    }
    private void Cancel() => MudDialog.Cancel();
    private void HandleEquipmentUpdate()
    {
        FSM.MarkFacadeStateChanged();
        StateHasChanged();
    }
}
