    private void RefreshLists()
    {
        AllStreamNames = FSM.Elements.OfType<StreamVisualElement>().Select(s => s.Label).ToList();
        LocalStreamNames = new List<string>();
        var localPipes = FSM.Pipes.Where(p => p.SourceElementId == Equipment.Id || p.TargetElementId == Equipment.Id);

        foreach (var pipe in localPipes)
        {
            var otherElId = pipe.SourceElementId == Equipment.Id ? pipe.TargetElementId : pipe.SourceElementId;
            var otherEl = FSM.Elements.FirstOrDefault(e => e.Id == otherElId)
                ?? FSM.CurrentProject?.EquipmentRegistry.GetById(otherElId);
            if (otherEl is StreamVisualElement sve) LocalStreamNames.Add(sve.Label);
        }
    }

