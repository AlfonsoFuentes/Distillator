        LocalStreamNames = new List<string>();
        var localPipes = WM.Areas.SelectMany(a => a.Pipes).Where(p => p.SourceElementId == Equipment.Id || p.TargetElementId == Equipment.Id);
        foreach (var pipe in localPipes)
        {
            var otherElId = pipe.SourceElementId == Equipment.Id ? pipe.TargetElementId : pipe.SourceElementId;
