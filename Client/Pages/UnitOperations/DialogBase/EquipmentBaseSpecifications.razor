    */

    private IEnumerable<string> GetAvailableDestinations(string currentSource) => LocalStreamNames.Where(s => !string.Equals(s, currentSource, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<string> GetAvailableSources(string currentDest) => AllStreamNames.Where(s => !string.Equals(s, currentDest, StringComparison.OrdinalIgnoreCase));

    private void AddNewRow()
    {
        RefreshLists();
        Specs.Add(new SpecRowModel { IsEditing = true, IsNew = true });
    }

    private void EditRow(SpecRowModel row)
    {
        RefreshLists();
        row.TempSpecType = row.SpecType;
        row.TempVarType = row.VarType;
        row.TempDest = row.DestinationName;
        row.TempSource = row.SourceName;
        row.TempComponentId = row.ComponentId;
        row.TempValue = row.Value;
        row.IsEditing = true;
    }

    private async Task SaveRow(SpecRowModel row)
    {
        if (string.IsNullOrWhiteSpace(row.TempDest) || string.IsNullOrWhiteSpace(row.TempSource)) return;

        var solverEq = Equipment.Facade as SolverEquipmentBase;
        if (solverEq == null) return;

        var sourceStream = FindStream(row.TempSource);
        var destStream = FindStream(row.TempDest);

        if (sourceStream == null || destStream == null) return;
        if (IsComponentSpecification(row.TempSpecType)
            && !GetCommonComponents(sourceStream, destStream).Any(component => component.Id == row.TempComponentId)) return;

        if (!row.IsNew && row.BackendSpec != null) { solverEq.RemoveSpec(row.BackendSpec); }

        ISpecification newSpec;

        // 🔥 Fábrica Dinámica (Factory): Instancia la clase correcta según el Enum
        switch (row.TempSpecType)
        {
            case SpecificationType.Multiplier:
                newSpec = new MultiplierSpecification
                {
                    Source = sourceStream,
                    Destination = destStream,
                    VariableType = row.TempVarType, // Ahora toma la variable del UI!
                    Multiplier = row.TempValue
                };
                break;
            case SpecificationType.ComponentMassFlowMultiplier:
                newSpec = new ComponentMassFlowMultiplierSpecification
                {
                    Source = sourceStream,
                    Destination = destStream,
                    ComponentId = row.TempComponentId,
                    Recovery = new Percentage(row.TempValue, PercentageUnits.Percentage)
                };
                break;
            default:
                throw new InvalidOperationException($"Tipo no soportado: {row.TempSpecType}");
        }

        solverEq.AddSpec(newSpec);

        row.SpecType = row.TempSpecType;
        row.VarType = row.TempVarType;
        row.DestinationName = row.TempDest;
        row.SourceName = row.TempSource;
        row.ComponentId = IsComponentSpecification(row.TempSpecType) ? row.TempComponentId : Guid.Empty;
        row.ComponentName = GetCommonComponents(sourceStream, destStream)
            .FirstOrDefault(component => component.Id == row.ComponentId)?.Name;
        row.Value = row.TempValue;
        row.BackendSpec = newSpec;
        row.IsEditing = false; row.IsNew = false;

        if (OnSpecificationsChanged.HasDelegate) await OnSpecificationsChanged.InvokeAsync();
        FSM.RunSimulation();
    }

    /*
    // --- CÓDIGO VIEJO (WM) PARA REFERENCIA ---
    // WM.RunSimulation() en SaveRow → FSM.RunSimulation()
    */

    private void CancelEdit(SpecRowModel row) { if (row.IsNew) Specs.Remove(row); else row.IsEditing = false; }

    private async Task DeleteRow(SpecRowModel row)
    {
        Specs.Remove(row);
        var solverEq = Equipment.Facade as SolverEquipmentBase;
        if (solverEq != null && row.BackendSpec != null) { solverEq.RemoveSpec(row.BackendSpec); }
        if (OnSpecificationsChanged.HasDelegate) await OnSpecificationsChanged.InvokeAsync();
        FSM.RunSimulation();
    }

    private IFacadeStream? FindStream(string streamName) =>
        FSM.Elements.OfType<StreamVisualElement>()
            .FirstOrDefault(stream => string.Equals(stream.Label, streamName, StringComparison.OrdinalIgnoreCase))?.Facade
            as IFacadeStream;

    private IEnumerable<ComponentFacade> GetCommonComponents(string sourceName, string destinationName)
    {
        var source = FindStream(sourceName);
        var destination = FindStream(destinationName);
        return source == null || destination == null
            ? Enumerable.Empty<ComponentFacade>()
            : GetCommonComponents(source, destination);
    }

    private static IEnumerable<ComponentFacade> GetCommonComponents(
        IFacadeStream source,
        IFacadeStream destination)
    {
        var destinationComponentIds = destination.Composition.Components
            .Select(component => component.Id)
            .ToHashSet();

        return source.Composition.Components
            .Where(component => destinationComponentIds.Contains(component.Id))
            .OrderBy(component => component.Name);
    }

    private static bool IsComponentSpecification(SpecificationType type) =>
        type == SpecificationType.ComponentMassFlowMultiplier;

    private static string GetSpecificationTypeLabel(SpecificationType type) => type switch
    {
        SpecificationType.Multiplier => "Flow Multiplier",
        SpecificationType.ComponentMassFlowMultiplier => "Component Recovery",
        _ => type.ToString()
    };
}
