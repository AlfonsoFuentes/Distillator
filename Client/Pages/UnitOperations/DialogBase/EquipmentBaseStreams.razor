<div class="scrollable-container">
    <div class="data-grid equipment-streams-grid">
        
        @* ==========================================
           COLUMNA 1: ETIQUETAS (LABELS FIJOS)
           ========================================== *@
        <div class="grid-header header-corner"></div>
        
        <div class="grid-cell label fixed-col">Stream Name</div>
        <div class="grid-cell label fixed-col">Thermodynamic Method</div>
        <div class="grid-cell label fixed-col">Vapor Fraction</div>
        <div class="grid-cell label fixed-col">Temperature</div>
        <div class="grid-cell label fixed-col">Pressure</div>
        <div class="grid-cell label fixed-col">Mass Flow</div>
        <div class="grid-cell label fixed-col">Molar Flow</div>
        <div class="grid-cell label fixed-col">Volumetric Flow</div>
        <div class="grid-cell label fixed-col">Heat Flow</div>
        
        <div class="grid-cell label group-title fixed-col">Phase & Density</div>
        <div class="grid-cell label fixed-col">Mass Density</div>
        <div class="grid-cell label fixed-col">Molar Density</div>
        
        <div class="grid-cell label group-title fixed-col">Thermodynamics</div>
        <div class="grid-cell label fixed-col">Mass Enthalpy</div>
        <div class="grid-cell label fixed-col">Molar Enthalpy</div>
        <div class="grid-cell label fixed-col">Mass Cp</div>
        <div class="grid-cell label fixed-col">Molar Cp</div>
        
        <div class="grid-cell label group-title fixed-col">Transport</div>
        <div class="grid-cell label fixed-col">Viscosity</div>
        <div class="grid-cell label fixed-col">Thermal Conductivity</div>
        <div class="grid-cell label fixed-col">Superficial Tension</div>

        @* ==========================================
           COLUMNAS 2+: PUERTOS / CORRIENTES
           ========================================== *@
        @foreach (var port in Ports)
        {
            <div class="grid-header port-header" title="@port.Name">@port.Name</div>

            var facade = GetFacadeForPort(port);
            @if (facade != null)
            {
                <EquipmentBaseStreamFacade Facade="facade" AvailableMethods="AvailableMethods" />
            }
            else
            {
                @for (int i = 0; i < 21; i++)
                {
                    <div class="empty-port-column"></div>
                }
            }
        }

        @* ==========================================
           COLUMNA FINAL: RELLENO VISUAL (FILLER)
           ========================================== *@
        <div class="grid-header filler"></div>
        
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        
        <div class="grid-cell filler group-title"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        
        <div class="grid-cell filler group-title"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        
        <div class="grid-cell filler group-title"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
        <div class="grid-cell filler"></div>
    </div>
</div>

@code {
    [Parameter] public List<EquipmentPort> Ports { get; set; } = new();
    [Parameter] public List<ThermodynamicMethodFullDto> AvailableMethods { get; set; } = new();
    


   
    private StreamSimulationFacade? GetFacadeForPort(EquipmentPort port)
    {
        if (!port.ConnectedElementId.HasValue) return null;

        Guid connectedId = port.ConnectedElementId.Value;
        IVisualElement? connectedElement = null;

        // 🔍 1. ¿El ID es una Tubería (Pipe) en CUALQUIER área?
        var pipe = WM.Areas.SelectMany(a => a.Pipes).FirstOrDefault(x => x.Id == connectedId);
        if (pipe != null)
        {
            // Si la tubería toca una corriente directamente, retornamos su Facade
            if (pipe.SourceElement?.Facade is StreamSimulationFacade sf) return sf;
            if (pipe.TargetElement?.Facade is StreamSimulationFacade tf) return tf;

            // Si la tubería toca un OPC, guardamos el OPC para el Paso 3
            if (pipe.SourceElement is OffPageConnectorElement) connectedElement = pipe.SourceElement;
            else if (pipe.TargetElement is OffPageConnectorElement) connectedElement = pipe.TargetElement;
        }

        // 🔍 2. Si no era tubería, ¿El ID es DIRECTAMENTE un Equipo/Corriente/OPC en CUALQUIER área?
        if (connectedElement == null)
        {
            connectedElement = WM.Areas.SelectMany(a => a.Elements).FirstOrDefault(x => x.Id == connectedId);
        }

        // 🚀 3. EVALUACIÓN FINAL Y AGUJERO DE GUSANO
        if (connectedElement != null)
        {
            // Caso A: Es directamente una corriente (Misma área)
            if (connectedElement.Facade is StreamSimulationFacade directFacade)
            {
                return directFacade;
            }

            // Caso B: Es un OPC -> ¡Viajamos a la otra área!
            if (connectedElement is OffPageConnectorElement opc)
            {
                var targetArea = WM.Areas.FirstOrDefault(a => a.Id == opc.TargetAreaId);
                if (targetArea != null)
                {
                    // Buscamos la bandera gemela
                    var twinOpc = targetArea.Elements.OfType<OffPageConnectorElement>().FirstOrDefault(e => e.Id == opc.TargetConnectorId);
                    if (twinOpc != null)
                    {
                        // Buscamos el tubo conectado a esa bandera
                        var twinPipe = targetArea.Pipes.FirstOrDefault(p => p.SourceElementId == twinOpc.Id || p.TargetElementId == twinOpc.Id);
                        if (twinPipe != null)
                        {
                            // Encontramos la corriente real
                            var realStreamId = twinPipe.SourceElementId == twinOpc.Id ? twinPipe.TargetElementId : twinPipe.SourceElementId;
                            var realStream = targetArea.Elements.FirstOrDefault(e => e.Id == realStreamId);
                        
                            // Retornamos el Facade de esa corriente remota
                            if (realStream?.Facade is StreamSimulationFacade wormholeFacade)
                            {
                                return wormholeFacade;
                            }
                        }
                    }
                }
            }
        }

        return null;
    }
}