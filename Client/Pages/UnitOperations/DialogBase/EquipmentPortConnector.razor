@using System.Globalization
@using Shared.ProcessFlowDiagram.Pipes

<div class="port-connector-container material-theme">
    
    <div class="connector-header">
        <label class="port-label">@Port.Name</label>
        @if (Port.ConnectedElementId.HasValue)
        {
            <span class="status-badge connected">Connected</span>
        }
    </div>

    <div class="input-group">
        <input type="text"
               class="port-input"
               list="@($"list-{Port.Id}")"
               placeholder="Select or type name..."
               value="@_inputValue"
               @oninput="@(e => _inputValue = e.Value?.ToString() ?? string.Empty)"
               @onchange="HandleListSelection" />

        <datalist id="@($"list-{Port.Id}")">
            @foreach (var stream in GetAvailableStreams())
            {
                <option value="@stream.Label">@stream.Label</option>
            }
        </datalist>

        @* MÁQUINA DE ESTADOS DEL BOTÓN LATERAL *@
        <div class="btn-tooltip-container">
            
            @if (Port.ConnectedElementId.HasValue)
            {
                // ESTADO 3: CONECTADO -> Mostrar botón de desconectar
                <button type="button"
                        class="action-btn disconnect-btn"
                        @onclick="DisconnectCurrent">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
                <span class="port-tooltip-fixed">Disconnect stream</span>
            }
            else if (!string.IsNullOrWhiteSpace(_inputValue))
            {
                // ESTADO 2: ESCRIBIENDO -> Mostrar botón de confirmar
                <button type="button"
                        class="action-btn confirm-btn"
                        @onclick="HandleConfirmClick">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </button>
                <span class="port-tooltip-fixed">Confirm & Connect</span>
            }
            else
            {
                // ESTADO 1: VACÍO -> Mostrar botón de autogenerar
                <button type="button"
                        class="action-btn generate-btn"
                        @onclick="HandleAutoGenerate">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>
                <span class="port-tooltip-fixed">Generate unique stream</span>
            }
        </div>
    </div>
</div>

@code {

    
    [Parameter, EditorRequired] public EquipmentPort Port { get; set; } = default!;
    [Parameter, EditorRequired] public IVisualElement ParentEquipment { get; set; } = default!;
    [Parameter] public EventCallback OnConnectionChanged { get; set; }
    private string _inputValue = string.Empty;

    protected override void OnParametersSet()
    {
        var connectedStream = GetConnectedStream();
        _inputValue = connectedStream?.Label ?? string.Empty;
    }
    private IVisualElement? GetConnectedStream()
    {
        if (!Port.ConnectedElementId.HasValue) return null;
    
        // 1. Buscamos el tubo local
        var pipe = WM.Pipes.FirstOrDefault(p =>
            (p.SourceElementId == ParentEquipment.Id && p.SourcePortName == Port.Name) ||
            (p.TargetElementId == ParentEquipment.Id && p.TargetPortName == Port.Name));

        if (pipe == null) return null;

        var connectedElementId = pipe.SourceElementId == ParentEquipment.Id ? pipe.TargetElementId : pipe.SourceElementId;
    
        // Buscamos a quién está conectado localmente
        var connectedElement = WM.Areas.SelectMany(a => a.Elements).FirstOrDefault(x => x.Id == connectedElementId);

        // 🚩 LA MAGIA: ¿Es un Portal (OPC)?
        if (connectedElement is OffPageConnectorElement opc)
        {
            // 1. Viajamos al área destino
            var targetArea = WM.Areas.FirstOrDefault(a => a.Id == opc.TargetAreaId);
            if (targetArea != null)
            {
                // 2. Buscamos la bandera gemela
                var twinOpc = targetArea.Elements.OfType<OffPageConnectorElement>().FirstOrDefault(e => e.Id == opc.TargetConnectorId);
                if (twinOpc != null)
                {
                    // 3. Buscamos el tubo remoto conectado a esa bandera
                    var twinPipe = targetArea.Pipes.FirstOrDefault(p => p.SourceElementId == twinOpc.Id || p.TargetElementId == twinOpc.Id);
                    if (twinPipe != null)
                    {
                        // 4. ¡Atrapamos a la verdadera corriente!
                        var realStreamId = twinPipe.SourceElementId == twinOpc.Id ? twinPipe.TargetElementId : twinPipe.SourceElementId;
                        return targetArea.Elements.FirstOrDefault(e => e.Id == realStreamId);
                    }
                }
            }
        }

        // Si no era un OPC, devolvemos la corriente normal (como pasa con la P-102)
        return connectedElement;
    }
    

    private IEnumerable<IVisualElement> GetAvailableStreams()
    {
        // 🚩 Busca corrientes disponibles en TODAS las áreas
        var allStreams = WM.Areas.SelectMany(a => a.Elements).OfType<StreamVisualElement>().ToList();
        var allPipes = WM.Areas.SelectMany(a => a.Pipes).ToList();

        if (Port.Type == PortType.Inlet)
            return allStreams.Where(s => !allPipes.Any(p => p.SourceElementId == s.Id));
        else
            return allStreams.Where(s => !allPipes.Any(p => p.TargetElementId == s.Id));
    }

    private async Task HandleListSelection(ChangeEventArgs e)
    {
        var selectedValue = e.Value?.ToString() ?? string.Empty;
        _inputValue = selectedValue;

        if (!string.IsNullOrWhiteSpace(selectedValue))
        {
            var available = GetAvailableStreams();
            if (available.Any(s => string.Equals(s.Label, selectedValue, StringComparison.OrdinalIgnoreCase)))
            {
                await ProcessConnectionRequest(selectedValue);
            }
        }
    }

    private async Task HandleConfirmClick()
    {
        await ProcessConnectionRequest(_inputValue);
    }

    private async Task HandleAutoGenerate()
    {
        string prefix = "S";
        string suggestedName = NamingService.GenerateNextName(prefix);
        
        // 🚩 Asegura que el nombre no se repita en NINGUNA área
        while (WM.Areas.SelectMany(a => a.Elements).Any(el => string.Equals(el.Name, suggestedName, StringComparison.OrdinalIgnoreCase)))
        {
            suggestedName = NamingService.GenerateNextName(prefix);
        }

        _inputValue = suggestedName;
        await ProcessConnectionRequest(suggestedName);
    }

    private async Task ProcessConnectionRequest(string streamName)
    {
        if (string.IsNullOrWhiteSpace(streamName))
        {
            await DisconnectCurrent();
            return;
        }

        var currentConnected = GetConnectedStream();
        if (currentConnected != null && string.Equals(currentConnected.Label, streamName, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // 🚩 BÚSQUEDA INTER-ÁREA
        StreamVisualElement? existingStream = null;
        DiagramArea? streamArea = null;

        foreach (var area in WM.Areas)
        {
            existingStream = area.Elements.OfType<StreamVisualElement>()
                                .FirstOrDefault(x => string.Equals(x.Label, streamName, StringComparison.OrdinalIgnoreCase));
            if (existingStream != null)
            {
                streamArea = area;
                break;
            }
        }

        if (existingStream != null && streamArea != null)
        {
            if (streamArea.Id != WM.ActiveArea.Id)
            {
                // ¡MAGIA! La corriente está en otra área, creamos portales OPC
                WM.CreateInterAreaConnection(ParentEquipment, Port.Name, existingStream, streamArea);
                _inputValue = existingStream.Label;
            }
            else
            {
                // Está en esta misma área, conexión normal
               await CreatePipeAndConnect(existingStream);
            }
        }
        else
        {
            // No existe en ningún lado, crear espacialmente en el área actual
          await  CreateSpatiallyAndConnect(streamName);
        }
    }

    private async Task CreateSpatiallyAndConnect(string newStreamName)
    {
        var absCoords = ParentEquipment.GetAbsolutePortCoordinates(Port.Name);
        double dx = 0, dy = 0;
        double spawnDistance = 80;

        switch (Port.Direction)
        {
            case PortDirection.Top: dy = -spawnDistance; break;
            case PortDirection.Bottom: dy = spawnDistance; break;
            case PortDirection.Left: dx = -spawnDistance; break;
            case PortDirection.Right: dx = spawnDistance; break;
        }

        var newStream = WM.CreateStreamProgrammatically(newStreamName);
        if (newStream == null) return;
        bool isInlet = Port.Type == PortType.Inlet;

        if (Port.Direction == PortDirection.Left || Port.Direction == PortDirection.Right)
            newStream.RotationAngle = (Port.Direction == PortDirection.Left) ? (isInlet ? 0 : 180) : (isInlet ? 180 : 0);
        else
            newStream.RotationAngle = (Port.Direction == PortDirection.Top) ? (isInlet ? 90 : 270) : (isInlet ? 270 : 90);

        string streamPortName = isInlet ? "Outlet" : "Inlet";
        var (sOffsetX, sOffsetY, _) = newStream.GetTransformedPort(streamPortName);

        newStream.X = (absCoords.X + dx) - sOffsetX;
        newStream.Y = (absCoords.Y + dy) - sOffsetY;

      
      await  CreatePipeAndConnect(newStream);
        WM.NotifyStateChanged();
    }

    private async Task CreatePipeAndConnect(IVisualElement stream)
    {
        if (Port.ConnectedElementId.HasValue) _ = DisconnectCurrent();

        string streamPortName = (Port.Type == PortType.Inlet) ? "Outlet" : "Inlet";
        ParentEquipment.Connect(Port.Name, stream, streamPortName);

        var pipe = new PipeVisualElement { Id = Guid.NewGuid(), Label = stream.Label, ShowTechnicalLabel = false };

        if (Port.Type == PortType.Inlet)
        {
            pipe.SourceElementId = stream.Id; pipe.SourcePortName = streamPortName; pipe.SourceElement = stream;
            pipe.TargetElementId = ParentEquipment.Id; pipe.TargetPortName = Port.Name; pipe.TargetElement = ParentEquipment;
        }
        else
        {
            pipe.SourceElementId = ParentEquipment.Id; pipe.SourcePortName = Port.Name; pipe.SourceElement = ParentEquipment;
            pipe.TargetElementId = stream.Id; pipe.TargetPortName = streamPortName; pipe.TargetElement = stream;
        }

        WM.Pipes.Add(pipe);
        if (OnConnectionChanged.HasDelegate)
        {
            await OnConnectionChanged.InvokeAsync();
        }
    }

    private async Task DisconnectCurrent()
    {
        if (!Port.ConnectedElementId.HasValue) return;

        var pipe = WM.Pipes.FirstOrDefault(p =>
            (p.SourceElementId == ParentEquipment.Id && p.SourcePortName == Port.Name) ||
            (p.TargetElementId == ParentEquipment.Id && p.TargetPortName == Port.Name));
        
        if (pipe != null) WM.Pipes.Remove(pipe);

        ParentEquipment.Disconnect(Port.Name);
        
        if (pipe != null)
        {
            var otherEl = pipe.SourceElementId == ParentEquipment.Id ? pipe.TargetElement : pipe.SourceElement;
            var otherPortName = pipe.SourceElementId == ParentEquipment.Id ? pipe.TargetPortName : pipe.SourcePortName;
            otherEl?.Disconnect(otherPortName);
        }

        _inputValue = string.Empty;

        if (OnConnectionChanged.HasDelegate)
        {
            await OnConnectionChanged.InvokeAsync();
        }
    }
}