<div class="scrollable-container">
    <div class="data-grid composition-grid" style="grid-template-columns: 140px 160px repeat(@Ports.Count, minmax(140px, 1fr)) minmax(20px, 1fr);">
        
        @* ==========================================
           FILA 1: ENCABEZADOS FIJOS
           ========================================== *@
        <div class="grid-header sticky-col-1 sticky-header">Component</div>
        <div class="grid-header sticky-col-2 sticky-header">Property</div>
        
        @foreach (var port in Ports)
        {
            <div class="grid-header port-header" title="@port.Name">@port.Name</div>
        }
        <div class="grid-header filler sticky-header-filler"></div>

        @* ==========================================
           FILAS DE DATOS POR COMPONENTE
           ========================================== *@
        @foreach (var compName in GetDistinctComponents())
        {
            bool isEthanol = compName.Equals("Ethanol", StringComparison.OrdinalIgnoreCase);
            int rowSpan = isEthanol ? 6 : 5;

            <div class="grid-cell component-name sticky-col-1" style="grid-row: span @rowSpan;">
                @compName
            </div>

            @* --- FILA 1: MASS (%) --- *@
            <div class="grid-cell label sticky-col-2">Mass (%)</div>
            @foreach (var port in Ports)
            {
                var facade = GetFacadeForPort(port);
                var comp = facade != null ? GetComponent(facade, compName) : null;
                
                if (facade == null || comp == null)
                {
                    <div class="grid-cell empty-port-column"></div>
                }
                else
                {
                    <div class="grid-cell value editable-cell" data-state="@GetCellState(facade, comp, true)" title="@GetCellTooltip(facade, comp, true)">
                        @if (IsCellReadOnly(facade, comp, true))
                        {
                            <span class="readonly-value">@FormatFraction(comp.MassFraction)</span>
                        }
                        else
                        {
                            <input type="number" step="0.01" min="0" max="100"
                                   value="@GetInputValue(facade, comp, true)"
                                   placeholder="<Not defined>"
                                   @onfocus="@(e => HandleFocus(facade, comp, true, false))"
                                   @oninput="@(e => HandleInput(e))"
                                   @onkeydown="@(e => HandleKeyDown(e, facade, comp, true, false))"
                                   @onblur="@(e => HandleBlur(facade, comp, true, false))" />
                        }
                    </div>
                }
            }
            <div class="grid-cell filler"></div>

            @* --- FILA 2: MOLE (%) --- *@
            <div class="grid-cell label sticky-col-2">Mole (%)</div>
            @foreach (var port in Ports)
            {
                var facade = GetFacadeForPort(port);
                var comp = facade != null ? GetComponent(facade, compName) : null;
                
                if (facade == null || comp == null)
                {
                    <div class="grid-cell empty-port-column"></div>
                }
                else
                {
                    <div class="grid-cell value editable-cell" data-state="@GetCellState(facade, comp, false)" title="@GetCellTooltip(facade, comp, false)">
                        @if (IsCellReadOnly(facade, comp, false))
                        {
                            <span class="readonly-value">@FormatFraction(comp.MolarFraction)</span>
                        }
                        else
                        {
                            <input type="number" step="0.01" min="0" max="100"
                                   value="@GetInputValue(facade, comp, false)"
                                   placeholder="<Not defined>"
                                   @onfocus="@(e => HandleFocus(facade, comp, false, false))"
                                   @oninput="@(e => HandleInput(e))"
                                   @onkeydown="@(e => HandleKeyDown(e, facade, comp, false, false))"
                                   @onblur="@(e => HandleBlur(facade, comp, false, false))" />
                        }
                    </div>
                }
            }
            <div class="grid-cell filler"></div>

            @* --- FILA 3: MOLAR FLOW --- *@
            <div class="grid-cell label sticky-col-2">Molar Flow</div>
            @foreach (var port in Ports)
            {
                var comp = GetFacadeForPort(port) != null ? GetComponent(GetFacadeForPort(port)!, compName) : null;
                <div class="grid-cell value calculated">
                    <span class="readonly-value">@(comp?.MolarFlowValue?.Value != null ? comp.MolarFlowValue.Value.ToString("F4") : "-")</span>
                </div>
            }
            <div class="grid-cell filler"></div>

            @* --- FILA 4: MASS FLOW --- *@
            <div class="grid-cell label sticky-col-2">Mass Flow</div>
            @foreach (var port in Ports)
            {
                var comp = GetFacadeForPort(port) != null ? GetComponent(GetFacadeForPort(port)!, compName) : null;
                <div class="grid-cell value calculated">
                    <span class="readonly-value">@(comp?.MassFlowValue?.Value != null ? comp.MassFlowValue.Value.ToString("F4") : "-")</span>
                </div>
            }
            <div class="grid-cell filler"></div>

            @* --- FILA 5: VOLUMETRIC FLOW --- *@
            <div class="grid-cell label sticky-col-2">Vol. Flow</div>
            @foreach (var port in Ports)
            {
                var comp = GetFacadeForPort(port) != null ? GetComponent(GetFacadeForPort(port)!, compName) : null;
                <div class="grid-cell value calculated">
                    <span class="readonly-value">@(comp?.VolumetricFlowValue?.Value != null ? comp.VolumetricFlowValue.Value.ToString("F4") : "-")</span>
                </div>
            }
            <div class="grid-cell filler"></div>

            @* --- FILA 6: °GL (SOLO ETANOL) --- *@
            @if (isEthanol)
            {
                <div class="grid-cell label special-gl sticky-col-2">Gay-Lussac (°GL)</div>
                @foreach (var port in Ports)
                {
                    var facade = GetFacadeForPort(port);
                    var comp = facade != null ? GetComponent(facade, compName) : null;
                    
                    if (facade == null || facade.StreamComposition?.Value?.IsEthanolWaterMixture() != true)
                    {
                        <div class="grid-cell empty-port-column"></div>
                    }
                    else if (comp == null)
                    {
                        <div class="grid-cell value empty"><span class="readonly-value">0.0</span></div>
                    }
                    else
                    {
                        bool isGLReadOnly = IsGLReadOnly(facade);
                        <div class="grid-cell value editable-cell special-gl-value" data-state="@(isGLReadOnly ? "calculated" : "editable")">
                            @if (isGLReadOnly)
                            {
                                double? currentGL = comp.MassFraction.HasValue ? GetGLEtanol(comp.MassFraction.Value) : null;
                                <span class="readonly-value">@(currentGL.HasValue ? currentGL.Value.ToString("F1") : "<Not defined>")</span>
                            }
                            else
                            {
                                <input type="number" step="0.1" min="0" max="100"
                                       value="@GetGlInputValue(facade, comp)"
                                       placeholder="<Not defined>"
                                       @onfocus="@(e => HandleFocus(facade, comp, true, true))"
                                       @oninput="@(e => HandleInput(e))"
                                       @onkeydown="@(e => HandleKeyDown(e, facade, comp, true, true))"
                                       @onblur="@(e => HandleBlur(facade, comp, true, true))" />
                            }
                        </div>
                    }
                }
                <div class="grid-cell filler"></div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public List<EquipmentPort> Ports { get; set; } = new();
    [Parameter] public EventCallback OnEquipmentUpdated { get; set; }
    
    // NOTA: WorkspaceManager está inyectado globalmente vía _Imports.razor

    // ─────────────────────────────────────────────────────────
    // 🔹 VARIABLES DE ESTADO DE EDICIÓN
    // ─────────────────────────────────────────────────────────
    private StreamSimulationFacade? _editingFacade;
    private ComponentComposition? _editingComponent;
    private bool _isEditingMass;
    private bool _isEditingMolar;
    private bool _isEditingGL;
    private double? _tempInputValue;

    // ─────────────────────────────────────────────────────────
    // 🔹 MANEJO DE ESTADOS (STATE MACHINE)
    // ─────────────────────────────────────────────────────────
    private string GetCellState(StreamSimulationFacade facade, ComponentComposition comp, bool isMass)
    {
        var variable = facade.StreamComposition;
        if (variable == null) return "empty";
        if (variable.Source == MethodSource.Other) return "calculated";

        var hasValue = isMass ? comp.MassFraction.HasValue : comp.MolarFraction.HasValue;
        var inputType = variable.Value!.InputType;

        if (inputType == ComponentInputType.None) return hasValue ? "editable" : "empty";

        if (inputType == ComponentInputType.MassFraction)
            return isMass ? (hasValue ? "editable" : "empty") : (hasValue ? "calculated" : "blocked");

        if (inputType == ComponentInputType.MolarFraction)
            return !isMass ? (hasValue ? "editable" : "empty") : (hasValue ? "calculated" : "blocked");

        return "empty";
    }

    private bool IsCellReadOnly(StreamSimulationFacade facade, ComponentComposition comp, bool isMass)
    {
        var state = GetCellState(facade, comp, isMass);
        return state == "calculated" || state == "blocked";
    }

    private bool IsGLReadOnly(StreamSimulationFacade facade)
    {
        var variable = facade.StreamComposition;
        if (variable == null) return true;
        return variable.Source == MethodSource.Other || variable.Value!.InputType == ComponentInputType.MolarFraction;
    }

    private string? GetCellTooltip(StreamSimulationFacade facade, ComponentComposition comp, bool isMass)
    {
        var state = GetCellState(facade, comp, isMass);
        var variable = facade.StreamComposition;
        if (state == "calculated" && variable?.SourceId != null) return $"Calculated by: {variable.SourceId}";
        if (state == "calculated") return "Calculated from mixture";
        if (state == "blocked") return "Blocked: Define via " + (isMass ? "Mole %" : "Mass %");
        return null;
    }

    private string FormatFraction(double? fraction)
    {
        if (!fraction.HasValue) return "";
        var val = fraction.Value;
        return val == 0 ? "0.00" : (Math.Abs(val) >= 1.0 ? val.ToString("F2") : val.ToString("F6").TrimEnd('0').TrimEnd('.'));
    }

    private string GetInputValue(StreamSimulationFacade facade, ComponentComposition comp, bool isMass)
    {
        bool isEditingThis = _editingFacade == facade && _editingComponent == comp && ((isMass && _isEditingMass) || (!isMass && _isEditingMolar));
        if (isEditingThis && _tempInputValue.HasValue)
            return _tempInputValue.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);

        var val = isMass ? comp.MassFraction : comp.MolarFraction;
        if (!val.HasValue) return "";
        
        double v = val.Value;
        if (v == 0) return "0";
        
        return Math.Abs(v) >= 1.0
            ? v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
            : v.ToString("F6", System.Globalization.CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.');
    }

    private string GetGlInputValue(StreamSimulationFacade facade, ComponentComposition comp)
    {
        bool isEditingThis = _editingFacade == facade && _editingComponent == comp && _isEditingGL;
        if (isEditingThis && _tempInputValue.HasValue)
            return _tempInputValue.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);

        double? val = comp.MassFraction.HasValue ? GetGLEtanol(comp.MassFraction.Value) : null;
        
        return val.HasValue ? val.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) : "";
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 HANDLERS DE EVENTOS
    // ─────────────────────────────────────────────────────────
    private void HandleFocus(StreamSimulationFacade facade, ComponentComposition comp, bool isMass, bool isGL)
    {
        if (!isGL && IsCellReadOnly(facade, comp, isMass)) return;
        if (isGL && IsGLReadOnly(facade)) return;

        _editingFacade = facade;
        _editingComponent = comp;
        _isEditingGL = isGL;
        _isEditingMass = !isGL && isMass;
        _isEditingMolar = !isGL && !isMass;

        if (isGL)
            _tempInputValue = comp.MassFraction.HasValue ? GetGLEtanol(comp.MassFraction.Value) : null;
        else
            _tempInputValue = isMass ? comp.MassFraction : comp.MolarFraction;
    }

    private void HandleInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var value))
            _tempInputValue = value;
        else
            _tempInputValue = null;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e, StreamSimulationFacade facade, ComponentComposition comp, bool isMass, bool isGL)
    {
        if (e.Key == "Enter") await CommitValue(facade, comp, isMass, isGL);
        else if (e.Key == "Delete" || e.Key == "Backspace") await ClearCell(facade, comp);
    }

    private async Task HandleBlur(StreamSimulationFacade facade, ComponentComposition comp, bool isMass, bool isGL)
    {
        if (_tempInputValue.HasValue || (isMass ? comp.MassFraction.HasValue : comp.MolarFraction.HasValue))
            await CommitValue(facade, comp, isMass, isGL);
        else
            await ClearCell(facade, comp);
    }

    private async Task CommitValue(StreamSimulationFacade facade, ComponentComposition comp, bool isMass, bool isGL)
    {
        if (!_tempInputValue.HasValue) return;
        var variable = facade.StreamComposition;
        if (variable == null) return;

        if (isGL)
        {
            var massFraction = CalcularMasicoDesdeGL(_tempInputValue.Value);
            var water = variable.Value!.Components.FirstOrDefault(c => c.ComponentName.Equals("Water", StringComparison.OrdinalIgnoreCase));
            if (water != null)
            {
                comp.MassFraction = massFraction;
                water.MassFraction = 100 - massFraction;
                variable.Value.InputType = ComponentInputType.MassFraction;
            }
        }
        else
        {
            if (isMass) comp.MassFraction = _tempInputValue;
            else comp.MolarFraction = _tempInputValue;
            variable.Value!.InputType = isMass ? ComponentInputType.MassFraction : ComponentInputType.MolarFraction;
        }

        if (variable.Value.InputType == ComponentInputType.MassFraction)
            variable.Value.CalculateMolarFractionsFromMass();
        else
            variable.Value.CalculateMassFractionsFromMolar();

        variable.SetValue(variable.Value, MethodSource.UserInterface);
        ResetEditingState();
        if (OnEquipmentUpdated.HasDelegate) await OnEquipmentUpdated.InvokeAsync();
    }

    private async Task ClearCell(StreamSimulationFacade facade, ComponentComposition comp)
    {
        var variable = facade.StreamComposition;
        if (variable == null) return;

        if (variable.Value!.IsEthanolWaterMixture())
        {
            foreach (var c in variable.Value.Components) { c.MassFraction = null; c.MolarFraction = null; }
        }
        else
        {
            comp.MassFraction = null;
            comp.MolarFraction = null;
        }

        if (variable.Value.Components.All(c => !c.MassFraction.HasValue && !c.MolarFraction.HasValue))
            variable.Value.InputType = ComponentInputType.None;

        ResetEditingState();
        variable.ClearValue();
        if (OnEquipmentUpdated.HasDelegate) await OnEquipmentUpdated.InvokeAsync();
    }

    private void ResetEditingState()
    {
        _editingFacade = null; _editingComponent = null; _isEditingMass = false; _isEditingMolar = false; _isEditingGL = false; _tempInputValue = null;
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 LÓGICA DE EXTRACCIÓN Y TERMODINÁMICA
    // ─────────────────────────────────────────────────────────
    // ─────────────────────────────────────────────────────────
    // 🔹 LÓGICA DE EXTRACCIÓN Y TERMODINÁMICA (CON WORMHOLE)
    // ─────────────────────────────────────────────────────────
    private StreamSimulationFacade? GetFacadeForPort(EquipmentPort port)
    {
        if (!port.ConnectedElementId.HasValue) return null;

        Guid connectedId = port.ConnectedElementId.Value;
        IVisualElement? connectedElement = null;

        // 🔍 1. ¿El ID es una Tubería (Pipe) en CUALQUIER área?
        var pipe = WM.Areas.SelectMany(a => a.Pipes).FirstOrDefault(x => x.Id == connectedId);
        if (pipe != null)
        {
            if (pipe.SourceElement?.Facade is StreamSimulationFacade sf) return sf;
            if (pipe.TargetElement?.Facade is StreamSimulationFacade tf) return tf;

            // Si es un OPC, lo guardamos para el paso 3
            if (pipe.SourceElement is OffPageConnectorElement) connectedElement = pipe.SourceElement;
            else if (pipe.TargetElement is OffPageConnectorElement) connectedElement = pipe.TargetElement;
        }

        // 🔍 2. Si no era tubería, ¿El ID es DIRECTAMENTE un Equipo/Corriente/OPC en CUALQUIER área?
        if (connectedElement == null)
        {
            connectedElement = WM.Areas.SelectMany(a => a.Elements).FirstOrDefault(x => x.Id == connectedId);
        }

        // 🚀 3. EVALUACIÓN FINAL Y AGUJERO DE GUSANO
        if (connectedElement != null)
        {
            // Caso A: Es directamente una corriente
            if (connectedElement.Facade is StreamSimulationFacade directFacade)
            {
                return directFacade;
            }

            // Caso B: Es un OPC -> ¡Viajamos a la otra área!
            if (connectedElement is OffPageConnectorElement opc)
            {
                var targetArea = WM.Areas.FirstOrDefault(a => a.Id == opc.TargetAreaId);
                if (targetArea != null)
                {
                    var twinOpc = targetArea.Elements.OfType<OffPageConnectorElement>().FirstOrDefault(e => e.Id == opc.TargetConnectorId);
                    if (twinOpc != null)
                    {
                        var twinPipe = targetArea.Pipes.FirstOrDefault(p => p.SourceElementId == twinOpc.Id || p.TargetElementId == twinOpc.Id);
                        if (twinPipe != null)
                        {
                            var realStreamId = twinPipe.SourceElementId == twinOpc.Id ? twinPipe.TargetElementId : twinPipe.SourceElementId;
                            var realStream = targetArea.Elements.FirstOrDefault(e => e.Id == realStreamId);
                            
                            if (realStream?.Facade is StreamSimulationFacade wormholeFacade)
                            {
                                return wormholeFacade;
                            }
                        }
                    }
                }
            }
        }

        return null;
    }

    private List<string> GetDistinctComponents()
    {
        var allComps = new HashSet<string>();
        foreach (var port in Ports)
        {
            var facade = GetFacadeForPort(port);
            if (facade?.StreamComposition?.Value?.Components != null)
                foreach (var c in facade.StreamComposition.Value.Components) allComps.Add(c.ComponentName);
        }
        return allComps.OrderBy(c => c == "Ethanol" ? 0 : c == "Water" ? 1 : 2).ThenBy(c => c).ToList();
    }

    private ComponentComposition? GetComponent(StreamSimulationFacade facade, string compName) =>
        facade.StreamComposition?.Value?.Components?.FirstOrDefault(c => c.ComponentName.Equals(compName, StringComparison.OrdinalIgnoreCase));

    private double CalcularMasicoDesdeGL(double GL)
    {
        if (GL >= 100) return 100; if (GL <= 0) return 0;
        return ((1.881755917e-9 * Math.Pow(GL, 4)) - (1.161368119e-7 * Math.Pow(GL, 3)) + (1.36632945e-5 * Math.Pow(GL, 2)) + (7.8756832e-3 * GL)) * 100;
    }

    private double GetGLEtanol(double masico)
    {
        if (masico <= 0) return 0; if (masico >= 100) return 100;
        double sup = 100, inf = 0, GL = 0;
        for (int i = 0; i < 60; i++)
        {
            GL = (sup + inf) / 2;
            double pm = CalcularMasicoDesdeGL(GL);
            if (Math.Abs(pm - masico) < 1e-4) break;
            if (pm > masico) sup = GL; else inf = GL;
        }
        return GL;
    }
}