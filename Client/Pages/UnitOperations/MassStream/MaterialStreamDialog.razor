@* @using Shared.Calculator.MaterialStreams

<div class="modal-overlay" @onclick="CloseDialog">
    
    <div class="stream-dialog" @onclick:stopPropagation="true">
        
        <div class="dialog-header">
            <span class="dialog-title">Stream Properties</span>
            <button class="close-button" @onclick="CloseDialog">✕</button>
        </div>

        <div class="tabs-header">
            <div class="tab @(activeTab == "Conditions" ? "active" : "")" @onclick='() => SetTab("Conditions")'>Conditions</div>
            <div class="tab @(activeTab == "Composition" ? "active" : "")" @onclick='() => SetTab("Composition")'>Composition</div>
            <div class="tab disabled">Properties</div>
        </div>

        @if (activeTab == "Conditions")
        {
            <div class="tab-content active">
                <div class="data-grid conditions-grid">
                    <div class="grid-header">Property</div>
                    <div class="grid-header">Value</div>
                    <div class="grid-header">Unit</div>

                    <div class="grid-cell label">Stream Name</div>
                    <div class="grid-cell value user-defined">
                        <input type="text" value="S-101" />
                    </div>
                    <div class="grid-cell empty"></div>

                    <ProcessMethodRow MethodProperty="materialStream.ProcessThermoMethod"
                                      AvailableMethods="ThermodynamicMethods"
                                      OnMethodSelected="HandleMethodSelection" />

                    <SimpleVariableRow @bind-Variable="materialStream.VaporFraction"
                                       OnExecute='@(() => ExecuteSolver("VaporFraction"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.Temperature"
                                        OnExecute='@(() => ExecuteSolver("Temperature"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.Pressure"
                                        OnExecute='@(() => ExecuteSolver("Pressure"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.MolarFlow"
                                        OnExecute='@(() => ExecuteSolver("MolarFlow"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.MassFlow"
                                        OnExecute='@(() => ExecuteSolver("MassFlow"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.VolumetricFlow"
                                        OnExecute='@(() => ExecuteSolver("VolumetricFlow"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.MolarEnthalpy"
                                        OnExecute='@(() => ExecuteSolver("MolarEnthalpy"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.MassEnthalpy"
                                        OnExecute='@(() => ExecuteSolver("MassEnthalpy"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.MassHeatCapacity"
                                        OnExecute='@(() => ExecuteSolver("HeatCapacity"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.EnthalpyFlow"
                                        OnExecute='@(() => ExecuteSolver("EnthalpyFlow"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.MolarDensity"
                                        OnExecute='@(() => ExecuteSolver("MolarDensity"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.MassDensity"
                                        OnExecute='@(() => ExecuteSolver("MassDensity"))' />
                  
                    <ProcessVariableRow @bind-Variable="materialStream.Viscosity"
                                        OnExecute='@(() => ExecuteSolver("Viscosity"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.ThermalConductivity"
                                        OnExecute='@(() => ExecuteSolver("ThermalConductivity"))' />

                    <ProcessVariableRow @bind-Variable="materialStream.SurfaceTension"
                                        OnExecute='@(() => ExecuteSolver("SurfaceTension"))' />
                </div>
            </div>
        }

        @if (activeTab == "Composition")
        {
            <div class="tab-content active">
                <CompositionGrid CompositionState="materialStream.CompositionState"
                                 OnCompositionUpdated="HandleCompositionUpdate" />
            </div>
        }

        <div class="status-bar status-solved">
            Status: Solved
        </div>

    </div>
</div>

@code {
    // Controla qué pestaña está visible
    private string activeTab = "Conditions";
    List<ThermodynamicMethodListDto> ThermodynamicMethods = new();
    
    protected override async Task OnInitializedAsync()
    {
        var request = new GetAllMethods();
        var result = await HttpServices.PostAsync<GetAllMethods, Result<List<ThermodynamicMethodListDto>>>(request);
        if (result.Succeeded)
        {
            ThermodynamicMethods = result.Data;
        }
    }
    
    [Parameter]
    public EventCallback OnClose { get; set; }

    MaterialStream materialStream = new();
    
    // Método para cambiar de pestaña al hacer clic
    private void SetTab(string tabName)
    {
        activeTab = tabName;
    }

    private async Task CloseDialog()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
    
    private async Task HandleMethodSelection(Guid? selectedId)
    {
        if (selectedId.HasValue)
        {
            // 1. Buscamos el DTO "Pesado" (Full Data)
            var request = new GetMethodFullRequest(selectedId.Value);
            var result = await HttpServices.PostAsync<GetMethodFullRequest, Result<ThermodynamicMethodFullDto>>(request);

            if (result.Succeeded)
            {
                // 2. Inyectamos la genética a la corriente (Esto pasará el State a UserDefined)
                materialStream.SetMethod(result.Data);
                ExecuteSolver("ThermoMethod");
            }
        }
        else
        {
            // Si mandó null (volvió a 'Select Method...'), limpiamos la corriente
            materialStream.ResetMethod();
            ExecuteSolver("ThermoMethod");
        }
    }
    
    private void HandleCompositionUpdate()
    {
        // Avisamos al motor que la composición cambió para que ensucie el equilibrio
        ExecuteSolver("Composition");
    }
    
    // Este método hace exactamente lo que querías, pero en el orden correcto
    private void ExecuteSolver(string variableName)
    {
        // 1. Levantamos la bandera correcta (_equilibriumDirty o _flowsDirty)
        materialStream.OnVariableChanged(variableName);
        
        // 2. Ejecutamos el motor (ahora sí sabrá a qué if entrar)
        materialStream.Solve();
        
        // 3. Repintamos la pantalla para bloquear las celdas calculadas o mostrar resultados
        StateHasChanged();
    }
} *@