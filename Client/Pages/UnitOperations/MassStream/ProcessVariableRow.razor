@* ProcessVariableRow.razor *@

@if (Variable != null)
{
    <div class="grid-cell label">@Variable.VariableName</div>

    <div class="grid-cell value @(Variable.State == VariableState.UserDefined ? "user-defined" : "calculated")">
        <div class="grid-cell value @(Variable.State == VariableState.UserDefined ? "user-defined" : "calculated")">
            <input type="number"
                   step="any"
                   value="@Variable.Data.Value.ToString(CultureInfo.InvariantCulture)"
                   readonly="@Variable.IsReadOnly"
                   @oninput="HandleInput"
                   @onkeydown="HandleKeyDown"
                   @onblur="HandleBlur" />  @* <--- ESTO ES NUEVO *@
        </div>
    </div>

    <div class="grid-cell unit">
        <select @onchange="HandleUnitChange">
            @foreach (var unit in Variable.Data.UnitsList)
            {
                <option value="@unit.Name" selected="@(unit.Name == Variable.Data.Unit.Name)">
                    @unit.Symbol
                </option>
            }
        </select>
    </div>
}

@code {
    [Parameter] public ProcessVariable Variable { get; set; } = default!;
    
    // El "secreto" para el @bind-Variable
    [Parameter] public EventCallback<ProcessVariable> VariableChanged { get; set; }
    
    [Parameter] public EventCallback OnExecute { get; set; }
    private async Task HandleBlur(FocusEventArgs e)
    {
        // Si el usuario hace clic fuera de la caja, también lo tomamos como "Ejecutar"
        await OnExecute.InvokeAsync();
    }
    private async Task HandleInput(ChangeEventArgs e)
    {
        bool hasChanged = false;

        if (double.TryParse(e.Value?.ToString(), out var newVal))
        {
            // Guardamos el resultado del cambio real (Epsilon)
            hasChanged = Variable.SetUserValue(newVal, Variable.Data.Unit);
        }
        else
        {
            // Si borra el dato, el cambio es real (pasa a Empty)
            Variable.Reset();
            hasChanged = true;
        }

        // Solo si el cambio fue real, avisamos al modal (padre)
        if (hasChanged)
        {
            await VariableChanged.InvokeAsync(Variable);
        }
    }

    private async Task HandleUnitChange(ChangeEventArgs e)
    {
        var unitName = e.Value?.ToString();
        var selectedUnit = Variable.Data.UnitsList.FirstOrDefault(u => u.Name == unitName);
        
        if (selectedUnit != null)
        {
            // Convertimos el valor (clase Amount)
            Variable.Data.Unit = selectedUnit;
            
            // Notificamos al padre el cambio de unidad
            await VariableChanged.InvokeAsync(Variable);
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await OnExecute.InvokeAsync();
        }
    }
}