@* SimpleVariableRow.razor *@
@using System.Globalization

@if (Variable != null)
{
    <div class="grid-cell label">@Variable.VariableName</div>

    <div class="grid-cell value @(Variable.State == VariableState.UserDefined ? "user-defined" : "calculated")">
        <input type="number"
               step="any"
               value="@Variable.Data.ToString(CultureInfo.InvariantCulture)"
               readonly="@Variable.IsReadOnly"
               @oninput="HandleInput"
               @onkeydown="HandleKeyDown"
               @onblur="HandleBlur" />
    </div>

    <div class="grid-cell empty"></div>
}

@code {
    [Parameter] public ProcessVariableUnitLess Variable { get; set; } = default!;
    [Parameter] public EventCallback<ProcessVariableUnitLess> VariableChanged { get; set; }
    [Parameter] public EventCallback OnExecute { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        bool hasChanged = false;
        var valString = e.Value?.ToString();

        if (double.TryParse(valString, NumberStyles.Any, CultureInfo.InvariantCulture, out var newVal))
        {
            // Capturamos si el cambio es real
            hasChanged = Variable.SetUserValue(newVal);
        }
        else if (string.IsNullOrWhiteSpace(valString))
        {
            // Si el usuario limpia la caja, reseteamos y marcamos como cambio
            Variable.Reset();
            hasChanged = true;
        }

        // Solo disparamos el evento de cambio si hubo un cambio real o reset
        if (hasChanged)
        {
            await VariableChanged.InvokeAsync(Variable);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await OnExecute.InvokeAsync();
        }
    }

    private async Task HandleBlur(FocusEventArgs e)
    {
        // Si el usuario hace clic fuera de la caja, también ejecutamos el Solver
        await OnExecute.InvokeAsync();
    }
}