@using Client.Layout.Shapes.SVGDrawings
@using Client.Pages.UnitOperations.DialogBase
@using Shared.UnitOperations.Helpers

<EquipmentBaseDialog Equipment="Equipment" CanEdit="CanEdit">
    <MainSlot>
        <div class="flash-canvas-layout">

            @* 1. ZONA IZQUIERDA: Alimentación única *@
            <div class="port-zone left-zone">
                <EquipmentPortConnector Port="@Equipment.FeedPort"
                                        ParentEquipment="Equipment" />
            </div>

            @* 2. ZONA CENTRAL: Vapor (Top) -> SVG -> Líquidos (Bottom) *@
            <div class="center-zone">
                <div class="static-port-container top-port">
                    <EquipmentPortConnector Port="@Equipment.VaporPort"
                                            ParentEquipment="Equipment" />
                </div>

                <div class="equipment-drawing-zone">
                    <FlashTankSvg Width="180"
                                  Height="90"
                                  StatusColor="@(Equipment.StatusColor ?? "#CBD5E0")"
                                  ElementId="@Equipment.Id.ToString()" />
                </div>

                @* Salida líquida inferior *@
                <div class="bottom-ports-container">
                    <div class="static-port-container">
                        <EquipmentPortConnector Port="@Equipment.LiquidPort"
                                                ParentEquipment="Equipment" />
                    </div>
                </div>
            </div>

        </div>
    </MainSlot>

    <PropertiesSlot></PropertiesSlot>
</EquipmentBaseDialog>

@code {
    [Parameter] public Shared.ProcessFlowDiagram.Vessels.FlashTankVisualElement Equipment { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; } = true;
}
