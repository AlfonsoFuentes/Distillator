@using Shared.DesignPatterns.Thermodynamics


<div class="modal-overlay" @onclick="CloseDialog">
    
    <div class="stream-dialog" @onclick:stopPropagation="true">
        
        <div class="dialog-header">
            <span class="dialog-title">Stream Properties</span>
            <button class="close-button" @onclick="CloseDialog">✕</button>
        </div>

        <div class="tabs-header">
            <div class="tab @(activeTab == "Conditions" ? "active" : "")" @onclick='() => SetTab("Conditions")'>Conditions</div>
            <div class="tab @(activeTab == "Composition" ? "active" : "")" @onclick='() => SetTab("Composition")'>Composition</div>
            <div class="tab disabled">Properties</div>
        </div>

        @if (activeTab == "Conditions")
        {
            <div class="tab-content active">
                <div class="data-grid conditions-grid">
                    <div class="grid-header">Property</div>
                    <div class="grid-header">Value</div>
                    <div class="grid-header">Unit</div>

                    <div class="grid-cell label">Stream Name</div>
                    <div class="grid-cell value user-defined">
                        <input type="text" value="S-101" readonly />
                    </div>
                    <div class="grid-cell empty"></div>

                  
                    <NewProcessMethodRow Label="Thermodynamic Method"
                                         @bind-Variable="Facade.ThermodynamicMethod"
                                     
                                         AvailableMethods="AvailableMethods"
                                        />

                 
                     <NewSimpleVariableRow Label="Vapor Fraction"
                                          @bind-Variable="Facade.VaporFractionControlled"
                                       
                                          />

                     <NewProcessVariableRow Label="Temperature"
                                              @bind-Variable="Facade.TemperatureControlled"
                                              />

                     <NewProcessVariableRow Label="Pressure"
                                           @bind-Variable="Facade.PressureControlled" />

                    <NewProcessVariableRow Label="Molar Flow"
                                           @bind-Variable="Facade.MolarFlowControlled" />

                    <NewProcessVariableRow Label="Mass Flow"
                                           @bind-Variable="Facade.MassFlowControlled" />

                    <NewProcessVariableRow Label="Volumetric Flow"
                                           @bind-Variable="Facade.VolumetricFlowControlled" /> 

                </div>
            </div>
        }

        @if (activeTab == "Composition")
        {
            <div class="tab-content active">
               <NewCompositionGrid @bind-Variable="Facade.StreamCompositionControlled" /> 
            </div>
        }

        <div class="status-bar @(GetStatusClass())">
            Status: @GetStatusText()
        </div>

    </div>
</div>

@code {
    // ─────────────────────────────────────────────────────────
    // 🔹 PARÁMETROS
    // ─────────────────────────────────────────────────────────
    [Parameter] public EventCallback OnClose { get; set; }
    
    // 👇 Facade inyectado (o pasado como parámetro desde el padre)
    [Parameter] public StreamSimulationFacade Facade { get; set; } = new();
    
    // 👇 Origen actual del usuario (para validar ReadOnly)
    [Parameter] public MethodSource CurrentSource { get; set; } = MethodSource.UserInterface;
    
    // 👇 Lista de métodos disponibles para el dropdown
    [Parameter] public List<ThermodynamicMethodFullDto> AvailableMethods { get; set; } = new();

    // ─────────────────────────────────────────────────────────
    // 🔹 ESTADO LOCAL
    // ─────────────────────────────────────────────────────────
    private string activeTab = "Conditions";

    // ─────────────────────────────────────────────────────────
    // 🔹 INICIALIZACIÓN
    // ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // 👇 Si AvailableMethods no se pasó como parámetro, cargar desde Facade/Backend
        if (AvailableMethods == null || AvailableMethods.Count == 0)
        {
            // Opción A: Si el Facade expone un método para listar métodos
            // AvailableMethods = await Facade.GetAvailableThermodynamicMethodsAsync();
            
            // Opción B: Si necesitas HTTP directo (como en el viejo)
            var request = new GetAllCompleteMethods();
            var result = await HttpServices.PostAsync<GetAllCompleteMethods, Result<List<ThermodynamicMethodFullDto>>>(request);
            if (result.Succeeded)
            {
                AvailableMethods = result.Data;
            }
        }
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 HANDLERS DE UI
    // ─────────────────────────────────────────────────────────
    private void SetTab(string tabName)
    {
        activeTab = tabName;
    }

    private async Task CloseDialog()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }


    // ─────────────────────────────────────────────────────────
    // 🔹 HELPERS: Status bar dinámico
    // ─────────────────────────────────────────────────────────
    private string GetStatusClass()
    {
        // 👇 Aquí puedes conectar con el estado real del cálculo
        // Por ahora, simplificamos:
        if (Facade?.ThermodynamicMethod?.IsDefined == true)
            return "status-solved";
        return "status-unsolved";
    }

    private string GetStatusText()
    {
        if (Facade?.ThermodynamicMethod?.IsDefined == true)
            return "Ready";
        return "Waiting for inputs...";
    }
    
}