@if (Variable?.Value?.Components == null)
{
    <div class="composition-not-defined">Composition not defined</div>
    return;
}

<div class="scrollable-container">
    <div class="data-grid composition-grid" data-source="@Variable.Source.ToLower()">

        @* Headers *@
        <div class="grid-header fixed-col">Component</div>
        <div class="grid-header">Mass (%)</div>
        <div class="grid-header">Mole (%)</div>
        <div class="grid-header">Molar Flow</div>
        <div class="grid-header">Mass Flow</div>
        <div class="grid-header">Vol. Flow</div>

        @* Filas *@
        @foreach (var comp in GetSortedComponents())
        {
            <div class="grid-cell fixed-col label">@comp.ComponentName</div>

            @* MASS COLUMN *@
            <div class="grid-cell value" data-state="@GetCellState(comp, true)" title="@GetCellTooltip(comp, true)">
                @if (IsCellReadOnly(comp, true))
                {
                    <span class="readonly-value">@FormatFraction(comp.MassFractionSolver.Value)</span>
                }
                else
                {
                    <input type="number" step="0.01" min="0" max="100"
                           value="@GetInputValue(comp, true)"
                           placeholder="<Not defined>"
                           @onfocus="@(e => HandleFocus(comp, true))"
                           @oninput="@(e => HandleInput(e, comp, true))"
                           @onkeydown="@(e => HandleKeyDown(e, comp, true))"
                           @onblur="@(e => HandleBlur(comp, true))" />
                }
            </div>

            @* MOLE COLUMN *@
            <div class="grid-cell value" data-state="@GetCellState(comp, false)" title="@GetCellTooltip(comp, false)">
                @if (IsCellReadOnly(comp, false))
                {
                    <span class="readonly-value">@FormatFraction(comp.MolarFractionSolver.Value)</span>
                }
                else
                {
                    <input type="number" step="0.01" min="0" max="100"
                           value="@GetInputValue(comp, false)"
                           placeholder="<Not defined>"
                           @onfocus="@(e => HandleFocus(comp, false))"
                           @oninput="@(e => HandleInput(e, comp, false))"
                           @onkeydown="@(e => HandleKeyDown(e, comp, false))"
                           @onblur="@(e => HandleBlur(comp, false))" />
                }
            </div>

            @* FLOW COLUMNS (Siempre calculadas / readonly) *@
            <div class="grid-cell value" data-state="calculated">
                <span class="readonly-value">@FormatFlow(comp.MolarFlowSolver.Value?.Value)</span>
            </div>
            <div class="grid-cell value" data-state="calculated">
                <span class="readonly-value">@FormatFlow(comp.MassFlowSolver.Value?.Value)</span>
            </div>
            <div class="grid-cell value" data-state="calculated">
                <span class="readonly-value">@FormatFlow(comp.VolumetricFlowSolver.Value?.Value)</span>
            </div>
        }
    </div>
</div>
@* 🔹 Panel °GL - Parámetros ajustados *@
@* PANEL °GL - Parámetros corregidos *@
@if (Variable.Value.IsEthanolWaterMixture())
{
    @* 🔥 Definir ethanol en el scope del Razor *@
    var ethanol = Variable.Value.Components
        .FirstOrDefault(c => c.ComponentName.Equals("Ethanol", StringComparison.OrdinalIgnoreCase));

    <div class="gl-input-container">
        <EthanolWaterGlInput GLValue="@GetGlValue()"
                             GlValueChanged="OnGlValueChanged"
                             IsComponentReadOnly="@(Variable.Source == "Solver")"
                             IsGlInputReadOnly="@(Variable.Value.InputType == ComponentInputType.MolarFraction)"
                             IsMassFractionDefined="@(Variable.IsDefined && ethanol?.MassFractionSolver.IsDefined == true)"
                             SourceId="@(Variable.Source == "Solver" ? Variable.Source : null)" />
    </div>
}
@* PANEL °GL - Solo para mezcla Etanol/Agua 
@if (Variable.Value.IsEthanolWaterMixture())
{
    <div class="gl-input-container">
        <EthanolWaterGlInput GLValue="@GetGlValue()"
                             GlValueChanged="OnGlValueChanged"
                             IsComponentReadOnly="@(Variable.Source == "Solver")"
                             IsGlInputReadOnly="@(Variable.Source == "Solver" || Variable.Value.InputType == ComponentInputType.MolarFraction)"
                             IsMassFractionDefined="@(Variable.Value.InputType == ComponentInputType.MassFraction || Variable.Value.InputType == ComponentInputType.MolarFraction)"
                             SourceId="@(Variable.Source == "Solver" ? Variable.Source : null)" />
    </div>
}
*@
@code {
    [Parameter] public NewNewVariableComposition Variable { get; set; } = default!;
    [Parameter] public EventCallback<NewNewVariableComposition> VariableChanged { get; set; }

    private ComponentComposition? _editingComponent;
    private bool _isEditingMass;
    private bool _isEditingMolar;
    private double? _tempInputValue;

    // ─────────────────────────────────────────────────────────
    // 🔹 MANEJO DE ESTADOS (STATE MACHINE - IDÉNTICA)
    // ─────────────────────────────────────────────────────────

    private string GetCellState(ComponentComposition comp, bool isMass)
    {
        // 1. Si todo el componente viene calculado de otro lado (solver)
        if (Variable.Source == "Solver") return "calculated";

        var hasValue = isMass ? comp.MassFractionSolver.IsDefined : comp.MolarFractionSolver.IsDefined;
        var inputType = Variable.Value!.InputType;

        // 2. Si no hay nada definido en absoluto
        if (inputType == ComponentInputType.None) return hasValue ? "editable" : "empty";

        // 3. Reglas de Interbloqueo Termodinámico
        if (inputType == ComponentInputType.MassFraction)
        {
            return isMass ? (hasValue ? "editable" : "empty") : (hasValue ? "calculated" : "blocked");
        }

        if (inputType == ComponentInputType.MolarFraction)
        {
            return !isMass ? (hasValue ? "editable" : "empty") : (hasValue ? "calculated" : "blocked");
        }

        return "empty";
    }

    private bool IsCellReadOnly(ComponentComposition comp, bool isMass)
    {
        var state = GetCellState(comp, isMass);
        return state == "calculated" || state == "blocked";
    }

    private string? GetCellTooltip(ComponentComposition comp, bool isMass)
    {
        var state = GetCellState(comp, isMass);
        if (state == "calculated" && !string.IsNullOrWhiteSpace(Variable.Source))
            return $"Calculated by: {Variable.Source}";
        if (state == "calculated")
            return "Calculated from mixture composition";
        if (state == "blocked")
            return "Blocked: Define via " + (isMass ? "Mole %" : "Mass %");
        return null;
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 FORMATOS (IDÉNTICOS)
    // ─────────────────────────────────────────────────────────

    private string FormatFraction(double? fraction)
    {
        if (!fraction.HasValue) return "<Not defined>";
        var val = fraction.Value;
        return val == 0 ? "0.00" : (Math.Abs(val) >= 1.0 ? val.ToString("F2", CultureInfo.InvariantCulture) : val.ToString("F6", CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.'));
    }

    private string FormatFlow(double? value)
    {
        if (!value.HasValue) return "";
        var val = value.Value;
        return val == 0 ? "0.00" : (Math.Abs(val) >= 1.0 ? val.ToString("F2", CultureInfo.InvariantCulture) : val.ToString("F6", CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.'));
    }

    private string GetInputValue(ComponentComposition comp, bool isMass)
    {
        bool isEditingThis = _editingComponent == comp && ((isMass && _isEditingMass) || (!isMass && _isEditingMolar));
        if (isEditingThis && _tempInputValue.HasValue)
            return _tempInputValue.Value.ToString("F1",CultureInfo.InvariantCulture);

        var val = isMass ? comp.MassFractionSolver.Value : comp.MolarFractionSolver.Value;

        // 🔥 FIX: Usar IsDefined en lugar de HasValue
        return (isMass ? comp.MassFractionSolver.IsDefined : comp.MolarFractionSolver.IsDefined)
            ? FormatFraction(val)
            : "";
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 HANDLERS DE EVENTOS (Adaptados a nueva arquitectura)
    // ─────────────────────────────────────────────────────────

    private void HandleFocus(ComponentComposition comp, bool isMass)
    {
        if (IsCellReadOnly(comp, isMass)) return;
        _editingComponent = comp;
        _isEditingMass = isMass;
        _isEditingMolar = !isMass;
        _tempInputValue = isMass ? comp.MassFractionSolver.Value : comp.MolarFractionSolver.Value;
    }

    private void HandleInput(ChangeEventArgs e, ComponentComposition comp, bool isMass)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var value))
            _tempInputValue = value;
        else
            _tempInputValue = null;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e, ComponentComposition comp, bool isMass)
    {
        if (e.Key == "Enter") await CommitValue(comp, isMass);
        else if (e.Key == "Delete" || e.Key == "Backspace") await ClearCell();
    }

    private async Task HandleBlur(ComponentComposition comp, bool isMass)
    {
        if (_tempInputValue.HasValue || (isMass ? comp.MassFractionSolver.IsDefined : comp.MolarFractionSolver.IsDefined))
        {
            await CommitValue(comp, isMass);
        }
        else
        {
            await ClearCell();
        }
    }
    private async Task CommitValue(ComponentComposition comp, bool isMass)
    {
        if (!_tempInputValue.HasValue) return;

        // 1. Definir el valor ingresado en el componente
        if (isMass)
            comp.MassFractionSolver.SetValueFromUI(_tempInputValue.Value);
        else
            comp.MolarFractionSolver.SetValueFromUI(_tempInputValue.Value);

        // 2. Actualizar InputType en la composición
        Variable.Value!.InputType = isMass
            ? ComponentInputType.MassFraction
            : ComponentInputType.MolarFraction;

        // 3. 🔥 VALIDACIÓN CRÍTICA: ¿La suma de TODOS los componentes da ~100%?
        var sum = Variable.Value.Components
            .Sum(c => isMass ? c.MassFractionSolver.Value : c.MolarFractionSolver.Value);

        // 4. SI suma ≈ 100% → disparar cálculo centralizado
        if (sum >= 99 && sum <= 101)
        {
            // 🔥 Este llamado dispara CalculateMassMolarFractions() vía override
            Variable.SetValueFromUI(Variable.Value);
        }
        // Si NO suma 100% → NO calcular, esperar a que el usuario complete

        ResetEditingState();
        if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
    }
   

    private async Task ClearCell()
    {
        // 🔥 NUEVO: Usar ClearFromUI en los solvers de componente
        Variable.ClearFromUI();

        ResetEditingState();

        // 🔥 NUEVO: ClearFromUI en lugar de ClearValue

        if (VariableChanged.HasDelegate) await VariableChanged.InvokeAsync(Variable);
    }

    private void ResetEditingState()
    {
        _editingComponent = null;
        _isEditingMass = false;
        _isEditingMolar = false;
        _tempInputValue = null;
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 ORDENAMIENTO Y GAY-LUSSAC (Se mantiene intacto)
    // ─────────────────────────────────────────────────────────

    private IEnumerable<ComponentComposition> GetSortedComponents()
    {
        if (Variable.Value?.Components == null) return Enumerable.Empty<ComponentComposition>();
        var components = Variable.Value.Components.ToList();
        var water = components.FirstOrDefault(c => c.ComponentName.Equals("Water", StringComparison.OrdinalIgnoreCase));
        if (water != null) { components.Remove(water); components.Add(water); }
        return components;
    }
    // 🔹 Reemplaza tu método GetGlValue() por este:
    private double? GetGlValue()
    {
        if (!Variable.Value!.IsEthanolWaterMixture())
            return null;

        var ethanol = Variable.Value.Components
                    .FirstOrDefault(c => c.ComponentName.Equals("Ethanol", StringComparison.OrdinalIgnoreCase));

        if (ethanol == null) return null;

        // 🔥 Solo calcular si está definido y es por másica (no por molar)
        if (!ethanol.MassFractionSolver.IsDefined || Variable.Value.InputType == ComponentInputType.MolarFraction)
            return null;

        double massFraction = ethanol.MassFractionSolver.Value;
        if (massFraction <= 0 || massFraction > 100) return null;

        return GetGLEtanol(massFraction);
    }
   

    private async Task OnGlValueChanged(double? glValue)
    {
        if (!glValue.HasValue)
        {
            await ClearCell();
            StateHasChanged();
            return;
        }

        var massFraction = CalcularMasicoDesdeGL(glValue.Value);

        var ethanol = Variable.Value!.Components
                    .FirstOrDefault(c => c.ComponentName.Equals("Ethanol", StringComparison.OrdinalIgnoreCase));
        var water = Variable.Value.Components
            .FirstOrDefault(c => c.ComponentName.Equals("Water", StringComparison.OrdinalIgnoreCase));

        if (ethanol != null && water != null)
        {
            // 🔥 NUEVO: SetValueFromUI en lugar de asignación directa
            ethanol.MassFractionSolver.SetValueFromUI(massFraction);
            water.MassFractionSolver.SetValueFromUI(100 - massFraction);

            Variable.Value.InputType = ComponentInputType.MassFraction;

            var sum = ethanol.MassFractionSolver.Value + water.MassFractionSolver.Value;
            // if (Math.Abs(sum - 100) < 0.01)
            //     Variable.Value.CalculateMolarFractionsFromMass();

            // 🔥 NUEVO: SetValueFromUI en la composición padre
            Variable.SetValueFromUI(Variable.Value);

            if (VariableChanged.HasDelegate)
                await VariableChanged.InvokeAsync(Variable);

            StateHasChanged();
        }
    }

    // private void ClearComposition()
    // {

      
    //     // 🔥 NUEVO: ClearFromUI en la composición padre
    //     Variable.ClearFromUI();

    //     if (VariableChanged.HasDelegate)
    //         VariableChanged.InvokeAsync(Variable);

    //     StateHasChanged();
    // }

    private double CalcularMasicoDesdeGL(double GL)
    {
        if (GL >= 100) return 100; if (GL <= 0) return 0;
        return ((1.881755917e-9 * Math.Pow(GL, 4)) - (1.161368119e-7 * Math.Pow(GL, 3))
             + (1.36632945e-5 * Math.Pow(GL, 2)) + (7.8756832e-3 * GL)) * 100;
    }

    private double GetGLEtanol(double masico)
    {
        if (masico <= 0) return 0; if (masico >= 100) return 100;
        double sup = 100, inf = 0, GL = 0;
        for (int i = 0; i < 60; i++)
        {
            GL = (sup + inf) / 2;
            double pm = CalcularMasicoDesdeGL(GL);
            if (Math.Abs(pm - masico) < 1e-4) break;
            if (pm > masico) sup = GL; else inf = GL;
        }
        return Math.Round(GL, 2);
    }
}