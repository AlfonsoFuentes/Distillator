@using Shared.DesignPatterns.Thermodynamics
@using System.Globalization
@using static System.Math

@if (Variable?.Value?.Components != null)
{
    
    @if (Variable?.Value?.Components != null)
    {
        <div class="scrollable-container">
            <div class="data-grid composition-grid @(GetCssClass())">
            
                <div class="grid-header fixed-col">Component</div>
                <div class="grid-header">Mass (%)</div>
                <div class="grid-header">Mole (%)</div>
                <div class="grid-header">Molar Flow</div>
                <div class="grid-header">Mass Flow</div>
                <div class="grid-header">Vol. Flow</div>

                @foreach (var comp in Variable.Value.Components.OrderBy(c => c.ComponentName))
                {
                    <div class="grid-cell fixed-col label">@comp.ComponentName</div>
                
                    @* Mass Percentage *@
                    <div class="grid-cell value">
                        @if (IsMassColumnReadOnly())
                        {
                            <span>@GetMassFractionValue(comp)</span>
                        }
                        else
                        {
                            <input type="number" step="0.0001"
                                   placeholder="@GetMassPlaceholder(comp)"
                                   value="@GetMassFractionValue(comp)"
                                   @oninput="(e) => HandleMassInput(comp, e.Value)"
                                   @onkeydown="(e) => HandleMassKeyDown(comp, e)"
                                   @onblur="() => HandleMassBlur(comp)" />
                        }
                    </div>

                    @* Mole Percentage *@
                    <div class="grid-cell value">
                        @if (IsMoleColumnReadOnly())
                        {
                            <span>@GetMoleFractionValue(comp)</span>
                        }
                        else
                        {
                            <input type="number" step="0.0001"
                                   placeholder="@GetMolePlaceholder(comp)"
                                   value="@GetMoleFractionValue(comp)"
                                   @oninput="(e) => HandleMoleInput(comp, e.Value)"
                                   @onkeydown="(e) => HandleMoleKeyDown(comp, e)"
                                   @onblur="() => HandleMoleBlur(comp)" />
                        }
                    </div>

                    @* Flujos Parciales *@
                    <div class="grid-cell value calculated">
                        <span>@(comp.MolarFlowValue?.Value.ToString("F4") ?? "")</span>
                    </div>
                    <div class="grid-cell value calculated">
                        <span>@(comp.MassFlowValue?.Value.ToString("F4") ?? "")</span>
                    </div>
                    <div class="grid-cell value calculated">
                        <span>@(comp.VolumetricFlowValue?.Value.ToString("F4") ?? "")</span>
                    </div>
                }
            </div>
        </div>

        @* 🔹 PANEL °GL FUERA DEL SCROLL (CORREGIDO) *@
        @if (Variable.Value.IsEthanolWaterMixture())
        {
            <div class="gl-input-container">
                <EthanolWaterGlInput Variable="Variable"
                                     VariableChanged="OnCompositionChanged"
                                     GlValueChanged="OnGlChanged" />
            </div>
        }
    }
}

@code {
    // ─────────────────────────────────────────────────────────
    // 🔹 PARÁMETROS
    // ─────────────────────────────────────────────────────────
    [Parameter] public ControlledVariable<StreamComposition> Variable { get; set; } = default!;
    [Parameter] public EventCallback<ControlledVariable<StreamComposition>> VariableChanged { get; set; } = default!;

    // ─────────────────────────────────────────────────────────
    // 🔹 PROPIEDAD COMPUTADA
    // ─────────────────────────────────────────────────────────
    MethodSource CurrentSource => Variable.Source;

    // ─────────────────────────────────────────────────────────
    // 🔹 ESTADO TEMPORAL (separado por columna)
    // ─────────────────────────────────────────────────────────
    private ComponentComposition? _pendingMassComp;
    private string? _pendingMassValue;
    private ComponentComposition? _pendingMoleComp;
    private string? _pendingMoleValue;

    // ─────────────────────────────────────────────────────────
    // 🔹 HELPERS: Estado visual y permisos
    // ─────────────────────────────────────────────────────────
    
    private string GetCssClass()
    {
        if (Variable.Value == null || Variable.Source == MethodSource.None)
            return "not-defined";
        
        return Variable.Source == CurrentSource
            ? "user-defined"
            : "calculated";
    }

    private bool IsReadOnly()
    {
        return Variable.Source == MethodSource.Other;
    }

    private bool IsMassColumnReadOnly()
    {
        return IsReadOnly() ||
               (Variable.Value?.InputType == ComponentInputType.MolarFraction);
    }

    private bool IsMoleColumnReadOnly()
    {
        return IsReadOnly() ||
               (Variable.Value?.InputType == ComponentInputType.MassFraction);
    }

    private string GetMassPlaceholder(ComponentComposition comp)
    {
        return !comp.MassFraction.HasValue ? "<Not defined>" : "";
    }

    private string GetMolePlaceholder(ComponentComposition comp)
    {
        return !comp.MolarFraction.HasValue ? "<Not defined>" : "";
    }

    private string GetMassFractionValue(ComponentComposition comp)
    {
        if (_pendingMassComp?.ComponentId == comp.ComponentId && _pendingMassValue != null)
            return _pendingMassValue;
        
        return comp.MassFraction.HasValue
            ? (comp.MassFraction.Value * 100).ToString("0.####", CultureInfo.InvariantCulture)
            : "";
    }

    private string GetMoleFractionValue(ComponentComposition comp)
    {
        if (_pendingMoleComp?.ComponentId == comp.ComponentId && _pendingMoleValue != null)
            return _pendingMoleValue;
        
        return comp.MolarFraction.HasValue
            ? (comp.MolarFraction.Value * 100).ToString("0.####", CultureInfo.InvariantCulture)
            : "";
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 HANDLERS MASS%
    // ─────────────────────────────────────────────────────────
    
    private void HandleMassInput(ComponentComposition comp, object? value)
    {
        if (IsMassColumnReadOnly()) return;
        _pendingMassComp = comp;
        _pendingMassValue = value?.ToString();
    }

    private async Task HandleMassKeyDown(ComponentComposition comp, KeyboardEventArgs e)
    {
        if (IsMassColumnReadOnly()) return;
        
        if (e.Key == "Enter")
            await CommitMassEdit(comp);
        else if ((e.Key == "Delete" || e.Key == "Backspace") && comp.MassFraction.HasValue)
        {
            comp.MassFraction = null;
            await ClearMassEdit(comp);
        }
        else if ((e.Key == "Delete" || e.Key == "Backspace") && string.IsNullOrWhiteSpace(_pendingMassValue))
        {
            await ClearMassEdit(comp);
        }
    }

    private async Task HandleMassBlur(ComponentComposition comp)
    {
        if (IsMassColumnReadOnly()) return;
        await CommitMassEdit(comp);
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 HANDLERS MOLE%
    // ─────────────────────────────────────────────────────────
    
    private void HandleMoleInput(ComponentComposition comp, object? value)
    {
        if (IsMoleColumnReadOnly()) return;
        _pendingMoleComp = comp;
        _pendingMoleValue = value?.ToString();
    }

    private async Task HandleMoleKeyDown(ComponentComposition comp, KeyboardEventArgs e)
    {
        if (IsMoleColumnReadOnly()) return;
        
        if (e.Key == "Enter")
            await CommitMoleEdit(comp);
        else if ((e.Key == "Delete" || e.Key == "Backspace") && comp.MolarFraction.HasValue)
        {
            comp.MolarFraction = null;
            await ClearMoleEdit(comp);
        }
        else if ((e.Key == "Delete" || e.Key == "Backspace") && string.IsNullOrWhiteSpace(_pendingMoleValue))
        {
            await ClearMoleEdit(comp);
        }
    }

    private async Task HandleMoleBlur(ComponentComposition comp)
    {
        if (IsMoleColumnReadOnly()) return;
        await CommitMoleEdit(comp);
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 COMMIT MASS%
    // ─────────────────────────────────────────────────────────
    
    private async Task CommitMassEdit(ComponentComposition editedComp)
    {
        if (IsMassColumnReadOnly()) return;
        if (_pendingMassComp == null || Variable.Value == null) return;

        var valueString = _pendingMassValue;

        if (string.IsNullOrWhiteSpace(valueString))
        {
            await ClearMassEdit(editedComp);
            return;
        }

        if (!double.TryParse(valueString, NumberStyles.Any, CultureInfo.InvariantCulture, out var newVal))
        {
            _pendingMassComp = null;
            _pendingMassValue = null;
            StateHasChanged();
            return;
        }

        if (Variable.Value.InputType == ComponentInputType.None)
        {
            Variable.Value.InputType = ComponentInputType.MassFraction;
        }

        editedComp.MassFraction = newVal / 100.0;

        if (Variable.Value.InputType == ComponentInputType.MassFraction)
        {
            Variable.Value.CalculateMolarFractionsFromMass();
        }

        var sum = Variable.Value.Components.Sum(c => c.MassFraction ?? 0);
        
        if (sum > 1.05)
        {
            editedComp.MassFraction = null;
            _pendingMassComp = null;
            _pendingMassValue = null;
            StateHasChanged();
            return;
        }

        Variable.SetValue(Variable.Value, MethodSource.UserInterface);
        
        if (VariableChanged.HasDelegate)
            await VariableChanged.InvokeAsync(Variable);

        _pendingMassComp = null;
        _pendingMassValue = null;
        StateHasChanged();
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 CLEAR MASS%
    // ─────────────────────────────────────────────────────────
    
    private async Task ClearMassEdit(ComponentComposition comp)
    {
        if (IsMassColumnReadOnly()) return;
        if (Variable.Value == null) return;

        comp.MassFraction = null;
        comp.MolarFraction = null;

        if (Variable.Value.InputType == ComponentInputType.MassFraction)
        {
            Variable.Value.CalculateMolarFractionsFromMass();
        }

        var allMassNull = Variable.Value.Components.All(c => !c.MassFraction.HasValue);
        var allMoleNull = Variable.Value.Components.All(c => !c.MolarFraction.HasValue);

        if (allMassNull && allMoleNull)
        {
            Variable.Value.InputType = ComponentInputType.None;
            Variable.Source = MethodSource.None;
            Variable.SourceId = string.Empty;
        }
        else
        {
            Variable.SetValue(Variable.Value, Variable.Source, Variable.SourceId);
        }

        _pendingMassComp = null;
        _pendingMassValue = null;
        StateHasChanged();
        
        if (VariableChanged.HasDelegate)
            await VariableChanged.InvokeAsync(Variable);
        
        StateHasChanged();
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 COMMIT MOLE%
    // ─────────────────────────────────────────────────────────
    
    private async Task CommitMoleEdit(ComponentComposition editedComp)
    {
        if (IsMoleColumnReadOnly()) return;
        if (_pendingMoleComp == null || Variable.Value == null) return;

        var valueString = _pendingMoleValue;

        if (string.IsNullOrWhiteSpace(valueString))
        {
            await ClearMoleEdit(editedComp);
            return;
        }

        if (!double.TryParse(valueString, NumberStyles.Any, CultureInfo.InvariantCulture, out var newVal))
        {
            _pendingMoleComp = null;
            _pendingMoleValue = null;
            StateHasChanged();
            return;
        }

        if (Variable.Value.InputType == ComponentInputType.None)
        {
            Variable.Value.InputType = ComponentInputType.MolarFraction;
        }

        editedComp.MolarFraction = newVal / 100.0;

        if (Variable.Value.InputType == ComponentInputType.MolarFraction)
        {
            Variable.Value.CalculateMassFractionsFromMolar();
        }

        var sum = Variable.Value.Components.Sum(c => c.MolarFraction ?? 0);
        
        if (sum > 1.05)
        {
            editedComp.MolarFraction = null;
            _pendingMoleComp = null;
            _pendingMoleValue = null;
            StateHasChanged();
            return;
        }

        Variable.SetValue(Variable.Value, MethodSource.UserInterface);
        
        if (VariableChanged.HasDelegate)
            await VariableChanged.InvokeAsync(Variable);

        _pendingMoleComp = null;
        _pendingMoleValue = null;
        StateHasChanged();
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 CLEAR MOLE%
    // ─────────────────────────────────────────────────────────
    
    private async Task ClearMoleEdit(ComponentComposition comp)
    {
        if (IsMoleColumnReadOnly()) return;
        if (Variable.Value == null) return;

        comp.MolarFraction = null;
        comp.MassFraction = null;

        if (Variable.Value.InputType == ComponentInputType.MolarFraction)
        {
            Variable.Value.CalculateMassFractionsFromMolar();
        }

        var allMassNull = Variable.Value.Components.All(c => !c.MassFraction.HasValue);
        var allMoleNull = Variable.Value.Components.All(c => !c.MolarFraction.HasValue);

        if (allMassNull && allMoleNull)
        {
            Variable.Value.InputType = ComponentInputType.None;
            Variable.Source = MethodSource.None;
            Variable.SourceId = string.Empty;
        }
        else
        {
            Variable.SetValue(Variable.Value, Variable.Source, Variable.SourceId);
        }

        _pendingMoleComp = null;
        _pendingMoleValue = null;
        StateHasChanged();
        
        if (VariableChanged.HasDelegate)
            await VariableChanged.InvokeAsync(Variable);
        
        StateHasChanged();
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 HANDLERS PARA SINCRONIZACIÓN BIDIRECCIONAL CON °GL
    // ─────────────────────────────────────────────────────────
    
    // En NewCompositionGrid.razor, agregar:

    private async Task OnCompositionChanged(ControlledVariable<StreamComposition> updatedVariable)
    {
        if (VariableChanged.HasDelegate)
            await VariableChanged.InvokeAsync(updatedVariable);
    
        // 👇 Forzar re-render para que EthanolWaterGlInput detecte el cambio
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnGlChanged(double glValue)
    {
        // 👇 Forzar re-render del grid cuando °GL cambia
        await InvokeAsync(StateHasChanged);
    }

    private string GetGridCssClass()
    {
        var baseClass = GetCssClass();
        
        if (Variable.Value != null && Variable.Value.Components != null)
        {
            var sum = Variable.Value.InputType == ComponentInputType.MassFraction
                ? Variable.Value.Components.Sum(c => c.MassFraction ?? 0)
                : Variable.Value.Components.Sum(c => c.MolarFraction ?? 0);
        
            if (sum > 1.01)
                return $"{baseClass} sum-warning";
        }
        
        return baseClass;
    }
}