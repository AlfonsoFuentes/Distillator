<div class="scrollable-container">
    <div class="data-grid properties-grid-two-col">

        @* 👇 HEADERS: 2 columnas (Alineado con Conditions) *@
        <div class="grid-header">Physical Property</div>
        <div class="grid-header">Value</div>

        @* 👇 GRUPO 1: Phase & Density *@
        <div class="grid-cell label group-title">Phase & Density</div>

        <NewUnifiedVariableRow Label="Mass Density" @bind-Variable="Facade.MassDensity" Mode="VariableMode.Compact" IsReadOnly="true" />
        <NewUnifiedVariableRow Label="Molar Density" @bind-Variable="Facade.MolarDensity" Mode="VariableMode.Compact" IsReadOnly="true" />

        @* 👇 GRUPO 2: Thermodynamics *@
        <div class="grid-cell label group-title">Thermodynamics</div>

        <NewUnifiedVariableRow Label="Mass Enthalpy" @bind-Variable="Facade.MassEnthalpy" Mode="VariableMode.Compact" IsReadOnly="true" />
        <NewUnifiedVariableRow Label="Molar Enthalpy" @bind-Variable="Facade.MolarEnthalpy" Mode="VariableMode.Compact" IsReadOnly="true" />
        <NewUnifiedVariableRow Label="Mass Cp" @bind-Variable="Facade.MassCp" Mode="VariableMode.Compact" IsReadOnly="true" />
        <NewUnifiedVariableRow Label="Energy Flow" @bind-Variable="Facade.EnthalpyFlow" Mode="VariableMode.Compact" IsReadOnly="true" />

        @* 👇 GRUPO 3: Transport *@
        <div class="grid-cell label group-title">Transport</div>

        <NewUnifiedVariableRow Label="Viscosity" @bind-Variable="Facade.Viscosity" Mode="VariableMode.Compact" IsReadOnly="true" />
        <NewUnifiedVariableRow Label="Thermal Cond." @bind-Variable="Facade.ThermalConductivity" Mode="VariableMode.Compact" IsReadOnly="true" />

        @if (Facade.EquilibriumState == ThermodynamicState.SaturatedLiquid ||
                     Facade.EquilibriumState == ThermodynamicState.SubcooledLiquid)
        {
            <NewUnifiedVariableRow Label="Superficial Tension" @bind-Variable="Facade.SuperficialTension" Mode="VariableMode.Compact" IsReadOnly="true" />
        }

    </div>
</div>

@code {
    [Parameter, EditorRequired] public StreamFacade Facade { get; set; } = default!;
}