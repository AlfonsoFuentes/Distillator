<div class="stream-properties-panel">
    <div class="data-grid properties-grid-two-col">
        <div class="grid-header">Physical Property</div>
        <div class="grid-header">Value</div>

        <div class="grid-cell label group-title">Phase & Density</div>
        <VariableUnitLessRow Label="Molecular Weight" @bind-Variable="Facade.MolecularWeight" Mode="VariableMode.Compact" IsReadOnly="true" />
        <VariableAmountRow Label="Mass Density" @bind-Variable="Facade.MassDensity" Mode="VariableMode.Compact" IsReadOnly="true" />
        <VariableAmountRow Label="Molar Density" @bind-Variable="Facade.MolarDensity" Mode="VariableMode.Compact" IsReadOnly="true" />

        <div class="grid-cell label group-title">Thermodynamics</div>
        <VariableAmountRow Label="Mass Enthalpy" @bind-Variable="Facade.MassEnthalpy" Mode="VariableMode.Compact" IsReadOnly="true" />
        <VariableAmountRow Label="Molar Enthalpy" @bind-Variable="Facade.MolarEnthalpy" Mode="VariableMode.Compact" IsReadOnly="true" />
        <VariableAmountRow Label="Mass Cp" @bind-Variable="Facade.MassCp" Mode="VariableMode.Compact" IsReadOnly="true" />
        <VariableAmountRow Label="Energy Flow" @bind-Variable="Facade.EnthalpyFlow" Mode="VariableMode.Compact" IsReadOnly="true" />

        <div class="grid-cell label group-title">Transport</div>
        <VariableAmountRow Label="Viscosity" @bind-Variable="Facade.Viscosity" Mode="VariableMode.Compact" IsReadOnly="true" />
        <VariableAmountRow Label="Thermal Cond." @bind-Variable="Facade.ThermalConductivity" Mode="VariableMode.Compact" IsReadOnly="true" />

        @if (Facade.ThermodynamicState == ThermodynamicState.SaturatedLiquid ||
             Facade.ThermodynamicState == ThermodynamicState.SubcooledLiquid)
        {
            <VariableAmountRow Label="Superficial Tension" @bind-Variable="Facade.SuperficialTension" Mode="VariableMode.Compact" IsReadOnly="true" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IFacadeStream Facade { get; set; } = default!;
}
