@typeparam T where T : Amount
@using Shared.DesignPatterns.Thermodynamics
@using System.Globalization

<div class="grid-cell label">@Label</div>

<div class="grid-cell value @(GetCssClass())">
    @if (IsReadOnly())
    {
        <!-- 🔹 Modo readonly: mostrar texto + tooltip con SourceId -->
        <div class="readonly-container">
            <span class="readonly-value">@GetDisplayValue()</span>
            @if (Variable.Source == MethodSource.Other && !string.IsNullOrWhiteSpace(Variable.SourceId))
            {
                <div class="tooltip-trigger">
                    <span class="tooltip-text">@Variable.SourceId</span>
                </div>
            }
        </div>
    }
    else
    {
        <!-- 🔹 Modo editable: input con placeholder dinámico -->
        <input type="text"
               inputmode="decimal"
               value="@GetInputValue()"
               placeholder="@GetPlaceholder()"
               @onfocus="HandleFocus"
               @oninput="HandleInput"
               @onkeyup="HandleKeyUp"
               @onblur="HandleBlur" />
    }
</div>

<div class="grid-cell unit @(GetCssClass())">
    <select @onchange="HandleUnitChange" disabled="@(Variable.Value == null)">
        @if (Variable.Value != null)
        {
            @foreach (var unit in Variable.Value.UnitsList)
            {
                <option value="@unit.Name" selected="@(unit.Name == Variable.Value.Unit.Name)">
                    @unit.Symbol
                </option>
            }
        }
    </select>
</div>

@code {
    // ─────────────────────────────────────────────────────────
    // 🔹 PARÁMETROS
    // ─────────────────────────────────────────────────────────
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public ControlledVariable<T> Variable { get; set; } = default!;
    [Parameter] public EventCallback<ControlledVariable<T>> VariableChanged { get; set; } = default!;
    MethodSource CurrentSource => Variable.Source;

    // ─────────────────────────────────────────────────────────
    // 🔹 ESTADO TEMPORAL
    // ─────────────────────────────────────────────────────────
    private string? _tempInputValue;
    private bool _isEditing;

    // ─────────────────────────────────────────────────────────
    // 🔹 HELPERS
    // ─────────────────────────────────────────────────────────
    
    private string GetCssClass()
    {
        return Variable.Source switch
        {
            MethodSource.None => "source-none",
            MethodSource.UserInterface => "source-ui",
            MethodSource.Other => "source-other",
            _ => "source-none"
        };
    }

    // 🔹 Formato inteligente de decimales
    private string GetDisplayValue()
    {
        if (!Variable.IsDefined || Variable.Value == null)
            return "";
        
        var val = Variable.Value.Value;
        
        if (Math.Abs(val) >= 0.01)
            return val.ToString("F2", CultureInfo.InvariantCulture);
        else if (val == 0)
            return "0.00";
        else
            return val.ToString("F6", CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.');
    }

    private string GetInputValue()
    {
        if (_isEditing && _tempInputValue != null)
            return _tempInputValue;
        
        if (!Variable.IsDefined)
            return "";
        
        var val = Variable.Value?.Value ?? 0;
        
        if (Math.Abs(val) >= 0.01)
            return val.ToString("F2", CultureInfo.InvariantCulture);
        else if (val == 0)
            return "0.00";
        else
            return val.ToString("F6", CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.');
    }

    private string GetPlaceholder()
    {
        return !Variable.IsDefined ? "<Not defined>" : "";
    }

    private bool IsReadOnly()
    {
        return Variable.Source == MethodSource.Other;
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 HANDLERS
    // ─────────────────────────────────────────────────────────
    
    private void HandleFocus(FocusEventArgs e)
    {
        if (IsReadOnly()) return;
        
        if (!Variable.IsDefined)
        {
            _isEditing = true;
            StateHasChanged();
        }
    }
    
    private async Task HandleInput(ChangeEventArgs e)
    {
        if (IsReadOnly()) return;
        
        _tempInputValue = e.Value?.ToString();
        _isEditing = true;

        if (string.IsNullOrWhiteSpace(_tempInputValue))
        {
            await ClearValue();
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (IsReadOnly()) return;
        
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            await CommitValue();
        }
    }

    private async Task HandleBlur(FocusEventArgs e)
    {
        if (IsReadOnly()) return;
        
        if (!Variable.IsDefined && string.IsNullOrWhiteSpace(_tempInputValue))
        {
            _isEditing = false;
            _tempInputValue = null;
            StateHasChanged();
            return;
        }
        
        await CommitValue();
    }

    private async Task HandleUnitChange(ChangeEventArgs e)
    {
        if (Variable.Value == null) return;

        var unitName = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(unitName)) return;

        var newUnit = Variable.Value.UnitsList.FirstOrDefault(u => u.Name == unitName);
        if (newUnit != null && newUnit != Variable.Value.Unit)
        {
            var convertedValue = Variable.Value.ConvertedTo(newUnit).Value;
            Variable.Value.SetValue(convertedValue, newUnit);
            
            if (VariableChanged.HasDelegate)
                await VariableChanged.InvokeAsync(Variable);
            
            _tempInputValue = null;
            _isEditing = false;
            StateHasChanged();
        }
    }

    private async Task CommitValue()
    {
        if (IsReadOnly()) return;
        
        if (!_isEditing || string.IsNullOrWhiteSpace(_tempInputValue))
        {
            _tempInputValue = null;
            _isEditing = false;
            StateHasChanged();
            return;
        }

        var normalizedInput = _tempInputValue.Replace(',', '.');

        if (double.TryParse(normalizedInput, NumberStyles.Any, CultureInfo.InvariantCulture, out var newVal))
        {
            if (Variable.Value != null)
            {
                Variable.Value.SetValue(newVal, Variable.Value.Unit);
                Variable.SetValue(Variable.Value, MethodSource.UserInterface);
            }
        }

        _tempInputValue = null;
        _isEditing = false;
        
        if (VariableChanged.HasDelegate)
            await VariableChanged.InvokeAsync(Variable);
        
        StateHasChanged();
    }

    private async Task ClearValue()
    {
        Variable.ClearValue();
        
        _tempInputValue = null;
        _isEditing = false;
        
        if (VariableChanged.HasDelegate)
            await VariableChanged.InvokeAsync(Variable);
        
        StateHasChanged();
    }
}