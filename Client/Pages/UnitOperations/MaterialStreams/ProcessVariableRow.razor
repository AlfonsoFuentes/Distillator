@typeparam T where T : Amount


<div class="grid-cell label">@Label</div>

<div class="grid-cell value @(GetCssClass())">
    @if (IsReadOnly())
    {
        <div class="readonly-container">
            <span class="readonly-value">@GetDisplayValue()</span>
            @if (Variable.Source == MethodSource.Other && !string.IsNullOrWhiteSpace(Variable.SourceId))
            {
                <div class="tooltip-trigger">
                    <span class="tooltip-text">Calculated by: @Variable.SourceId</span>
                </div>
            }
        </div>
    }
    else
    {
        <input type="text"
               inputmode="decimal"
               value="@GetInputValue()"
               placeholder="@GetPlaceholder()"
               @onfocus="HandleFocus"
               @oninput="HandleInput"
               @onkeyup="HandleKeyUp"
               @onblur="HandleBlur" />
    }
</div>

<div class="grid-cell unit @(GetCssClass())">
    <select @onchange="HandleUnitChange" disabled="@(Variable.Value == null)">
        @if (Variable.Value != null)
        {
            @foreach (var unit in Variable.Value.UnitsList)
            {
                <option value="@unit.Name" selected="@(unit.Name == Variable.GetDisplayUnit()?.Name)">
                    @unit.Symbol
                </option>
            }
        }
    </select>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public ControlledAmountVariable<T> Variable { get; set; } = default!;
    [Parameter] public EventCallback<ControlledAmountVariable<T>> VariableChanged { get; set; } = default!;
    
    private MethodSource CurrentSource => Variable.Source;
    private string? _tempInputValue;
    private bool _isEditing;

    private string GetCssClass() => Variable.Source switch
    {
        MethodSource.None => "source-none",
        MethodSource.UserInterface => "source-ui",
        MethodSource.Other => "source-other",
        _ => "source-none"
    };

    // 🔹 CLAVE: Usa GetDisplayValueAsDouble() + GetDisplayUnit()
    private string GetDisplayValue()
    {
        if (!Variable.IsDefined || Variable.Value == null)
            return "";
        
        // 👇 Obtener valor numérico en unidad preferida (sin casting!)
        var displayValue = Variable.GetDisplayValueAsDouble();
        var displayUnit = Variable.GetDisplayUnit();
        
        if (displayValue == null) return "";
        
        var val = displayValue.Value;
        
        if (Math.Abs(val) >= 0.01)
            return val.ToString("F2", CultureInfo.InvariantCulture);
        else if (val == 0)
            return "0.00";
        else
            return val.ToString("F6", CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.');
    }

    private string GetInputValue()
    {
        if (_isEditing && _tempInputValue != null)
            return _tempInputValue;
        
        if (!Variable.IsDefined)
            return "";
        
        // 👇 Mismo enfoque: valor numérico en unidad preferida
        var displayValue = Variable.GetDisplayValueAsDouble();
        
        if (displayValue == null) return "";
        
        var val = displayValue.Value;
        
        if (Math.Abs(val) >= 0.01)
            return val.ToString("F2", CultureInfo.InvariantCulture);
        else if (val == 0)
            return "0.00";
        else
            return val.ToString("F6", CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.');
    }

    private string GetPlaceholder()
    {
        if (!Variable.IsDefined)
        {
            if (Variable.Value?.UnitsList?.Count > 1)
            {
               
                return $"<Not defined>";
            }
            return "<Not defined>";
        }
        return "";
    }

    private bool IsReadOnly() => Variable.Source == MethodSource.Other;

    private void HandleFocus(FocusEventArgs e)
    {
        if (IsReadOnly()) return;
        if (!Variable.IsDefined)
        {
            _isEditing = true;
            StateHasChanged();
        }
    }
    
    private async Task HandleInput(ChangeEventArgs e)
    {
        if (IsReadOnly()) return;
        _tempInputValue = e.Value?.ToString();
        _isEditing = true;
        if (string.IsNullOrWhiteSpace(_tempInputValue))
            await ClearValue();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (IsReadOnly()) return;
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
            await CommitValue();
    }

    private async Task HandleBlur(FocusEventArgs e)
    {
        if (IsReadOnly()) return;
        if (!Variable.IsDefined && string.IsNullOrWhiteSpace(_tempInputValue))
        {
            _isEditing = false;
            _tempInputValue = null;
            StateHasChanged();
            return;
        }
        await CommitValue();
    }

    private async Task HandleUnitChange(ChangeEventArgs e)
    {
        if (Variable.Value == null) return;

        var unitName = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(unitName)) return;

        var newUnit = Variable.Value.UnitsList.FirstOrDefault(u => u.Name == unitName);
        if (newUnit != null && newUnit != Variable.GetPreferredUnit())
        {
            // 👇 SetPreferredUnit ahora usa GetValue() internamente
            Variable.SetPreferredUnit(newUnit);
            
            if (VariableChanged.HasDelegate)
                await VariableChanged.InvokeAsync(Variable);
            
            _tempInputValue = null;
            _isEditing = false;
            StateHasChanged();
        }
    }

    private async Task CommitValue()
    {
        if (IsReadOnly()) return;
        
        if (!_isEditing || string.IsNullOrWhiteSpace(_tempInputValue))
        {
            _tempInputValue = null;
            _isEditing = false;
            StateHasChanged();
            return;
        }

        var normalizedInput = _tempInputValue.Replace(',', '.');

        if (double.TryParse(normalizedInput, NumberStyles.Any, CultureInfo.InvariantCulture, out var newVal))
        {
            if (Variable.Value != null)
            {
                // 👇 Obtener unidad actual (preferida) y crear nuevo Amount
                var currentUnit = Variable.GetDisplayUnit();
                if (currentUnit != null)
                {
                    var newValue = (T)Activator.CreateInstance(typeof(T), newVal, currentUnit)!;
                    Variable.SetValue(newValue, MethodSource.UserInterface);
                }
            }
        }

        _tempInputValue = null;
        _isEditing = false;
        
        if (VariableChanged.HasDelegate)
            await VariableChanged.InvokeAsync(Variable);
        
        StateHasChanged();
    }

    private async Task ClearValue()
    {
        Variable.ClearValue();
        _tempInputValue = null;
        _isEditing = false;
        
        if (VariableChanged.HasDelegate)
            await VariableChanged.InvokeAsync(Variable);
        
        StateHasChanged();
    }
}