@using System.Globalization

<div class="@PanelCssClass" title="@GetTooltipText()">

    <div class="entry-label">
        <span>°GL</span>
    </div>

    <div class="entry-input">
        @* 🔹 ESTADO READONLY (sistema o calculado) *@
        @if (IsReadOnly)
        {
            <span class="gl-value-readonly @(IsCalculated ? "calculated" : "")" title="@GetTooltipText()">
                @* 🔥 FIX: Usar GetReadonlyDisplayValue() que SIEMPRE muestra el valor *@
                @GetReadonlyDisplayValue()
                @if (!string.IsNullOrWhiteSpace(SourceId))
                {
                    <span class="auto-badge" title="Calculated by: @SourceId"></span>
                }
            </span>
        }
        @* 🔹 ESTADO EDITABLE *@
        else
        {
            <input type="number"
                   step="0.1"
                   min="0"
                   max="100"
                   value="@GetInputValue()"
                   placeholder="@Placeholder"
                   class="@(HasPlaceholder ? "has-placeholder" : "")"
                   @onfocus="HandleFocus"
                   @oninput="HandleInput"
                   @onkeydown="HandleKeyDown"
                   @onblur="HandleBlur" />
        }
    </div>

    <span class="entry-info">@GetInfoText()</span>
</div>

@code {
    // ─────────────────────────────────────────────────────────
    // 🔹 PARÁMETROS
    // ─────────────────────────────────────────────────────────
    [Parameter] public double? GLValue { get; set; }
    [Parameter] public EventCallback<double?> GlValueChanged { get; set; } = default!;
    [Parameter] public bool IsComponentReadOnly { get; set; }
    [Parameter] public bool IsGlInputReadOnly { get; set; }
    [Parameter] public bool IsMassFractionDefined { get; set; }
    [Parameter] public string? SourceId { get; set; }

    private double? _tempValue;
    private bool _isEditing;
    private bool _hasUserTyped;
    private string? _rawInput;

    // ─────────────────────────────────────────────────────────
    // 🔹 PROPIEDADES COMPUTADAS
    // ─────────────────────────────────────────────────────────

    private string PanelCssClass => $"quick-entry-panel {(IsReadOnly ? "state-readonly" : "state-editable")}";
    private bool IsReadOnly => IsComponentReadOnly || IsGlInputReadOnly;
    private bool IsCalculated => IsReadOnly && !IsComponentReadOnly;
    private const string Placeholder = "<Not defined>";
    private bool HasPlaceholder => !IsMassFractionDefined && !_hasUserTyped;

    // ─────────────────────────────────────────────────────────
    // 🔹 HELPERS VISUALES
    // ─────────────────────────────────────────────────────────

    private string? GetTooltipText() =>
            !string.IsNullOrWhiteSpace(SourceId) ? $"Calculated by: {SourceId}" : null;

    private string GetInfoText()
    {
        if (IsReadOnly)
            return IsComponentReadOnly
                ? "Auto-calculated from Mass Fraction"
                : "Auto-calculated (input via Molar %)";

        return IsMassFractionDefined
                    ? "Set °GL to define Mass Fraction of Ethanol"
                    : "Click to define via °GL";
    }

    // 🔹 Valor para modo readonly (SIEMPRE muestra el valor)
    private string GetReadonlyDisplayValue()
    {
        if (!GLValue.HasValue) return Placeholder;
        return FormatValue(GLValue.Value);
    }

    // 🔹 Valor para display (usado en otros contextos)
    private string GetDisplayValue() => IsMassFractionDefined && GLValue.HasValue ? FormatValue(GLValue.Value) : "";

    // 🔹 Valor para input editable (sin formato durante edición)
    private string GetInputValue()
    {
        if (_isEditing && _rawInput != null) return _rawInput;
        return GLValue.HasValue ? FormatValue(GLValue.Value) : "";
    }

    // 🔹 Formato con redondeo a 2 decimales
    private string FormatValue(double val)
    {
        if (Math.Abs(val) < 1e-9) return "0.00";
        val = Math.Round(val, 2);
        return val.ToString("F2", CultureInfo.InvariantCulture);
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 HANDLERS
    // ─────────────────────────────────────────────────────────

    private bool CanEdit() => !IsReadOnly;

    private void HandleFocus(FocusEventArgs e)
    {
        if (!CanEdit()) return;

        _isEditing = true;
        if (GLValue.HasValue) _rawInput = GLValue.Value.ToString(CultureInfo.InvariantCulture);
        StateHasChanged();
    }

    private void HandleInput(ChangeEventArgs e)
    {
        if (!CanEdit()) return;

        _hasUserTyped = true;
        _rawInput = e.Value?.ToString();
        _tempValue = double.TryParse(_rawInput, NumberStyles.Any, CultureInfo.InvariantCulture, out var v) ? v : null;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (!CanEdit()) return;

        if (e.Key == "Enter" && _tempValue.HasValue)
            await CommitValue(_tempValue.Value);
        else if (e.Key is "Delete" or "Backspace")
            await ClearValue();
    }

    private async Task HandleBlur()
    {
        if (!CanEdit()) return;

        if ((!IsMassFractionDefined || !GLValue.HasValue) && !_hasUserTyped)
        {
            ResetEditingState();
            return;
        }

        if (_tempValue.HasValue)
            await CommitValue(_tempValue.Value);
        else if (IsMassFractionDefined && GLValue.HasValue)
            await CommitValue(GLValue.Value);
    }

    private async Task CommitValue(double value)
    {
        if (GlValueChanged.HasDelegate)
            await GlValueChanged.InvokeAsync(value);
        ResetEditingState();
    }

    private async Task ClearValue()
    {
        if (GlValueChanged.HasDelegate)
            await GlValueChanged.InvokeAsync(null);
        ResetEditingState();
    }

    private void ResetEditingState()
    {
        _tempValue = null;
        _rawInput = null;
        _isEditing = false;
        _hasUserTyped = false;
        StateHasChanged();
    }
}