

@if (Variable != null)
{
    <!-- 🔹 Contenedor con tooltip nativo para SourceId -->
    <div class="grid-cell label">@Label</div>

    <div class="grid-cell value @(GetCssClass())" title="@GetTooltipText()">
        <select class="form-select-minimal"
                disabled="@IsReadOnly()"
                value="@(Variable.Value?.Id.ToString() ?? "")"
                @onchange="HandleSelection">
            
            <!-- 🔹 Placeholder dinámico: "Select Method..." o "<Not defined>" -->
            <option value="" disabled="@(Variable.IsDefined)" class="placeholder-option">
                @(Variable.IsDefined ? "" : "<Not defined>")
            </option>
            
            @if (AvailableMethods != null)
            {
                @foreach (var method in AvailableMethods)
                {
                    <option value="@method.Id">@method.Name</option>
                }
            }
        </select>
    </div>
    
    <div class="grid-cell empty">
        @if (Variable.IsDefined && Variable.Source != CurrentSource)
        {
            <span class="inheritance-text">Inherited from @Variable.Source</span>
        }
    </div>
}

@code {
    // ─────────────────────────────────────────────────────────
    // 🔹 PARÁMETROS
    // ─────────────────────────────────────────────────────────
    [Parameter] public string Label { get; set; } = "Thermodynamic Method";
    
    // 👇 Compatible con ControlledVariable<T> base (DTO no es Amount)
    [Parameter] public ControlledVariable<ThermodynamicMethodFullDto?> Variable { get; set; } = default!;
    
    [Parameter] public List<ThermodynamicMethodFullDto> AvailableMethods { get; set; } = new();
    [Parameter] public EventCallback<ControlledVariable<ThermodynamicMethodFullDto?>> VariableChanged { get; set; } = default!;

    // ─────────────────────────────────────────────────────────
    // 🔹 PROPIEDAD COMPUTADA
    // ─────────────────────────────────────────────────────────
    private MethodSource CurrentSource => Variable.Source;

    // ─────────────────────────────────────────────────────────
    // 🔹 HELPERS VISUALES
    // ─────────────────────────────────────────────────────────

    private string GetCssClass() => Variable.Source switch
    {
        MethodSource.None => "source-none",
        MethodSource.UserInterface => "source-ui",
        MethodSource.Other => "source-other",
        _ => "source-none"
    };

    // 🔹 Tooltip nativo: solo muestra SourceId cuando es calculado por sistema
    private string? GetTooltipText()
    {
        if (Variable.Source == MethodSource.Other && !string.IsNullOrWhiteSpace(Variable.SourceId))
        {
            return $"Calculated by: {Variable.SourceId}";
        }
        return null;
    }

    // 🔹 Solo readonly si lo definió OTRO origen (sistema)
    private bool IsReadOnly() => Variable.Source == MethodSource.Other;

    // ─────────────────────────────────────────────────────────
    // 🔹 HANDLERS
    // ─────────────────────────────────────────────────────────

    private async Task HandleSelection(ChangeEventArgs e)
    {
        // 👇 La UI valida con IsReadOnly() antes de actuar
        if (IsReadOnly())
            return;

        var selectedIdString = e.Value?.ToString();

        if (Guid.TryParse(selectedIdString, out var selectedId))
        {
            var result = await HttpServices.PostAsync<GetMethodFullRequest, Result<ThermodynamicMethodFullDto>>(new GetMethodFullRequest(selectedId));
            if (result.Succeeded)
            {
                var selectedMethod = result.Data;

                if (selectedMethod != null)
                {
                    // 👇 Modificar valor y notificar al wrapper con origen UI
                    // Esto dispara ValueChanged + ConstraintsChanged automáticamente
                    Variable.SetValue(selectedMethod, MethodSource.UserInterface);
                
                    if (VariableChanged.HasDelegate)
                        await VariableChanged.InvokeAsync(Variable);
                }
            }
        }
        else
        {
            // 👇 Usuario seleccionó "<Not defined>" → des-definir
            // Esto dispara ValueChanged + ConstraintsChanged automáticamente
            Variable.ClearValue();
            
            if (VariableChanged.HasDelegate)
                await VariableChanged.InvokeAsync(Variable);
        }
        
        StateHasChanged();
    }
}