@using Shared.DesignPatterns.Thermodynamics
@using System.Globalization

@if (Variable != null)
{
    <div class="grid-cell label">@Label</div>

    <div class="grid-cell value @(GetCssClass())">
        <input type="number"
               step="any"
               value="@GetInputValue()"
               placeholder="@(!Variable.IsDefined ? "<Not defined>" : "")"
               readonly="@IsReadOnly()"
               @oninput="HandleInput"
               @onkeydown="HandleKeyDown"
               @onblur="HandleBlur" />
    </div>

    <div class="grid-cell empty"></div>
}

@code {
    // ─────────────────────────────────────────────────────────
    // 🔹 PARÁMETROS (patrón Blazor estándar)
    // ─────────────────────────────────────────────────────────
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public ControlledVariable<double> Variable { get; set; } = default!;
    [Parameter] public EventCallback<ControlledVariable<double>> VariableChanged { get; set; } = default!;

    // ─────────────────────────────────────────────────────────
    // 🔹 PROPIEDAD COMPUTADA (NO parámetro)
    // ─────────────────────────────────────────────────────────
    MethodSource CurrentSource => Variable.Source;

    // ─────────────────────────────────────────────────────────
    // 🔹 ESTADO TEMPORAL (solo para UX mientras escribe)
    // ─────────────────────────────────────────────────────────
    private string? _tempInputValue;
    private bool _isEditing;

    // ─────────────────────────────────────────────────────────
    // 🔹 HELPERS: Estado visual
    // ─────────────────────────────────────────────────────────
    
    private string GetCssClass()
    {
        if (!Variable.IsDefined)
            return "not-defined";
        
        return Variable.Source == CurrentSource
            ? "user-defined"
            : "calculated";
    }

    private string GetInputValue()
    {
        // 1. Si está editando, mostrar valor temporal
        if (_isEditing && _tempInputValue != null)
            return _tempInputValue;
        
        // 2. Si NO está definido, retornar cadena vacía (placeholder muestra leyenda)
        if (!Variable.IsDefined)
            return "";
        
        // 3. Si está definido, mostrar valor real
        return Variable.Value.ToString(CultureInfo.InvariantCulture);
    }

    // 👇 ÚNICA REGLA: Solo readonly si lo definió OTRO origen
    private bool IsReadOnly()
    {
        return Variable.Source == MethodSource.Other;
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 HANDLERS
    // ─────────────────────────────────────────────────────────
    
    private void HandleInput(ChangeEventArgs e)
    {
        if (IsReadOnly()) return;
        _tempInputValue = e.Value?.ToString();
        _isEditing = true;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (IsReadOnly()) return;
        
        if (e.Key == "Enter")
            await CommitValue();
        else if (e.Key == "Delete" || e.Key == "Backspace")
        {
            if (string.IsNullOrWhiteSpace(_tempInputValue))
                await ClearValue();
        }
    }

    private async Task HandleBlur(FocusEventArgs e)
    {
        if (IsReadOnly()) return;
        await CommitValue();
    }

    // ─────────────────────────────────────────────────────────
    // 🔹 MÉTODOS PRIVADOS: Commit y Clear
    // ─────────────────────────────────────────────────────────
    
    private async Task CommitValue()
    {
        if (IsReadOnly()) return;
        
        if (!_isEditing || string.IsNullOrWhiteSpace(_tempInputValue))
        {
            _tempInputValue = null;
            _isEditing = false;
            StateHasChanged();
            return;
        }

        if (double.TryParse(_tempInputValue, NumberStyles.Any, CultureInfo.InvariantCulture, out var newVal))
        {
            // 👇 Modificar el valor y notificar al wrapper con origen UI (hardcodeado)
            Variable.SetValue(newVal, MethodSource.UserInterface);
        }

        _tempInputValue = null;
        _isEditing = false;
        
        if (VariableChanged.HasDelegate)
            await VariableChanged.InvokeAsync(Variable);
        
        StateHasChanged();
    }

    private async Task ClearValue()
    {
        // 👇 La UI YA validó con IsReadOnly(), wrapper ejecuta sin preguntar
        Variable.ClearValue();
        
        _tempInputValue = null;
        _isEditing = false;
        
        if (VariableChanged.HasDelegate)
            await VariableChanged.InvokeAsync(Variable);
        
        StateHasChanged();
    }
}