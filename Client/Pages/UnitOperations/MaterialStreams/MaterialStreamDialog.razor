@using Client.Pages.UnitOperations.MaterialStreams.CompositionGrids
@using Client.Services.Diagnostics
@using Distillator.Domain.Services
@implements IDisposable
@inject ProjectActivityLogService ActivityLog


<MudDialog Gutters="false" ContentClass="pa-0">
    <DialogContent>
        <CascadingValue Name="IsProjectReadOnly" Value="@(!CanEdit)">
        @* 💡 Ya no necesitamos el div .modal-overlay *@
        <div class="stream-dialog">

            <div class="dialog-header">
                <span class="dialog-title">Stream Properties</span>
                <button class="close-button" @onclick="Cancel">✕</button>
            </div>

            <div class="tabs-header">
                <div class="tab @(activeTab == "Conditions" ? "active" : "")" @onclick='() => SetTab("Conditions")'>Conditions</div>
                <div class="tab @(activeTab == "Composition" ? "active" : "")" @onclick='() => SetTab("Composition")'>Composition</div>
                <div class="tab @(activeTab == "Properties" ? "active" : "")" @onclick='() => SetTab("Properties")'>Properties</div>
                <div class="tab @(activeTab == "PhaseEnvelope" ? "active" : "")" @onclick='() => SetTab("PhaseEnvelope")'>Phase Envelope</div>
              
            </div>

            <div class="dialog-body">
                @if (activeTab == "Conditions")
                {
                    <div class="tab-panel">
                        <MaterialStreamMainData Facade="Facade" OnStreamUpdated="HandleStreamUpdated" />
                    </div>
                }
                else if (activeTab == "Composition")
                {
                    <div class="tab-panel">
                        <CompositionGrid @bind-Variable="Facade.Composition"
                                         OnCompositionUpdated="HandleStreamUpdated" />
                    </div>
                }
                else if (activeTab == "Properties")
                {
                    <div class="tab-panel">
                        <MaterialStreamProperties Facade="Facade" />
                    </div>
                }
                else if (activeTab == "PhaseEnvelope")
                {
                    <div class="tab-panel phase-envelope-panel">
                        @if (isCalculatingEnvelope)
                        {
                            <div class="phase-envelope-message">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                                <div class="phase-envelope-title">Generating Phase Envelope...</div>
                                <div class="phase-envelope-subtitle">Running 50 thermodynamic flashes</div>
                            </div>
                        }
                        else if (Facade.EnvelopeCache != null && Facade.EnvelopeCache.Success)
                        {
                            <StreamPhaseEnvelope EnvelopeData="Facade.EnvelopeCache"
                                                 CurrentStream="Facade"
                                                 ChartMode="PT" />
                        }
                        else
                        {
                            <div class="phase-envelope-error">
                                <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" />
                                <p>@Facade.EnvelopeCache?.ErrorMessage ?? "Could not generate envelope."</p>
                            </div>
                        }
                    </div>
                }
            </div>

            @* 🟢 AGREGAR este bloque *@
            <div class="status-bar" style="background-color: @CurrentStream.StatusColor; color: #fff;">
                <span class="status-text">@CurrentStream.StatusText</span>
            </div>
        </div>
        </CascadingValue>
    </DialogContent>
</MudDialog>

@code {
    // 1. Necesitas este parámetro para que el diálogo sepa cómo cerrarse
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public StreamVisualElement Stream { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; } = true;

    private StreamVisualElement? _activeStream;
    private StreamVisualElement CurrentStream => _activeStream ?? Stream;
    private IFacadeStream Facade => CurrentStream.Facade as IFacadeStream ?? throw new InvalidOperationException("Facade must be IFacadeStream");


    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();

  
    // ─────────────────────────────────────────────────────────
    // 🔹 ESTADO LOCAL
    // ─────────────────────────────────────────────────────────
    private string activeTab = "Conditions";

   

    // // 🔹 Handler que fuerza re-renderizado
    // private void OnFacadeStateChanged()
    // {
    //     InvokeAsync(StateHasChanged);
    // }

    // ─────────────────────────────────────────────────────────
    // 🔹 HANDLERS DE UI
    // ─────────────────────────────────────────────────────────
    private bool isCalculatingEnvelope = false;

    // Modificamos el manejador de cambio de pestaña
    private async Task SetTab(string tabName)
    {
        activeTab = tabName;

        if (tabName == "PhaseEnvelope" && Facade.EnvelopeCache == null)
        {
            isCalculatingEnvelope = true;
            StateHasChanged();

            await Facade.GenerateEnvelopeAsync();

            isCalculatingEnvelope = false;
            StateHasChanged();
        }
    }

    private async Task CloseDialog()
    {
        MudDialog.Cancel();
    }

    protected override void OnInitialized()
    {
        _activeStream = Stream;
        FSM.OnNotifyUI += OnNotifyUIHandler;
    }

    /*
    // --- CÓDIGO VIEJO (WM) PARA REFERENCIA ---
    // WM.OnNotifyUI → FSM.OnNotifyUI
    */

    public void Dispose()
    {
        FSM.OnNotifyUI -= OnNotifyUIHandler;
    }

    private void OnNotifyUIHandler()
    {
        var current = FSM.Elements.FirstOrDefault(element => element.Id == CurrentStream.Id) as StreamVisualElement;
        if (current?.Facade != null)
        {
            if (ReferenceEquals(current, CurrentStream))
            {
                _ = InvokeAsync(StateHasChanged);
                return;
            }

            _activeStream = current;
            ActivityLog.Add("Dialog", "Stream dialog refreshed", current.Name);
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleStreamUpdated()
    {
        ActivityLog.Add("Dialog", "Stream dialog local edit", CurrentStream.Name);
    }

   
}
