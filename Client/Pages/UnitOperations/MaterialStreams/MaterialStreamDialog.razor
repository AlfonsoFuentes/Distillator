@using Client.Pages.UnitOperations.MaterialStreams.CompositionGrids
@using Shared.PhaseEnvelopes
@implements IDisposable


<MudDialog Gutters="false" ContentClass="pa-0">
    <DialogContent>
        @* 💡 Ya no necesitamos el div .modal-overlay *@
        <div class="stream-dialog">

            <div class="dialog-header">
                <span class="dialog-title">Stream Properties</span>
                <button class="close-button" @onclick="Cancel">✕</button>
            </div>

            <div class="tabs-header">
                <div class="tab @(activeTab == "Conditions" ? "active" : "")" @onclick='() => SetTab("Conditions")'>Conditions</div>
                <div class="tab @(activeTab == "Composition" ? "active" : "")" @onclick='() => SetTab("Composition")'>Composition</div>
                <div class="tab @(activeTab == "Properties" ? "active" : "")" @onclick='() => SetTab("Properties")'>Properties</div>
                <div class="tab @(activeTab == "Phase Envelope" ? "active" : "")" @onclick='() => SetTab("PhaseEnvelope")'>Phase Envelope</div>
              
            </div>

            <div class="tab-content">
                @if (activeTab == "Conditions")
                {
                    <div class="tab-content active">
                        <MaterialStreamMainData Facade="Facade" />
                    </div>
                }
                @if (activeTab == "Composition")
                {
                    <div class="tab-content active">
                        <CompositionGrid @bind-Variable="Facade.Composition" />
                    </div>
                }
                @if (activeTab == "Properties")
                {
                    <div class="tab-content active">
                        <MaterialStreamProperties Facade="Facade" />
                    </div>
                }
                @if (activeTab == "PhaseEnvelope")
                {
                    <div class="tab-content active" style="min-height: 400px; display: flex; justify-content: center; align-items: center; flex-direction: column;">

                        @if (isCalculatingEnvelope)
                        {
                            <div style="text-align: center; color: #64748b;">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                                <div style="margin-top: 10px; font-weight: 600;">Generating Phase Envelope...</div>
                                <div style="font-size: 12px; opacity: 0.8;">Running 50 thermodynamic flashes</div>
                            </div>
                        }
                        else if (Facade.EnvelopeCache != null && Facade.EnvelopeCache.Success)
                        {
                            @* 📊 AQUI LLAMAMOS AL COMPONENTE SVG *@
                            <StreamPhaseEnvelope EnvelopeData="Facade.EnvelopeCache"
                                              CurrentStream="Facade"
                                              ChartMode="PT" />
                        }
                        else
                        {
                            <div style="color: #ef4444; font-weight: bold; text-align: center;">
                                <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" />
                                <p>@Facade.EnvelopeCache?.ErrorMessage ?? "Could not generate envelope."</p>
                            </div>
                        }
                    </div>
                }
            </div>

            @* 🟢 AGREGAR este bloque *@
            <div class="status-bar" style="background-color: @Stream.StatusColor; color: #fff;">
                <span class="status-text">@Stream.StatusText</span>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    // 1. Necesitas este parámetro para que el diálogo sepa cómo cerrarse
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public StreamVisualElement Stream { get; set; } = default!;
    // 2. Tu parámetro del Facade que ya tenías

    private IFacadeStream Facade => Stream.Facade as IFacadeStream ?? throw new InvalidOperationException("Facade must be IFacadeStream");


    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();

  
    // ─────────────────────────────────────────────────────────
    // 🔹 ESTADO LOCAL
    // ─────────────────────────────────────────────────────────
    private string activeTab = "Conditions";

   

    // // 🔹 Handler que fuerza re-renderizado
    // private void OnFacadeStateChanged()
    // {
    //     InvokeAsync(StateHasChanged);
    // }

    // ─────────────────────────────────────────────────────────
    // 🔹 HANDLERS DE UI
    // ─────────────────────────────────────────────────────────
    private bool isCalculatingEnvelope = false;

    // Modificamos el manejador de cambio de pestaña
    private async Task SetTab(string tabName)
    {
        activeTab = tabName;

        if (tabName == "PhaseEnvelope")
        {
            // Solo calculamos si la caché está vacía
            if (Facade.EnvelopeCache == null)
            {
                isCalculatingEnvelope = true;
                StateHasChanged(); // Forzamos a pintar el Spinner de MudBlazor

                // Esperamos que el generador haga los 50 flashes en segundo plano
                await Facade.GenerateEnvelopeAsync();

                isCalculatingEnvelope = false;
                StateHasChanged(); // Forzamos a quitar el Spinner y pintar el gráfico SVG
            }
        }
    }

    private async Task CloseDialog()
    {
        MudDialog.Cancel();
    }

    protected override void OnInitialized()
    {
        FSM.OnNotifyUI += StateHasChanged;
    }

    /*
    // --- CÓDIGO VIEJO (WM) PARA REFERENCIA ---
    // WM.OnNotifyUI → FSM.OnNotifyUI
    */

    public void Dispose()
    {
        FSM.OnNotifyUI -= StateHasChanged;
    }

   
}