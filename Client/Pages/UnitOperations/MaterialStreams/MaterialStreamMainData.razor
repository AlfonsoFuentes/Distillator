@using Client.Templates.Units

<div class="data-grid conditions-grid-three-col">

    @* 1. HEADERS *@
    <div class="grid-header">Property</div>
    <div class="grid-header">Value</div>

  
    @* 2. STREAM NAME *@
    <UnifiedNameRow Label="Stream Name"
                    @bind-Value="Facade.Name"
                    IsDuplicate="CheckDuplicateName"
                    OnGenerate="GenerateUniqueStreamName"
                    Mode="VariableMode.Compact" />



    @* 3. THERMODYNAMIC METHOD *@
    <UnifiedListRow TItem="ThermodynamicMethodFullDto"
                    TValue="ThermodynamicMethodFullDto"
                    Label="Thermodynamic Method"
                    Variable="Facade.ThermodynamicMethod"
                    Items="AvailableMethods"
                    TextSelector="m => m.Name"
                    ValueSelector="m => m"
                    CustomComparer="(v1, v2) => v1.Id == v2.Id"
                    Mode="VariableMode.Compact"
                    OnItemSelected="HandleMethodSelection"
                    OnCleared="HandleMethodClear" />


    <UnifiedDoubleRow Label="Vapor Fraction"
                      @bind-Variable="Facade.VaporFraction"
                      Mode="VariableMode.Compact"
                      MinValue="0"
                      MaxValue="1" />

    @* 5. PROPIEDADES CON NUEVO COMPONENTE (2 celdas del componente + 1 placeholder manual) *@

    <UnifiedVariableRow Label="Temperature" @bind-Variable="Facade.Temperature" Mode="VariableMode.Compact" />

    <UnifiedVariableRow Label="Pressure" @bind-Variable="Facade.Pressure" Mode="VariableMode.Compact" />


    <UnifiedVariableRow Label="Mass Flow" @bind-Variable="Facade.MassFlow" Mode="VariableMode.Compact" />


    <UnifiedVariableRow Label="Molar Flow" @bind-Variable="Facade.MolarFlow" Mode="VariableMode.Compact" />


    <UnifiedVariableRow Label="Volumetric Flow" @bind-Variable="Facade.VolumetricFlow" Mode="VariableMode.Compact" />


    <UnifiedVariableRow Label="Heat Flow" @bind-Variable="Facade.EnthalpyFlow" Mode="VariableMode.Compact" IsReadOnly="true" />


</div>

@code {
    [Parameter, EditorRequired] public StreamSimulationFacade Facade { get; set; } = default!;
    [Parameter, EditorRequired] public List<ThermodynamicMethodFullDto> AvailableMethods { get; set; } = new();

    private bool CheckDuplicateName(string newName)
    {
        return WM?.Elements?.Any(e => e.Name.Equals(newName, StringComparison.OrdinalIgnoreCase) && e.Id != Facade?.Id) == true;
    }

    // 2. Le decimos al componente qué hacer cuando pulse el botón 🔄
    private void GenerateUniqueStreamName()
    {
        if (NamingService == null || Facade == null) return;

        Facade.Name = NamingService.GenerateNextName("S");
        StateHasChanged();
    }
    private async Task HandleMethodSelection(ThermodynamicMethodFullDto selectedMethod)
    {
        if (Facade.ThermodynamicMethod == null) return;

        // Llamamos al backend tal como usted lo hacía antes
        var result = await HttpServices.PostAsync<GetMethodFullRequest, Result<ThermodynamicMethodFullDto>>(new GetMethodFullRequest(selectedMethod.Id));

        if (result.Succeeded && result.Data != null)
        {
            Facade.ThermodynamicMethod.SetValue(result.Data, MethodSource.UserInterface);
            StateHasChanged();
        }
    }

    private async Task HandleMethodClear()
    {
        if (Facade.ThermodynamicMethod == null) return;

        // Limpiamos o cambiamos el Source
        Facade.ThermodynamicMethod.Source = MethodSource.None;
        StateHasChanged();
    }
}