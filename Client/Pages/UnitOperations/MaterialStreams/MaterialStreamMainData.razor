


 <div class="data-grid conditions-grid-three-col">

    @* 1. HEADERS *@
    <div class="grid-header">Property</div>
    <div class="grid-header">Value</div>

  
@* 2. STREAM NAME *@
    <UnifiedNameRow Label="Stream Name"
                    @bind-Value="Facade.Name"
                    IsDuplicate="CheckDuplicateName"
                    OnGenerate="GenerateUniqueStreamName"
                    Mode="VariableMode.Compact" />






 <VariablePercentageRow Label="Vapor Fraction"
                      @bind-Variable="Facade.VaporFraction"
                      Mode="VariableMode.Compact"/>

@* 5. PROPIEDADES CON NUEVO COMPONENTE (2 celdas del componente + 1 placeholder manual) *@

<VariableAmountRow Label="Temperature" @bind-Variable="Facade.Temperature" Mode="VariableMode.Compact" />

<VariableAmountRow Label="Pressure" @bind-Variable="Facade.Pressure" Mode="VariableMode.Compact" />


<VariableAmountRow Label="Mass Flow" @bind-Variable="Facade.MassFlow" Mode="VariableMode.Compact" />


<VariableAmountRow Label="Molar Flow" @bind-Variable="Facade.MolarFlow" Mode="VariableMode.Compact" />


<VariableAmountRow Label="Volumetric Flow" @bind-Variable="Facade.VolumetricFlow" Mode="VariableMode.Compact" />


<VariableAmountRow Label="Heat Flow" @bind-Variable="Facade.EnthalpyFlow" Mode="VariableMode.Compact" IsReadOnly="true" />


</div> 

@code {
    [Parameter, EditorRequired] public IFacadeStream Facade { get; set; } = default!;
    // [Parameter, EditorRequired] public List<ThermodynamicMethodFullDto> AvailableMethods { get; set; } = new();

    private bool CheckDuplicateName(string newName)
    {
        return FSM?.Elements?.Any(e => e.Name.Equals(newName, StringComparison.OrdinalIgnoreCase) && e.Id != Facade?.Id) == true;
    }

    /*
    // --- CÓDIGO VIEJO (WM) PARA REFERENCIA ---
    // WM.Elements → FSM.Elements
    */

    private void GenerateUniqueStreamName()
    {
        if (FSM == null || Facade == null) return;

        Facade.Name = FSM.GenerateNextName("Stream");
        StateHasChanged();
    }

    /*
    // --- CÓDIGO VIEJO (NamingService) PARA REFERENCIA ---
    // NamingService.GenerateNextName("S") → FSM.GenerateNextName("Stream")
    */
  
}