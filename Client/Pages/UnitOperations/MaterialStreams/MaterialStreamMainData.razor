<div class="stream-main-panel">
    <div class="data-grid conditions-grid-three-col">
        <div class="grid-header">Property</div>
        <div class="grid-header">Value</div>

        <UnifiedNameRow Label="Stream Name"
                        Value="@Facade.Name"
                        ValueChanged="RenameStream"
                        IsDuplicate="CheckDuplicateName"
                        OnGenerate="GenerateUniqueStreamName"
                        AllowManualEdit="false"
                        Mode="VariableMode.Compact" />

        <VariablePercentageRow Label="Vapor Fraction"
                               @bind-Variable="Facade.VaporFraction"
                               @bind-Variable:after="NotifyStreamUpdated"
                               Mode="VariableMode.Compact" />

        <VariableAmountRow Label="Temperature" @bind-Variable="Facade.Temperature" @bind-Variable:after="NotifyStreamUpdated" Mode="VariableMode.Compact" />

        <VariableAmountRow Label="Pressure" @bind-Variable="Facade.Pressure" @bind-Variable:after="NotifyStreamUpdated" Mode="VariableMode.Compact" />

        <VariableAmountRow Label="Mass Flow" @bind-Variable="Facade.MassFlow" @bind-Variable:after="NotifyStreamUpdated" Mode="VariableMode.Compact" />

        <VariableAmountRow Label="Molar Flow" @bind-Variable="Facade.MolarFlow" @bind-Variable:after="NotifyStreamUpdated" Mode="VariableMode.Compact" />

        <VariableAmountRow Label="Volumetric Flow" @bind-Variable="Facade.VolumetricFlow" @bind-Variable:after="NotifyStreamUpdated" Mode="VariableMode.Compact" />

        <VariableAmountRow Label="Heat Flow" @bind-Variable="Facade.EnthalpyFlow" Mode="VariableMode.Compact" IsReadOnly="true" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IFacadeStream Facade { get; set; } = default!;
    [Parameter] public EventCallback OnStreamUpdated { get; set; }

    private bool CheckDuplicateName(string newName)
    {
        return FSM?.IsStreamNameDuplicated(Facade, newName) == true;
    }

    private void RenameStream(string newName)
    {
        if (FSM?.RenameStream(Facade, newName) == true)
        {
            StateHasChanged();
        }
    }

    private void GenerateUniqueStreamName()
    {
        if (FSM == null || Facade == null) return;

        RenameStream(FSM.GenerateNextName("Stream"));
    }

    private async Task NotifyStreamUpdated()
    {
        if (OnStreamUpdated.HasDelegate)
        {
            await OnStreamUpdated.InvokeAsync();
        }
    }
}
