@using Client.Layout.Shapes.SVGDrawings
@using Client.Pages.UnitOperations.DialogBase
@using Client.Pages.UnitOperations.HeatExchangers.Design
@using Shared.UnitOperations.Helpers

<EquipmentBaseDialog Equipment="Equipment" CanEdit="CanEdit">
    <MainSlot>
        <div class="phe-canvas-layout">

            <div class="side-zone left-zone">
                <div class="static-port-container top-align">
                    <span class="sub-label side-a-label">Side A Inlet</span>
                    <EquipmentPortConnector Port="@Equipment.SideAInPort" ParentEquipment="Equipment" />
                </div>

                <div class="static-port-container bottom-align">
                    <span class="sub-label side-b-label">Side B Inlet</span>
                    <EquipmentPortConnector Port="@Equipment.SideBInPort" ParentEquipment="Equipment" />
                </div>
            </div>

            @* 2. ZONA CENTRAL: Dibujo del equipo *@
            <div class="center-zone">
                <div class="port-label">Plate Pack</div>

                <div class="equipment-drawing-zone">
                    <PlateExchangerSvg Width="80"
                                       Height="80"
                                       StatusColor="@(Equipment.StatusColor ?? "#CBD5E0")"
                                       ElementId="@Equipment.Id.ToString()" />
                </div>
            </div>

            <div class="side-zone right-zone">
                <div class="static-port-container top-align">
                    <EquipmentPortConnector Port="@Equipment.SideBOutPort" ParentEquipment="Equipment" />
                    <span class="sub-label side-b-label">Side B Outlet</span>
                </div>

                <div class="static-port-container bottom-align">
                    <EquipmentPortConnector Port="@Equipment.SideAOutPort" ParentEquipment="Equipment" />
                    <span class="sub-label side-a-label">Side A Outlet</span>
                </div>
            </div>

        </div>
    </MainSlot>

    <PropertiesSlot>
        @if (Equipment.Facade is SolverHeatExchanger hx)
        {
            <VariableAmountRow Label="Side A ΔP"
                               @bind-Variable="hx.DeltaPHot"
                               Mode="VariableMode.Standard" />

            <VariableAmountRow Label="Side B ΔP"
                               @bind-Variable="hx.DeltaPCold"
                               Mode="VariableMode.Standard" />

            <VariableAmountRow Label="Duty (Heat Transfer)"
                               @bind-Variable="hx.TransferHeat"
                               Mode="VariableMode.Standard"
                               IsReadOnly="true" />
        }
    </PropertiesSlot>
    <DesignSlot>
        <PlateExchangerDesignPanel Equipment="Equipment" />
    </DesignSlot>
</EquipmentBaseDialog>

@code {
    [Parameter] public Shared.ProcessFlowDiagram.HeatExchangers.PlateExchangerVisualElement Equipment { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; } = true;
}
