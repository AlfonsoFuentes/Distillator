@using Client.Layout.Shapes.SVGDrawings
@using Client.Pages.UnitOperations.DialogBase
@using Client.Pages.UnitOperations.HeatExchangers.Design
@using Shared.UnitOperations.Helpers

<EquipmentBaseDialog Equipment="Equipment" CanEdit="CanEdit">
    <MainSlot>
        <div class="reb-canvas-layout">

            @* 1. ZONA IZQUIERDA: Salida a la Torre  *@
            <div class="side-zone left-zone">
                <div class="static-port-container top-align">
                    <span class="sub-label">Vapor/Mix Out</span>
                    <EquipmentPortConnector Port="@Equipment.TubeOutPort" ParentEquipment="Equipment" />
                </div>
            </div>

            @* 2. ZONA CENTRAL: SVG + Alimentación desde la Torre *@
            <div class="center-zone">
                <div class="port-label">Tube Side</div>

                <div class="equipment-drawing-zone">
                    <ReboilerSvg Width="60"
                                 Height="140"
                                 StatusColor="@(Equipment.StatusColor ?? "#CBD5E0")"
                                 ElementId="@Equipment.Id.ToString()" />
                </div>

                <div class="static-port-container bottom-align">
                    <EquipmentPortConnector Port="@Equipment.TubeInPort" ParentEquipment="Equipment" />
                    <span class="sub-label">Liquid Feed</span>
                </div>
            </div>

            <div class="side-zone right-zone">
                <div class="port-label">Shell Side</div>

                <div class="static-port-container top-align">
                    <EquipmentPortConnector Port="@Equipment.ShellInPort" ParentEquipment="Equipment" />
                    <span class="sub-label">Steam In</span>
                </div>

                <div class="static-port-container bottom-align">
                    <EquipmentPortConnector Port="@Equipment.CondensateOutPort" ParentEquipment="Equipment" />
                    <span class="sub-label">Condensate Out</span>
                </div>
            </div>

        </div>
    </MainSlot>

    <PropertiesSlot>
        @if (Equipment.Facade is SolverHeatExchanger hx)
        {
            <VariableAmountRow Label="Shell Side ΔP"
                               @bind-Variable="hx.DeltaPHot"
                               Mode="VariableMode.Standard" />

            <VariableAmountRow Label="Tube Side ΔP"
                               @bind-Variable="hx.DeltaPCold"
                               Mode="VariableMode.Standard" />

            <VariableAmountRow Label="Duty (Heat Transfer)"
                               @bind-Variable="hx.TransferHeat"
                               Mode="VariableMode.Standard"
                               IsReadOnly="true" />
        }
    </PropertiesSlot>
    <DesignSlot>
        <ReboilerDesignPanel Equipment="Equipment" />
    </DesignSlot>
</EquipmentBaseDialog>

@code {
    [Parameter] public Shared.ProcessFlowDiagram.HeatExchangers.ReboilerVisualElement Equipment { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; } = true;
}
