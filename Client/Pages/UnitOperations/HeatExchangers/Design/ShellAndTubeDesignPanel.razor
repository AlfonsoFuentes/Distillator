    private Task OnTubeLayoutChanged(string value)
    {
        if (Variables is null)
        {
            return Task.CompletedTask;
        }

        if (Enum.TryParse<ShellAndTubeTubeLayout>(value, out var layout))
        {
            Variables.TubeLayout = layout;
            RecalculateSelectedDesign();
        }

        return Task.CompletedTask;
    }

    private Task OnTubeStandardChanged(string value)
    {
        tubeStandard = value;
        ApplyTubeInnerDiameterFromGauge();
        RecalculateSelectedDesign();
        return Task.CompletedTask;
    }

    private Task OnTubeGaugeChanged(string value)
    {
        if (Variables is null || !int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var gauge))
        {
            return Task.CompletedTask;
        }

        Variables.TubeGauge.SetValue(new UnitLess(gauge), VariableDefinedBy.UserInput);
        ApplyTubeInnerDiameterFromGauge();
        RecalculateSelectedDesign();
        return Task.CompletedTask;
    }

    private Task OnTubeMaterialChanged(string value)
    {
        if (Variables is null)
        {
            return Task.CompletedTask;
        }

        if (Enum.TryParse<ShellAndTubeTubeMaterial>(value, out var material))
        {
            Variables.TubeMaterial = material;
            RecalculateSelectedDesign();
        }

        return Task.CompletedTask;
    }

    private Task OnTubeConstructionChanged(string value)
    {
        if (Variables is null)
        {
            return Task.CompletedTask;
        }

        if (Enum.TryParse<ShellAndTubeTubeConstruction>(value, out var construction))
        {
            Variables.TubeConstruction = construction;
            if (construction == ShellAndTubeTubeConstruction.UTube &&
                Variables.RearHeadType == Dp09dRearHeadType.FixedTubesheet)
            {
                Variables.RearHeadType = Dp09dRearHeadType.PullThroughFloatingHead;
            }

            RecalculateSelectedDesign();
        }

        return Task.CompletedTask;
    }

