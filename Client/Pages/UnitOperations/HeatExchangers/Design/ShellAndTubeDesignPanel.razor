                    </article>
                </div>
            </section>

            @if (selectedDesign.Result is HeatExchangerDesignResult result && result.RequiredMethodImplementations.Count > 0)
            {
                <section class="pending-methods">
                    <h3>Pending Implementations</h3>
                    <p>This design route exists, but these calculation methods still need validated Kern/TEMA equations.</p>
                    <ul>
                        @foreach (var method in result.RequiredMethodImplementations)
                        {
                            <li>@method</li>
                        }
                    </ul>
                </section>
            }

            @if (selectedDesign.Result is HeatExchangerDesignResult dpResult && dpResult.Recommendations.Count > 0)
            {
                <section class="pending-methods">
                    <h3>Design Practices Review</h3>
                    <p>These DP09 recommendations are active for the selected shell-and-tube design.</p>
                    <ul>
                        @foreach (var recommendation in dpResult.Recommendations)
                        {
                            <li>@recommendation</li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</section>
