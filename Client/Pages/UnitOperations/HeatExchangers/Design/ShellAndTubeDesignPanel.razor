    private static bool IsTubeCountForShellValid(ShellAndTubeDesignVariables variables) =>
        GetUnitLessValue(variables.ActualTubeCount) <= GetUnitLessValue(variables.MaximumTubeCount);

    private static bool IsInstalledAreaValid(ShellAndTubeDesignVariables variables) =>
        GetAmountValue(variables.ActualArea, SurfaceUnits.Foot2) >= GetAmountValue(variables.RequiredArea, SurfaceUnits.Foot2);

    private static bool IsTubeVelocityMinimumValid(ShellAndTubeDesignVariables variables) =>
        GetAmountValue(variables.TubeVelocity, VelocityUnits.FeetPerSecond) >= GetAmountValue(variables.MinimumTubeVelocity, VelocityUnits.FeetPerSecond);

    private static bool IsTubeVelocityMaximumValid(ShellAndTubeDesignVariables variables) =>
        GetAmountValue(variables.TubeVelocity, VelocityUnits.FeetPerSecond) <= 10d;

    private static bool IsTubePressureDropValid(ShellAndTubeDesignVariables variables) =>
        GetAmountValue(variables.TubeSidePressureDrop, PressureDropUnits.psi) <= GetAllowedPressureDropPsi(variables.TubeSideAllowedPressureDrop);

    private static bool IsShellPressureDropValid(ShellAndTubeDesignVariables variables) =>
        GetAmountValue(variables.ShellSidePressureDrop, PressureDropUnits.psi) <= GetAllowedPressureDropPsi(variables.ShellSideAllowedPressureDrop);

    private static bool IsFoulingResistanceValid(ShellAndTubeDesignVariables variables) =>
        GetUnitLessValue(variables.CalculatedFoulingResistance) >= GetUnitLessValue(variables.AllowedFoulingResistance);

    private static bool IsTemaPitchValid(ShellAndTubeDesignVariables variables)
    {
        var odInches = GetDiameterValue(variables.TubeOuterDiameter, DiameterUnits.Inch);
        var pitchInches = GetDiameterValue(variables.TubePitch, DiameterUnits.Inch);
        return odInches <= 0d || pitchInches >= 1.25d * odInches;
    }

