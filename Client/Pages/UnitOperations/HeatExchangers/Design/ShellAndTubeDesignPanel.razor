@using System.Globalization
@using Distillator.Domain.Configuration
@using Distillator.Domain.Services
@using Shared.ProcessFlowDiagram.Designs
@using Shared.ProcessFlowDiagram.HeatExchangers
@using Shared.SolverConsecutive
@using Shared.UnitOperations.HeatExchangers.Design
@using UnitSystem
@inject ProjectSessionService ProjectSessionService
@implements IDisposable

<CascadingValue Value="unitPopupContext">
<section class="shell-design">
    <div class="design-toolbar">
        <button type="button" class="primary-action" @onclick="CreateDesign">Create Design</button>

        <div class="unit-system-picker">
            <span>Method</span>
            <select value="@selectedCalculationStandard" @onchange="OnCalculationStandardChanged" aria-label="Design calculation method">
                @foreach (var option in CalculationStandardOptions)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>
        </div>

        @if (Equipment.Designs.Count > 0)
        {
            <div class="design-tabs" role="tablist" aria-label="Designs">
                @foreach (var design in Equipment.Designs)
                {
                    <button type="button"
                            class="design-tab @(selectedDesign?.Id == design.Id ? "active" : null)"
                            role="tab"
                            @onclick="() => SelectDesign(design)">
                        @design.Name
                    </button>
                }
            </div>

            <div class="unit-system-picker">
                <span>Units</span>
                <select value="@SelectedUnitSystemName" @onchange="OnDesignUnitSystemChanged" aria-label="Design unit system">
                    @foreach (var option in UnitSystemOptions)
                    {
                        <option value="@option.Name">@option.Name</option>
                    }
                </select>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="design-message design-message-error">@errorMessage</div>
    }

    @if (selectedDesign is null)
    {
        <div class="empty-design">
            <div>
                <h3>Shell and tube design</h3>
                <p>Create a preliminary design from the connected streams.</p>
            </div>
        </div>
    }
    else if (Variables is { } variables)
    {
        <div class="design-surface">
            <div class="visual-grid">
                <article class="design-card">
                    <div class="card-title">
                        <h3>Tube Detail</h3>
                        <span>@FormatDefinedBy(variables.TubeOuterDiameter)</span>
                    </div>

                    <svg class="tube-svg" viewBox="0 0 220 150" role="img" aria-label="Tube detail">
                        @{
                            var od = GetDiameterValue(variables.TubeOuterDiameter, DiameterUnits.Inch);
                            var id = GetDiameterValue(variables.TubeInnerDiameter, DiameterUnits.Inch);
                            var innerRadius = od <= 0 ? 0 : Math.Clamp(52d * id / od, 8d, 50d);
                        }
                        <circle cx="110" cy="66" r="50" class="tube-outer" />
                        <circle cx="110" cy="66" r="@FormatSvg(innerRadius)" class="tube-inner" />
                        <line x1="60" y1="66" x2="160" y2="66" class="projection-line" />
                        <line x1="60" y1="116" x2="60" y2="132" class="projection-line" />
                        <line x1="160" y1="116" x2="160" y2="132" class="projection-line" />
                        <line x1="58" y1="132" x2="162" y2="132" class="dimension-line" />
                        <line x1="53" y1="137" x2="63" y2="127" class="dimension-tick" />
                        <line x1="157" y1="137" x2="167" y2="127" class="dimension-tick" />
                        <text x="110" y="13" text-anchor="middle">ID @FormatNumber(id) in</text>
                        <text x="110" y="146" text-anchor="middle">OD @FormatNumber(od) in</text>
                    </svg>

                    <div class="property-table">
                        <DesignSelectRow Label="Standard" Value="@tubeStandard" Options="TubeStandardOptions" ValueChanged="OnTubeStandardChanged" />
                        <DesignAmountRow T="Diameter" Label="Tube OD" Variable="variables.TubeOuterDiameter" ValueChanged="SetTubeOuterDiameter" />
                        <DesignAmountRow T="Diameter" Label="Tube ID" Variable="variables.TubeInnerDiameter" ReadOnly="true" />
                        <DesignSelectRow Label="Gauge" Value="@GetGaugeValue(variables)" Options="TubeGaugeOptions" ValueChanged="OnTubeGaugeChanged" />
                        <DesignSelectRow Label="Material" Value="@variables.TubeMaterial.ToString()" Options="TubeMaterialOptions" ValueChanged="OnTubeMaterialChanged" />
                    </div>
                </article>

                <article class="design-card">
                    <div class="card-title">
                        <h3>Tube Layout</h3>
                        <span>@GetCalculationStandardLabel(variables.CalculationStandard)</span>
                    </div>

                    <svg class="layout-svg" viewBox="0 0 260 232" role="img" aria-label="Tube layout">
                        <circle cx="130" cy="104" r="82" class="shell-circle" />
                        @foreach (var tube in GetAvailableTubeLayoutPoints())
                        {
                            <circle cx="@FormatSvg(tube.X)" cy="@FormatSvg(tube.Y)" r="@FormatSvg(tube.Radius)" class="layout-tube-available" />
                        }
                        @foreach (var tube in GetInstalledTubeLayoutPoints())
                        {
                            <circle cx="@FormatSvg(tube.X)" cy="@FormatSvg(tube.Y)" r="@FormatSvg(tube.Radius)" class="layout-tube" />
                        }
                        <line x1="48" y1="186" x2="48" y2="216" class="projection-line" />
                        <line x1="212" y1="186" x2="212" y2="216" class="projection-line" />
                        <line x1="54" y1="216" x2="206" y2="216" class="dimension-line" />
                        <line x1="43" y1="221" x2="53" y2="211" class="dimension-tick" />
                        <line x1="207" y1="221" x2="217" y2="211" class="dimension-tick" />
                        <text x="130" y="14" text-anchor="middle">@GetTubeLayoutSummary(variables)</text>
                        <text x="130" y="210" text-anchor="middle">Shell ID @FormatNumber(GetDiameterValue(variables.ShellInsideDiameter, DiameterUnits.Inch)) in</text>
                    </svg>

                    <div class="property-table">
                        <DesignAmountRow T="Diameter" Label="Shell ID" Variable="variables.ShellInsideDiameter" ValueChanged="value => SetDiameter(variables.ShellInsideDiameter, value)" />
                        <DesignValueRow Label="Required tubes" Value="@GetUnitLessValue(variables.RequiredTubeCount)" Integer="true" ReadOnly="true" />
                        @if (IsUTubeConstruction())
                        {
                            <DesignValueRow Label="U-tubes" Value="@GetUTubeCount(variables.ActualTubeCount)" Integer="true" ReadOnly="true" />
                        }
                        <DesignValueRow Label="@GetTubeCountRowLabel()" Value="@GetUnitLessValue(variables.ActualTubeCount)" Integer="true" ValueChanged="value => SetUnitLess(variables.ActualTubeCount, value)" />
                        <DesignValueRow Label="Tubes that fit" Value="@GetUnitLessValue(variables.MaximumTubeCount)" Integer="true" ReadOnly="true" />
                        <DesignValueRow Label="Tube count correction" Value="@GetUnitLessValue(variables.TubeCountCorrectionFactor)" ReadOnly="true" />
                        <DesignValueRow Label="U-bend tube loss" Value="@GetUnitLessValue(variables.UTubeBendTubeLossFraction)" ReadOnly="true" />
                        <DesignValueRow Label="Impingement tube loss" Value="@GetUnitLessValue(variables.ImpingementTubeLossFraction)" ReadOnly="true" />
                        <DesignValueRow Label="Shell nozzle tube loss" Value="@GetUnitLessValue(variables.ShellNozzleTubeLossFraction)" ReadOnly="true" />
                        <DesignAmountRow T="Diameter" Label="Pitch" Variable="variables.TubePitch" ValueChanged="value => SetDiameter(variables.TubePitch, value)" />
                        <DesignSelectRow Label="Layout" Value="@variables.TubeLayout.ToString()" Options="TubeLayoutOptions" ValueChanged="OnTubeLayoutChanged" />
                    </div>
                </article>

                <article class="design-card wide-card">
                    <div class="card-title">
                        <h3>Exchanger View</h3>
                        <span>@GetTemaType()</span>
                    </div>

                    <svg class="exchanger-svg" viewBox="0 0 420 178" role="img" aria-label="Exchanger view">
                        <rect x="70" y="48" width="280" height="68" rx="12" class="shell-body" />
                        <path d="M70 56 C46 56 46 108 70 108" class="head-line" />
                        <path d="M350 56 C374 56 374 108 350 108" class="head-line" />
                        @foreach (var y in GetPassLines())
                        {
                            <line x1="82" y1="@FormatSvg(y)" x2="338" y2="@FormatSvg(y)" class="tube-line" />
                        }
                        @foreach (var x in GetBaffleLines())
                        {
                            <line x1="@FormatSvg(x)" y1="52" x2="@FormatSvg(x)" y2="114" class="baffle-line" />
                        }
                        <line x1="70" y1="116" x2="70" y2="148" class="projection-line" />
                        <line x1="350" y1="116" x2="350" y2="148" class="projection-line" />
                        <line x1="78" y1="148" x2="342" y2="148" class="dimension-line" />
                        <line x1="65" y1="153" x2="75" y2="143" class="dimension-tick" />
                        <line x1="345" y1="153" x2="355" y2="143" class="dimension-tick" />
                        <line x1="374" y1="48" x2="374" y2="116" class="dimension-line" />
                        <line x1="369" y1="53" x2="379" y2="43" class="dimension-tick" />
                        <line x1="369" y1="121" x2="379" y2="111" class="dimension-tick" />
                        <text x="386" y="85" text-anchor="middle" transform="rotate(90 386 85)">ID @FormatNumber(GetDiameterValue(variables.ShellInsideDiameter, DiameterUnits.Inch)) in</text>
                        <text x="210" y="142" text-anchor="middle">Length @FormatNumber(GetLengthValue(variables.TubeLength, LengthUnits.Foot)) ft</text>
                    </svg>

                    <div class="tema-selector">
                        <button type="button" class="tema-letter">@GetFrontHeadLetter()<span>@GetFrontHeadLabel()</span></button>
                        <button type="button" class="tema-letter">@GetShellTypeLetter()<span>@GetShellTypeLabel()</span></button>
                        <button type="button" class="tema-letter">@GetRearHeadLetter()<span>@GetRearHeadLabel()</span></button>
                    </div>

                    <div class="property-table">
                        <DesignSelectRow Label="Tube construction" Value="@variables.TubeConstruction.ToString()" Options="TubeConstructionOptions" ValueChanged="OnTubeConstructionChanged" />
                        <DesignSelectRow Label="Front head" Value="@variables.FrontHeadType.ToString()" Options="FrontHeadOptions" ValueChanged="OnFrontHeadChanged" />
                        <DesignSelectRow Label="Shell type" Value="@variables.ShellType.ToString()" Options="ShellTypeOptions" ValueChanged="OnShellTypeChanged" />
                        <DesignSelectRow Label="Rear head" Value="@variables.RearHeadType.ToString()" Options="RearHeadOptions" ValueChanged="OnRearHeadChanged" />
                        <DesignSelectRow Label="Tube cleaning" Value="@variables.TubeSideCleaningMethod.ToString()" Options="CleaningMethodOptions" ValueChanged="OnTubeCleaningMethodChanged" />
                        <DesignSelectRow Label="Shell cleaning" Value="@variables.ShellSideCleaningMethod.ToString()" Options="CleaningMethodOptions" ValueChanged="OnShellCleaningMethodChanged" />
                        <DesignAmountRow T="Length" Label="Tube corrosion allowance" Variable="variables.TubeSideCorrosionAllowance" ValueChanged="value => SetLength(variables.TubeSideCorrosionAllowance, value)" />
                        <DesignAmountRow T="Length" Label="Shell corrosion allowance" Variable="variables.ShellSideCorrosionAllowance" ValueChanged="value => SetLength(variables.ShellSideCorrosionAllowance, value)" />
                        <DesignSelectRow Label="Reboiler type" Value="@variables.ReboilerType.ToString()" Options="ReboilerTypeOptions" ValueChanged="OnReboilerTypeChanged" />
                        <DesignSelectRow Label="Cooling water" Value="@variables.CoolingWaterType.ToString()" Options="CoolingWaterTypeOptions" ValueChanged="OnCoolingWaterTypeChanged" />
                        <DesignSelectRow Label="Condenser arrangement" Value="@variables.CondenserArrangement.ToString()" Options="CondenserArrangementOptions" ValueChanged="OnCondenserArrangementChanged" />
                        <DesignSelectRow Label="Enhanced heat transfer" Value="@variables.EnhancedHeatTransferType.ToString()" Options="EnhancedHeatTransferOptions" ValueChanged="OnEnhancedHeatTransferChanged" />
                        <DesignValueRow Label="Tube passes" Value="@GetUnitLessValue(variables.TubePasses)" Integer="true" ValueChanged="value => SetUnitLess(variables.TubePasses, value)" />
                        <DesignValueRow Label="Shell passes" Value="@GetUnitLessValue(variables.ShellPasses)" Integer="true" ValueChanged="value => SetUnitLess(variables.ShellPasses, value)" />
                        <DesignAmountRow T="Length" Label="Length" Variable="variables.TubeLength" ValueChanged="value => SetLength(variables.TubeLength, value)" />
                        <DesignAmountRow T="Length" Label="Baffle spacing" Variable="variables.BaffleSpacing" ValueChanged="value => SetLength(variables.BaffleSpacing, value)" />
                        <DesignSelectRow Label="Baffle type" Value="@variables.BaffleType.ToString()" Options="BaffleTypeOptions" ValueChanged="OnBaffleTypeChanged" />
                        <DesignValueRow Label="Baffle cut %" Value="@GetUnitLessValue(variables.BaffleCutPercent)" ValueChanged="value => SetUnitLess(variables.BaffleCutPercent, value)" />
                    </div>
                </article>
            </div>

            <section class="@GetConstraintClass()">
                <div class="section-title">
                    <h3>Design Constraints</h3>
                    <span>@GetOverallStatus()</span>
                </div>
                <table class="result-table">
                    <thead>
                        <tr>
                            <th>Check</th>
                            <th>Actual</th>
                            <th>Limit</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@GetTubeCountConstraintLabel()</td>
                            <td>@GetTubeCountDisplay(variables.ActualTubeCount)</td>
                            <td>&lt;= @GetTubeCapacityDisplay(variables.MaximumTubeCount)</td>
                            <td class="@GetStatusClass(IsTubeCountForShellValid(variables))">@FormatStatus(IsTubeCountForShellValid(variables))</td>
                        </tr>
                        <tr>
                            <td>Installed area</td>
                            <td><DesignAmountCell T="Area" Variable="variables.ActualArea" /></td>
                            <td>&gt;= @FormatAmountInUnit(variables.RequiredArea, variables.ActualArea.DisplayUnit) @variables.ActualArea.DisplayUnit.Symbol</td>
                            <td class="@GetStatusClass(IsInstalledAreaValid(variables))">@FormatStatus(IsInstalledAreaValid(variables))</td>
                        </tr>
                        <tr>
                            <td>Tube velocity min</td>
                            <td><DesignAmountCell T="Velocity" Variable="variables.TubeVelocity" /></td>
                            <td>&gt;= @FormatAmountInUnit(variables.MinimumTubeVelocity, variables.TubeVelocity.DisplayUnit) @variables.TubeVelocity.DisplayUnit.Symbol</td>
                            <td class="@GetStatusClass(IsTubeVelocityMinimumValid(variables))">@FormatStatus(IsTubeVelocityMinimumValid(variables))</td>
                        </tr>
                        <tr>
                            <td>Tube velocity max</td>
                            <td><DesignAmountCell T="Velocity" Variable="variables.TubeVelocity" /></td>
                            <td>&lt;= @FormatAmount(new Velocity(10d, VelocityUnits.FeetPerSecond), variables.TubeVelocity.DisplayUnit) @variables.TubeVelocity.DisplayUnit.Symbol</td>
                            <td class="@GetStatusClass(IsTubeVelocityMaximumValid(variables))">@FormatStatus(IsTubeVelocityMaximumValid(variables))</td>
                        </tr>
                        <tr>
                            <td>Tube pressure drop</td>
                            <td><DesignAmountCell T="PressureDrop" Variable="variables.TubeSidePressureDrop" /></td>
                            <td>&lt;= @FormatAmount(GetAllowedPressureDrop(variables.TubeSideAllowedPressureDrop), variables.TubeSidePressureDrop.DisplayUnit) @variables.TubeSidePressureDrop.DisplayUnit.Symbol</td>
                            <td class="@GetStatusClass(IsTubePressureDropValid(variables))">@FormatStatus(IsTubePressureDropValid(variables))</td>
                        </tr>
                        <tr>
                            <td>Shell pressure drop</td>
                            <td><DesignAmountCell T="PressureDrop" Variable="variables.ShellSidePressureDrop" /></td>
                            <td>&lt;= @FormatAmount(GetAllowedPressureDrop(variables.ShellSideAllowedPressureDrop), variables.ShellSidePressureDrop.DisplayUnit) @variables.ShellSidePressureDrop.DisplayUnit.Symbol</td>
                            <td class="@GetStatusClass(IsShellPressureDropValid(variables))">@FormatStatus(IsShellPressureDropValid(variables))</td>
                        </tr>
                        <tr>
                            <td>Fouling resistance</td>
                            <td>@FormatNumber(GetUnitLessValue(variables.CalculatedFoulingResistance)) hr ft2 F/BTU</td>
                            <td>&gt;= @FormatNumber(GetUnitLessValue(variables.AllowedFoulingResistance)) hr ft2 F/BTU</td>
                            <td class="@GetStatusClass(IsFoulingResistanceValid(variables))">@FormatStatus(IsFoulingResistanceValid(variables))</td>
                        </tr>
                        <tr>
                            <td>TEMA pitch</td>
                            <td><DesignAmountCell T="Diameter" Variable="variables.TubePitch" /></td>
                            <td>&gt;= @FormatAmount(new Diameter(1.25d * GetDiameterValue(variables.TubeOuterDiameter, DiameterUnits.Inch), DiameterUnits.Inch), variables.TubePitch.DisplayUnit) @variables.TubePitch.DisplayUnit.Symbol</td>
                            <td class="@GetStatusClass(IsTemaPitchValid(variables))">@FormatStatus(IsTemaPitchValid(variables))</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section class="datasheet">
                <div class="section-title">
                    <h3>TEMA Datasheet Preview</h3>
                    <span>@selectedDesign.Name</span>
                </div>

                <div class="datasheet-grid">
                    <article>
                        <h4>Performance Data</h4>
                        <div class="property-table datasheet-properties">
                            <DesignAmountRow T="EnergyFlow" Label="Heat Duty" Variable="variables.HeatDuty" ReadOnly="true" />
                            <DesignAmountRow T="Temperature" Label="LMTD" Variable="variables.LogMeanTemperatureDifference" ReadOnly="true" />
                            <DesignValueRow Label="LMTD Correction Factor" Value="@GetUnitLessValue(variables.LogMeanTemperatureCorrectionFactor)" ReadOnly="true" />
                            <DesignAmountRow T="HeatTransferCoefficient" Label="Typical U Min" Variable="variables.TypicalOverallCoefficientMinimum" ReadOnly="true" />
                            <DesignAmountRow T="HeatTransferCoefficient" Label="Typical U Max" Variable="variables.TypicalOverallCoefficientMaximum" ReadOnly="true" />
                            <DesignAmountRow T="Area" Label="Required Area" Variable="variables.RequiredArea" ReadOnly="true" />
                            <DesignAmountRow T="Area" Label="Actual Area" Variable="variables.ActualArea" ReadOnly="true" />
                            <DesignValueRow Label="Area Overdesign %" Value="@GetUnitLessValue(variables.AreaOverdesignPercent)" ReadOnly="true" />
                            <DesignAmountRow T="HeatSurfaceFlow" Label="Heat Flux" Variable="variables.HeatFlux" ReadOnly="true" />
                            <DesignAmountRow T="Pressure" Label="Vaporizing Critical Pressure" Variable="variables.VaporizingSideCriticalPressure" ValueChanged="value => SetPressure(variables.VaporizingSideCriticalPressure, value)" />
                            <DesignAmountRow T="Temperature" Label="Vaporizing Boiling Range" Variable="variables.VaporizingSideBoilingRange" ValueChanged="value => SetTemperature(variables.VaporizingSideBoilingRange, value)" />
                            <DesignAmountRow T="HeatSurfaceFlow" Label="Single Tube Maximum Heat Flux" Variable="variables.SingleTubeMaximumHeatFlux" ReadOnly="true" />
                            <DesignValueRow Label="Bundle Heat Flux Correction" Value="@GetUnitLessValue(variables.BundleHeatFluxCorrectionFactor)" ReadOnly="true" />
                            <DesignAmountRow T="HeatSurfaceFlow" Label="Bundle Maximum Heat Flux" Variable="variables.BundleMaximumHeatFlux" ReadOnly="true" />
                            <DesignAmountRow T="HeatTransferCoefficient" Label="Single Tube Nucleate Boiling Reference Coefficient" Variable="variables.SingleTubeNucleateBoilingReferenceCoefficient" ReadOnly="true" />
                            <DesignValueRow Label="Nucleate Boiling Pressure Correction" Value="@GetUnitLessValue(variables.NucleateBoilingPressureCorrectionFactor)" ReadOnly="true" />
                            <DesignValueRow Label="Vapor/Liquid Density Ratio" Value="@GetUnitLessValue(variables.NucleateBoilingVaporToLiquidDensityRatio)" ReadOnly="true" />
                            <DesignAmountRow T="Temperature" Label="Effective Temperature Range" Variable="variables.NucleateBoilingEffectiveTemperatureRange" ReadOnly="true" />
                            <DesignAmountRow T="HeatSurfaceFlow" Label="Effective Minimum Heat Flux" Variable="variables.NucleateBoilingEffectiveMinimumHeatFlux" ReadOnly="true" />
                            <DesignValueRow Label="Boiling Range Parameter" Value="@GetUnitLessValue(variables.NucleateBoilingRangeParameter)" ReadOnly="true" />
                            <DesignValueRow Label="Nucleate Boiling Mixture Correction" Value="@GetUnitLessValue(variables.NucleateBoilingMixtureCorrectionFactor)" ReadOnly="true" />
                            <DesignAmountRow T="HeatTransferCoefficient" Label="Corrected Nucleate Boiling Coefficient" Variable="variables.SingleTubeNucleateBoilingCoefficient" ReadOnly="true" />
                            <DesignValueRow Label="Bundle Boiling Correction" Value="@GetUnitLessValue(variables.BundleNucleateBoilingCorrectionFactor)" ReadOnly="true" />
                            <DesignAmountRow T="HeatTransferCoefficient" Label="Bundle Nucleate Boiling Coefficient" Variable="variables.BundleNucleateBoilingCoefficient" ReadOnly="true" />
                            <DesignValueRow Label="Finned Tube Surface Factor" Value="@GetUnitLessValue(variables.FinnedTubeSurfaceFactor)" ReadOnly="true" />
                            <DesignValueRow Label="Fin Efficiency Factor" Value="@GetUnitLessValue(variables.FinEfficiencyFactor)" ReadOnly="true" />
                            <DesignValueRow Label="Finned Tube Correction Factor" Value="@GetUnitLessValue(variables.FinnedTubeCorrectionFactor)" ReadOnly="true" />
                            <DesignAmountRow T="HeatTransferCoefficient" Label="Finned Tube Corrected Bundle Boiling Coefficient" Variable="variables.FinnedTubeCorrectedBundleBoilingCoefficient" ReadOnly="true" />
                            <DesignAmountRow T="HeatSurfaceFlow" Label="Vertical Thermosiphon Choke Reference Heat Flux" Variable="variables.VerticalThermosiphonChokeReferenceMaximumHeatFlux" ReadOnly="true" />
                            <DesignValueRow Label="Vertical Thermosiphon Tube Geometry Correction" Value="@GetUnitLessValue(variables.VerticalThermosiphonTubeGeometryCorrectionFactor)" ReadOnly="true" />
                            <DesignAmountRow T="HeatSurfaceFlow" Label="Vertical Thermosiphon Choke Heat Flux Limit" Variable="variables.VerticalThermosiphonChokeMaximumHeatFlux" ReadOnly="true" />
                            <DesignValueRow Label="Vertical Thermosiphon Choke Utilization" Value="@GetUnitLessValue(variables.VerticalThermosiphonChokeHeatFluxUtilization)" ReadOnly="true" />
                            <DesignAmountRow T="HeatTransferCoefficient" Label="Vertical Thermosiphon Natural Convection Coefficient" Variable="variables.VerticalThermosiphonNaturalConvectionCoefficient" ReadOnly="true" />
                            <DesignValueRow Label="Vertical Thermosiphon Reduced Heat Flux" Value="@GetUnitLessValue(variables.VerticalThermosiphonReducedHeatFlux)" ReadOnly="true" />
                            <DesignAmountRow T="Velocity" Label="Vertical Thermosiphon Inlet Velocity" Variable="variables.VerticalThermosiphonInletVelocity" ReadOnly="true" />
                            <DesignValueRow Label="Vertical Thermosiphon Figure A17 Vapor Fraction Limit" Value="@GetUnitLessValue(variables.VerticalThermosiphonFigureA17OutletVaporFractionLimit)" ReadOnly="true" />
                            <DesignValueRow Label="Vertical Thermosiphon Figure A17 Vapor Fraction Utilization" Value="@GetUnitLessValue(variables.VerticalThermosiphonFigureA17OutletVaporFractionUtilization)" ReadOnly="true" />
                            <DesignAmountRow T="Diameter" Label="Reboiler Liquid Line Recommended Diameter" Variable="variables.ReboilerLiquidLineRecommendedDiameter" ReadOnly="true" />
                            <DesignAmountRow T="HeatSurfaceFlow" Label="Maximum Allowable Heat Flux" Variable="variables.MaximumAllowableHeatFlux" ValueChanged="value => SetHeatSurfaceFlow(variables.MaximumAllowableHeatFlux, value)" />
                            <DesignAmountRow T="HeatSurfaceFlow" Label="Design Heat Flux Limit" Variable="variables.DesignHeatFluxLimit" ReadOnly="true" />
                            <DesignValueRow Label="Heat Flux Utilization" Value="@GetUnitLessValue(variables.HeatFluxUtilization)" ReadOnly="true" />
                            <DesignValueRow Label="Vaporized Fraction" Value="@GetUnitLessValue(variables.VaporizedFraction)" ReadOnly="true" />
                            <DesignValueRow Label="Vaporized Fraction Limit" Value="@GetUnitLessValue(variables.VaporizedFractionLimit)" ReadOnly="true" />
                            <DesignValueRow Label="Vaporized Fraction Utilization" Value="@GetUnitLessValue(variables.VaporizedFractionUtilization)" ReadOnly="true" />
                            <DesignAmountRow T="PressureDrop" Label="Vaporizing Side Pressure Drop" Variable="variables.VaporizingSidePressureDrop" ReadOnly="true" />
                            <DesignAmountRow T="Length" Label="Available Reboiler Tower Elevation" Variable="variables.ReboilerAvailableTowerElevation" ValueChanged="value => SetLength(variables.ReboilerAvailableTowerElevation, value)" />
                            <DesignAmountRow T="Diameter" Label="Reboiler Liquid Line Diameter" Variable="variables.ReboilerLiquidLineDiameter" ValueChanged="value => SetDiameter(variables.ReboilerLiquidLineDiameter, value)" />
                            <DesignValueRow Label="Reboiler Liquid Line K" Value="@GetUnitLessValue(variables.ReboilerLiquidLineResistanceCoefficient)" ValueChanged="value => SetUnitLess(variables.ReboilerLiquidLineResistanceCoefficient, value)" />
                            <DesignAmountRow T="Diameter" Label="Reboiler Vapor Line Diameter" Variable="variables.ReboilerVaporLineDiameter" ValueChanged="value => SetDiameter(variables.ReboilerVaporLineDiameter, value)" />
                            <DesignValueRow Label="Reboiler Vapor Line K" Value="@GetUnitLessValue(variables.ReboilerVaporLineResistanceCoefficient)" ValueChanged="value => SetUnitLess(variables.ReboilerVaporLineResistanceCoefficient, value)" />
                            <DesignAmountRow T="PressureDrop" Label="Reboiler Liquid Line Pressure Drop" Variable="variables.ReboilerLiquidLinePressureDrop" ReadOnly="true" />
                            <DesignAmountRow T="PressureDrop" Label="Reboiler Vapor Line Pressure Drop" Variable="variables.ReboilerVaporLinePressureDrop" ReadOnly="true" />
                            <DesignAmountRow T="PressureDrop" Label="Reboiler Circuit Pressure Drop" Variable="variables.ReboilerCircuitPressureDrop" ReadOnly="true" />
                            <DesignAmountRow T="Length" Label="Required Reboiler Tower Elevation" Variable="variables.ReboilerRequiredTowerElevation" ReadOnly="true" />
                            <DesignAmountRow T="PressureDrop" Label="Required Reboiler Static Head" Variable="variables.ReboilerRequiredStaticHead" ReadOnly="true" />
                            <DesignAmountRow T="PressureDrop" Label="Available Reboiler Static Head" Variable="variables.ReboilerAvailableStaticHead" ReadOnly="true" />
                            <DesignValueRow Label="Reboiler Static Head Margin" Value="@GetUnitLessValue(variables.ReboilerStaticHeadMargin)" ReadOnly="true" />
                            <DesignAmountRow T="Length" Label="Reboiler Min Tower Elevation" Variable="variables.ReboilerMinimumTowerElevation" ReadOnly="true" />
                            <DesignAmountRow T="Length" Label="Reboiler Max Tower Elevation" Variable="variables.ReboilerMaximumTowerElevation" ReadOnly="true" />
                            <DesignValueRow Label="Pump-Through Circulation Ratio" Value="@GetUnitLessValue(variables.PumpThroughRecommendedCirculationRatio)" ReadOnly="true" />
                            <DesignValueRow Label="Condensation Zones" Value="@GetUnitLessValue(variables.CondensationZoneCount)" Integer="true" ReadOnly="true" />
                            <DesignValueRow Label="Desuperheating Duty Fraction" Value="@GetUnitLessValue(variables.DesuperheatingDutyFraction)" ReadOnly="true" />
                            <DesignValueRow Label="Condensation Duty Fraction" Value="@GetUnitLessValue(variables.CondensationDutyFraction)" ReadOnly="true" />
