    private IEnumerable<(double X, double Y, double Radius)> GetInstalledTubeLayoutPoints() =>
        Variables is null ? [] : GetTubeLayoutPoints(GetUnitLessValue(Variables.ActualTubeCount));

    private IEnumerable<(double X, double Y, double Radius)> GetAvailableTubeLayoutPoints() =>
        Variables is null ? [] : GetTubeLayoutPoints(GetUnitLessValue(Variables.MaximumTubeCount));

    private IEnumerable<(double X, double Y, double Radius)> GetTubeLayoutPoints(double requestedCount)
    {
        if (Variables is null)
        {
            yield break;
        }

        var count = Math.Clamp((int)Math.Round(requestedCount), 0, 160);
        var pitch = Variables.TubeLayout == ShellAndTubeTubeLayout.Triangular ? 15d : 14d;
        var rowHeight = Variables.TubeLayout == ShellAndTubeTubeLayout.Triangular ? 13d : 14d;
        var candidates = new List<(double X, double Y, double Radius, double Distance)>();

        for (var row = -7; row <= 7; row++)
        {
            var y = 104 + row * rowHeight;
            var offset = Variables.TubeLayout == ShellAndTubeTubeLayout.Triangular && Math.Abs(row) % 2 == 1 ? pitch / 2d : 0d;

            for (var col = -8; col <= 8; col++)
            {
                var x = 130 + col * pitch + offset;
                var dx = x - 130;
                var dy = y - 104;
                var distance = dx * dx + dy * dy;

                if (Math.Sqrt(distance) <= 72)
                {
                    candidates.Add((x, y, 5.3, distance));
                }
            }
        }

        foreach (var tube in candidates
            .OrderBy(tube => tube.Distance)
            .ThenBy(tube => Math.Abs(tube.Y - 104))
            .ThenBy(tube => Math.Abs(tube.X - 130))
            .Take(count))
        {
            yield return (tube.X, tube.Y, tube.Radius);
        }
    }

    private IEnumerable<double> GetPassLines()
    {
        var passes = Variables is null ? 1 : Math.Clamp((int)Math.Round(Math.Abs(GetUnitLessValue(Variables.TubePasses))), 1, 8);
        var lines = Math.Max(3, passes + 2);
        for (var i = 0; i < lines; i++)
        {
            yield return 64 + i * (34d / (lines - 1));
        }
    }

    private IEnumerable<double> GetBaffleLines()
    {
        var length = Variables is null ? 16d : Math.Max(GetLengthValue(Variables.TubeLength, LengthUnits.Foot), 1d);
        var spacing = Variables is null ? 2d : Math.Max(GetLengthValue(Variables.BaffleSpacing, LengthUnits.Foot), 0.25d);
        var count = Math.Clamp((int)Math.Round(length / spacing), 2, 9);
        for (var i = 1; i < count; i++)
        {
            yield return 70 + i * (280d / count);
        }
    }

    private IEnumerable<CheckRow> GetConstraintRows(ShellAndTubeDesignVariables variables)
    {
        var actualTubes = GetUnitLessValue(variables.ActualTubeCount);
        var maxTubes = GetUnitLessValue(variables.MaximumTubeCount);
        var tubeVelocityFeetPerSecond = GetAmountValue(variables.TubeVelocity, VelocityUnits.FeetPerSecond);
        var minTubeVelocityFeetPerSecond = GetAmountValue(variables.MinimumTubeVelocity, VelocityUnits.FeetPerSecond);
        var tubeDropPsi = GetAmountValue(variables.TubeSidePressureDrop, PressureDropUnits.psi);
        var shellDropPsi = GetAmountValue(variables.ShellSidePressureDrop, PressureDropUnits.psi);
        var fouling = GetUnitLessValue(variables.CalculatedFoulingResistance);
        var allowedFouling = GetUnitLessValue(variables.AllowedFoulingResistance);
        var actualAreaSquareFeet = GetAmountValue(variables.ActualArea, SurfaceUnits.Foot2);
        var requiredAreaSquareFeet = GetAmountValue(variables.RequiredArea, SurfaceUnits.Foot2);
        var pitchInches = GetDiameterValue(variables.TubePitch, DiameterUnits.Inch);
        var odInches = GetDiameterValue(variables.TubeOuterDiameter, DiameterUnits.Inch);

        var areaUnit = variables.ActualArea.DisplayUnit;
        var velocityUnit = variables.TubeVelocity.DisplayUnit;
        var pressureDropUnit = variables.TubeSidePressureDrop.DisplayUnit;
        var pitchUnit = variables.TubePitch.DisplayUnit;
        var actualArea = GetAmountValue(variables.ActualArea, areaUnit);
        var requiredArea = GetAmountValue(variables.RequiredArea, variables.RequiredArea.DisplayUnit);
        var tubeVelocity = GetAmountValue(variables.TubeVelocity, velocityUnit);
        var minTubeVelocity = GetAmountValue(variables.MinimumTubeVelocity, variables.MinimumTubeVelocity.DisplayUnit);
        var tubeDrop = GetAmountValue(variables.TubeSidePressureDrop, pressureDropUnit);
        var shellDrop = GetAmountValue(variables.ShellSidePressureDrop, variables.ShellSidePressureDrop.DisplayUnit);
        var pitch = GetDiameterValue(variables.TubePitch, pitchUnit);
        var maxTubeVelocity = new Velocity(10d, VelocityUnits.FeetPerSecond).GetValue(velocityUnit);
        var tubeAllowedPressureDropPsi = GetAllowedPressureDropPsi(variables.TubeSideAllowedPressureDrop);
        var shellAllowedPressureDropPsi = GetAllowedPressureDropPsi(variables.ShellSideAllowedPressureDrop);
        var maxTubeDrop = new PressureDrop(tubeAllowedPressureDropPsi, PressureDropUnits.psi).GetValue(pressureDropUnit);
        var maxShellDrop = new PressureDrop(shellAllowedPressureDropPsi, PressureDropUnits.psi).GetValue(variables.ShellSidePressureDrop.DisplayUnit);
        var minimumTemaPitch = new Diameter(1.25d * odInches, DiameterUnits.Inch).GetValue(pitchUnit);

        yield return BuildCheck("Tube count for shell", $"{FormatInteger(actualTubes)} tubes", $"<= {FormatInteger(maxTubes)} tubes", actualTubes <= maxTubes);
        yield return BuildCheck("Installed area", $"{FormatNumber(actualArea)} {areaUnit.Symbol}", $">= {FormatNumber(requiredArea)} {variables.RequiredArea.DisplayUnit.Symbol}", actualAreaSquareFeet >= requiredAreaSquareFeet);
        yield return BuildCheck("Tube velocity min", $"{FormatNumber(tubeVelocity)} {velocityUnit.Symbol}", $">= {FormatNumber(minTubeVelocity)} {variables.MinimumTubeVelocity.DisplayUnit.Symbol}", tubeVelocityFeetPerSecond >= minTubeVelocityFeetPerSecond);
        yield return BuildCheck("Tube velocity max", $"{FormatNumber(tubeVelocity)} {velocityUnit.Symbol}", $"<= {FormatNumber(maxTubeVelocity)} {velocityUnit.Symbol}", tubeVelocityFeetPerSecond <= 10d);
        yield return BuildCheck("Tube pressure drop", $"{FormatNumber(tubeDrop)} {pressureDropUnit.Symbol}", $"<= {FormatNumber(maxTubeDrop)} {pressureDropUnit.Symbol}", tubeDropPsi <= tubeAllowedPressureDropPsi);
        yield return BuildCheck("Shell pressure drop", $"{FormatNumber(shellDrop)} {variables.ShellSidePressureDrop.DisplayUnit.Symbol}", $"<= {FormatNumber(maxShellDrop)} {variables.ShellSidePressureDrop.DisplayUnit.Symbol}", shellDropPsi <= shellAllowedPressureDropPsi);
        yield return BuildCheck("Fouling resistance", $"{FormatNumber(fouling)} hr ft2 F/BTU", $">= {FormatNumber(allowedFouling)} hr ft2 F/BTU", fouling >= allowedFouling);
        yield return BuildCheck("TEMA pitch", $"{FormatNumber(pitch)} {pitchUnit.Symbol}", $">= {FormatNumber(minimumTemaPitch)} {pitchUnit.Symbol}", odInches <= 0d || pitchInches >= 1.25d * odInches);
    }

    private static CheckRow BuildCheck(string name, string actual, string limit, bool passed) =>
        new(name, actual, limit, passed ? "Pass" : "Review", passed ? "status-pass" : "status-review");

    private string GetOverallStatus()
    {
        if (Variables is null)
        {
            return "Review";
        }

        return GetConstraintRows(Variables).All(row => row.Status == "Pass") ? "Pass" : "Review";
    }

    private string GetConstraintClass() => GetOverallStatus() == "Pass"
        ? "constraints pass"
        : "constraints review";

    private readonly record struct CheckRow(string Name, string Actual, string Limit, string Status, string StatusClass);

