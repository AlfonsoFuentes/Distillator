    private static double GetDiameterValue(Variable<Diameter> variable, UnitMeasure unit) =>
        variable.IsDefined ? variable.Value.GetValue(unit) : 0d;

    private static double GetLengthValue(Variable<Length> variable, UnitMeasure unit) =>
        variable.IsDefined ? variable.Value.GetValue(unit) : 0d;

    private static double GetAmountValue<T>(Variable<T> variable, UnitMeasure unit)
        where T : Amount => variable.IsDefined ? variable.Value.GetValue(unit) : 0d;

    private static PressureDrop GetAllowedPressureDrop(Variable<PressureDrop> variable) =>
        new(GetAllowedPressureDropPsi(variable), PressureDropUnits.psi);

    private static double GetAllowedPressureDropPsi(Variable<PressureDrop> variable) =>
        variable.IsDefined && variable.Value.GetValue(PressureDropUnits.psi) > 0d
            ? variable.Value.GetValue(PressureDropUnits.psi)
            : 5d;

    private static double GetUnitLessValue(Variable<UnitLess> variable) =>
        variable.IsDefined ? variable.Value.GetValue(UnitLessUnits.None) : 0d;

    private static string GetGaugeValue(ShellAndTubeDesignVariables variables) =>
        FormatInteger(GetUnitLessValue(variables.TubeGauge));

    private void ApplyTubeInnerDiameterFromGauge()
    {
        if (Variables is null || !Variables.TubeOuterDiameter.IsDefined)
        {
            return;
        }

        if (!TryGetTubeWallThicknessInches(out var wallThicknessInches))
        {
            return;
        }

        var outerDiameterInches = Variables.TubeOuterDiameter.Value.GetValue(DiameterUnits.Inch);
        var innerDiameterInches = outerDiameterInches - 2d * wallThicknessInches;

        if (innerDiameterInches <= 0d)
        {
            errorMessage = "Tube ID cannot be calculated because gauge thickness is greater than tube OD.";
            return;
        }

        Variables.TubeInnerDiameter.SetValue(
            new Diameter(innerDiameterInches, DiameterUnits.Inch),
            VariableDefinedBy.Equipment);
    }

    private bool TryGetTubeWallThicknessInches(out double wallThicknessInches)
    {
        wallThicknessInches = 0d;

        if (!string.Equals(tubeStandard, "Kern", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(tubeStandard, "ASME", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (Variables is null)
        {
            return false;
        }

        var gauge = (int)Math.Round(GetUnitLessValue(Variables.TubeGauge));
        return BwgThicknessInches.TryGetValue(gauge, out wallThicknessInches);
    }

    private static string FormatAmount<T>(Variable<T> variable, UnitMeasure unit)
        where T : Amount => variable.IsDefined ? FormatNumber(variable.Value.GetValue(unit)) : "-";

    private static string FormatAmount<T>(T amount, UnitMeasure unit)
        where T : Amount => FormatNumber(amount.GetValue(unit));

    private static string FormatAmountInUnit<T>(Variable<T> variable, UnitMeasure unit)
        where T : Amount => variable.IsDefined ? FormatNumber(variable.Value.GetValue(unit)) : "-";

    private static string FormatUnitLess(Variable<UnitLess> variable) =>
        variable.IsDefined ? FormatNumber(variable.Value.GetValue(UnitLessUnits.None)) : "-";

    private static string FormatNumber(double value)
    {
        if (!double.IsFinite(value))
        {
            return "-";
        }

        return Math.Abs(value) > 0d && Math.Abs(value) < 0.001d
            ? value.ToString("0.######", CultureInfo.CurrentCulture)
            : value.ToString("0.###", CultureInfo.CurrentCulture);
    }

    private static string FormatInteger(double value) =>
        double.IsFinite(value) ? Math.Round(value).ToString("0", CultureInfo.CurrentCulture) : "-";

    private static string FormatSvg(double value) =>
        value.ToString("0.###", CultureInfo.InvariantCulture);

    private static string FormatDefinedBy<T>(Variable<T> variable)
        where T : Amount => variable.DataProcedence == VariableDefinedBy.UserInput ? "User" : "Calculated";

