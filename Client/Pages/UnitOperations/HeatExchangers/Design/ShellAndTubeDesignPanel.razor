    private ShellAndTubeDesignVariables? Variables => selectedDesign?.Variables as ShellAndTubeDesignVariables;

    protected override void OnInitialized()
    {
        unitPopupContext.Changed += StateHasChanged;
    }

    public void Dispose()
    {
        unitPopupContext.Changed -= StateHasChanged;
    }

    private IReadOnlyList<IProjectUnitSystem> UnitSystemOptions =>
        ProjectSessionService.CurrentProject?.Configuration.UnitSystems?.ToArray()
        ?? [ProjectUnitSystem.SI(), ProjectUnitSystem.English()];

    private string SelectedUnitSystemName =>
        selectedUnitSystemName
        ?? ProjectSessionService.CurrentProject?.Configuration.ActiveUnitSystemName
        ?? UnitSystemOptions.FirstOrDefault()?.Name
        ?? "SI";

    protected override void OnParametersSet()
    {
        if (selectedDesign is null && Equipment.Designs.Count > 0)
        {
            selectedDesign = Equipment.Designs[^1];
            selectedCalculationStandard = Variables?.CalculationStandard.ToString() ?? ShellAndTubeCalculationStandard.Kern.ToString();
            ApplySelectedUnitSystem();
        }
    }

    private void CreateDesign()
    {
        errorMessage = null;

        try
        {
            selectedDesign = Equipment.CreateDesign(GetSelectedCalculationStandard());
            selectedCalculationStandard = Variables?.CalculationStandard.ToString() ?? selectedCalculationStandard;
            ApplySelectedUnitSystem();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void SelectDesign(IEquipmentDesign design)
    {
        selectedDesign = design;
        errorMessage = null;
        selectedCalculationStandard = Variables?.CalculationStandard.ToString() ?? ShellAndTubeCalculationStandard.Kern.ToString();
        ApplySelectedUnitSystem();
    }

    private void RecalculateSelectedDesign()
    {
        if (selectedDesign is null)
        {
            return;
        }

        try
        {
            selectedDesign = Equipment.RecalculateDesign(selectedDesign);
            ApplySelectedUnitSystem();
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ApplySelectedCalculationStandard()
    {
        if (Variables is null)
        {
            return;
        }

        Variables.CalculationStandard = GetSelectedCalculationStandard();

        try
        {
            selectedDesign = Equipment.RecalculateDesign(selectedDesign!);
            selectedCalculationStandard = Variables?.CalculationStandard.ToString() ?? selectedCalculationStandard;
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private ShellAndTubeCalculationStandard GetSelectedCalculationStandard()
    {
        if (Enum.TryParse<ShellAndTubeCalculationStandard>(selectedCalculationStandard, out var standard))
        {
            return standard;
        }

        return string.Equals(selectedCalculationStandard, "Design Practices", StringComparison.OrdinalIgnoreCase)
            ? ShellAndTubeCalculationStandard.DesignPractices
            : ShellAndTubeCalculationStandard.Kern;
    }

    private void OnCalculationStandardChanged(ChangeEventArgs e)
    {
        selectedCalculationStandard = Convert.ToString(e.Value, CultureInfo.InvariantCulture)
            ?? ShellAndTubeCalculationStandard.Kern.ToString();

        if (Variables is null)
        {
            return;
        }

        ApplySelectedCalculationStandard();
        ApplySelectedUnitSystem();
    }

    private void SetDiameter(Variable<Diameter> variable, ChangeEventArgs e, UnitMeasure unit)
    {
        if (TryReadDouble(e, out var value))
        {
            variable.SetValue(new Diameter(value, unit), VariableDefinedBy.UserInput);
            RecalculateSelectedDesign();
        }
    }

    private void SetDiameter(Variable<Diameter> variable, double value)
