@using Client.Pages.UnitOperations.Columns.ColumnProfiles




<EquipmentBaseDialog Equipment="Equipment" CanEdit="CanEdit">
    <MainSlot>
        <div class="column-canvas-layout">

            @* 1. ZONA IZQUIERDA: Entradas (Feeds) *@
            <div class="port-zone left-zone">
                <DynamicPortList Title="Feeds"
                                 ParentEquipment="Equipment"
                                 Ports="@(Equipment.Ports.Where(p => p.Name.StartsWith("Feed")))"
                                 OnPortConnectionChanged="HandleTopologyChanged" />
            </div>

            @* 2. ZONA CENTRAL: Overhead -> SVG -> Bottoms *@
            <div class="center-zone">
                <div class="static-port-container top-port">
                    <div class="port-label">Overhead</div>
                    <EquipmentPortConnector Port="@Equipment.OverheadPort"
                                            ParentEquipment="Equipment"
                                            OnConnChanged="HandleTopologyChanged" />
                </div>

                <div class="equipment-drawing-zone">
                    <ColumnSvg Width="@Equipment.Width" Height="@Equipment.Height" StatusColor="@(Equipment.StatusColor ?? "#CBD5E0")" />
                </div>

                <div class="static-port-container bottom-port">
                    <EquipmentPortConnector Port="@Equipment.BottomsPort"
                                            ParentEquipment="Equipment"
                                            OnConnChanged="HandleTopologyChanged" />
                    <div class="port-label">Bottoms</div>
                </div>
            </div>

            @* 3. ZONA DERECHA: Reflux -> SideDraws -> Reboiler Return *@
            <div class="port-zone right-zone">

                @* 3A. Reflux (Tope) *@
                <div class="static-right-port">
                    <div class="port-label">Reflux</div>
                    <EquipmentPortConnector Port="@Equipment.RefluxPort"
                                            ParentEquipment="Equipment"
                                            OnConnChanged="HandleTopologyChanged" />
                </div>

                @* 3B. Side Draws (Dinámico en el medio) *@
                <div class="side-draws-container">
                    <DynamicPortList Title="Side Draws"
                                     ParentEquipment="Equipment"
                                     Ports="@(Equipment.Ports.Where(p => p.Name.StartsWith("SideDraw")))"
                                     OnPortConnectionChanged="HandleTopologyChanged" />
                </div>

                @* 3C. Reboiler Return (Fondo) *@
                <div class="static-right-port">
                    <div class="port-label">Reboiler Return</div>
                    <EquipmentPortConnector Port="@Equipment.ReboilerReturnPort"
                                            ParentEquipment="Equipment"
                                            OnConnChanged="HandleTopologyChanged" />
                </div>

            </div>
        </div>
    </MainSlot>
    <ProfilesSlot>
        @if (Equipment.Facade is SolverColumn col)
        {
            <ColumnProfile Column="@col" />
        }
    </ProfilesSlot>
    <PropertiesSlot>
        @if (Equipment.Facade is SolverColumn col)
        {
            <div class="properties-container">
                @* SECCIÓN 1: ESPECIFICACIONES DE PRESIÓN *@
                <div class="property-group">
                    <div class="group-header">Pressure Profile</div>

                    <VariableAmountRow Label="Top Pressure"
                                       @bind-Variable="col.TopPressure"
                                       Mode="VariableMode.Standard" />

                    <VariableAmountRow Label="Pressure Drop"
                                       @bind-Variable="col.DeltaP"
                                       Mode="VariableMode.Standard" />

                    <VariableAmountRow Label="Bottom Pressure"
                                       @bind-Variable="col.BottomPressure"
                                       Mode="VariableMode.Standard" />
                </div>

                @* SECCIÓN 2: ANÁLISIS DE DESTILACIÓN (F.U.G.) *@
                <div class="property-group">
                    <div class="group-header">F.U.G. Analysis (Calculated)</div>

                    @*  <VariableUnitLessRow Label="Actual Reflux (R)"
                                         @bind-Variable="col.ActualRefluxRatio"
                                         Mode="VariableMode.Standard"
                                         IsReadOnly="true" />

                    <VariableUnitLessRow Label="Min Reflux (R_min)"
                                         @bind-Variable="col.MinRefluxRatio"
                                         Mode="VariableMode.Standard"
                                         IsReadOnly="true" />

                    <VariablePercentageRow Label="Reflux Excess"
                                           @bind-Variable="col.RefluxExcess"
                                           Mode="VariableMode.Standard"
                                           IsReadOnly="true" />

                    <VariableUnitLessRow Label="Min Stages (N_min)"
                                         @bind-Variable="col.MinStages"
                                         Mode="VariableMode.Standard"
                                         IsReadOnly="true" />

                    <VariableUnitLessRow Label="Theoretical Stages"
                                         @bind-Variable="col.TheoreticalStages"
                                         Mode="VariableMode.Standard"
                                         IsReadOnly="true" /> *@
                </div>
            </div>
        }
    </PropertiesSlot>
</EquipmentBaseDialog>

@code {
    [Parameter] public Shared.ProcessFlowDiagram.Columns.ColumnVisualElement Equipment { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; } = true;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        Equipment.RefreshDynamicPorts();
        // BuildTree();
    }

    private void HandleTopologyChanged()
    {
        Equipment.RefreshDynamicPorts();
        StateHasChanged();
    }

   
}
